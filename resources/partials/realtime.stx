{{--
  The realtime socket URL, built in the browser rather than on the server.

  Two things went wrong when each page built its own. The board hardcoded
  `ws://localhost:6001`, which in production points every visitor's browser
  at their own machine, so the board silently never updated for anyone but
  a developer. The live page used `location.hostname`, which is right, but
  pinned the scheme to `ws://` — and a browser on an HTTPS page refuses an
  insecure socket as mixed content, so it broke on exactly the deployments
  that matter.

  Both are decided here, once, from the page the visitor actually loaded.
  Production uses the TLS-routed realtime subdomain; `BROADCAST_PORT` remains
  the direct local-development port and is read by each including page.
--}}
<script>
  globalThis.predicthqRealtime = {
    /** Use the public TLS socket in production and the configured port locally. */
    url(port) {
      const secure = location.protocol === 'https:'
      if (secure) {
        const apex = location.hostname.replace(/^www\./, '')
        return 'wss://realtime.' + apex + '/ws'
      }

      const host = port ? location.hostname + ':' + port : location.host
      return 'ws://' + host + '/ws'
    },
  }
</script>
