{{--
  Shared head tags every page gets, because every page includes this file.
  Pages may set three optional server values: `ogImage` (a path under
  public/, generated by `buddy generate:og` from config/images.ts),
  `canonicalPath`, and `noindex` for private pages, which also drops them
  from the sitemap.
--}}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#000000">
<meta property="og:type" content="website">
<meta property="og:image" content="https://predicthq.org{{ typeof ogImage === 'string' ? ogImage : '/images/og/og.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="https://predicthq.org{{ typeof ogImage === 'string' ? ogImage : '/images/og/og.png' }}">
@if (typeof canonicalPath === 'string')
<link rel="canonical" href="https://predicthq.org{{ canonicalPath }}">
<meta property="og:url" content="https://predicthq.org{{ canonicalPath }}">
@endif
@if (typeof noindex !== 'undefined' && noindex)
<meta name="robots" content="noindex">
@endif
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Geist:wght@400..900&family=Geist+Mono:wght@400..600&display=swap">

<script>
  /*
    Resolve the theme before the first paint.

    Doing this from Alpine's x-data runs after the first frame, which is a
    visible flash of the wrong theme on every single load. The flash is
    worst going into dark mode, which is exactly when it is least welcome.
    A blocking inline script in the head is the one reliable fix, and it is
    small enough to be worth the block.

    An explicit choice always wins. With none stored we follow the system
    AND keep following it, so a machine that flips at sunset flips the page
    with it rather than pinning the user to whatever it happened to be on
    their first visit.
  */
  (function () {
    var KEY = 'predicthq-theme'
    var LEGACY_KEY = 'ob-theme'
    var root = document.documentElement
    var query = window.matchMedia('(prefers-color-scheme: dark)')

    function stored() {
      try {
        // The legacy key predates the rename. Read it once so an existing
        // visitor keeps the theme they chose instead of being silently
        // reset to their system preference.
        return localStorage.getItem(KEY) || localStorage.getItem(LEGACY_KEY)
      }
      catch (e) {
        // Storage can throw outright in private mode. A theme is not worth
        // taking the page down for.
        return null
      }
    }

    function apply(theme) {
      root.setAttribute('data-theme', theme)
    }

    apply(stored() || (query.matches ? 'dark' : 'light'))

    // Whether this browser holds a session, so the nav can offer "My bets"
    // instead of "Log in" on every page without waiting for hydration.
    // Presentation only: every private endpoint still checks the token.
    try {
      if (localStorage.getItem('token'))
        root.setAttribute('data-auth', 'in')
    }
    catch (e) {}

    query.addEventListener('change', function (event) {
      if (!stored())
        apply(event.matches ? 'dark' : 'light')
    })

    // Pages drive the toggle through this so the storage key and the
    // attribute are written in exactly one place.
    window.predicthqTheme = {
      current: function () {
        return root.getAttribute('data-theme') || 'light'
      },
      toggle: function () {
        var next = this.current() === 'dark' ? 'light' : 'dark'
        try {
          localStorage.setItem(KEY, next)
        }
        catch (e) {}
        apply(next)
        return next
      },
    }
  })()
</script>

<style>
  /*
    PredictHQ design tokens.

    Included from every page's <head>, since it emits the font links as
    well as the variables, so a palette change is one edit here.

    Black and white is the brand. The interface is ink on paper in light
    mode and paper on ink in dark mode, with exactly two colours that are
    allowed to mean something: green for up / yes / winning and red for
    down / no / losing. Nothing decorative is ever green or red, so a
    coloured number always carries information.

    Surfaces are flat. Hairline borders do the separating and elevation is
    reserved for things that float (menus, drawers), the way an exchange
    screen reads: dense, calm, and about the numbers.

    Numbers are Geist Mono everywhere. A probability that shifts its column
    width as it ticks is unreadable, and this product is mostly numbers
    that tick. Headlines and big scoreboard figures use a condensed
    grotesk so a score or a percentage can be large without being wide.
  */

  [x-cloak] { display: none !important; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  :root {
    --bg: #ffffff;
    --bg-2: #f6f6f6;
    --surface: #ffffff;
    --surface-2: #f5f5f5;
    --border: #ebebeb;
    /* 3:1 against white, so inputs and icon buttons keep a visible edge. */
    --border-strong: #8a8a8a;
    --text: #0a0a0a;
    --muted: #5e5e5e;
    /* Small metadata still clears WCAG AA on --surface-2. */
    --faint: #6b6b6b;

    /* The accent is ink. Primary actions are black buttons. */
    --accent: #0a0a0a;
    --accent-strong: #0a0a0a;
    --accent-weak: rgba(10, 10, 10, 0.06);

    --best-bg: rgba(10, 10, 10, 0.06);
    --best-ring: #0a0a0a;
    --best-text: #0a0a0a;

    /* Semantic only. Never used for emphasis. */
    --pos: #00824f;
    --pos-weak: rgba(0, 130, 79, 0.10);
    --neg: #d4202c;
    --neg-weak: rgba(212, 32, 44, 0.09);
    --live: #e5242f;

    --track: #efefef;
    --shadow-sm: none;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(0, 0, 0, 0.08);
    --border-color: var(--border);
    --on-accent: #ffffff;
    --scrim: rgba(0, 0, 0, 0.45);
    --radius: 16px;
  }

  /*
    Keyed off the root rather than the .app wrapper, because the pre-paint
    script can only reach <html> -- the wrapper does not exist yet when the
    head runs, which is the whole point of resolving it there.
  */
  :root[data-theme="dark"] {
    --bg: #000000;
    --bg-2: #0a0a0a;
    --surface: #0b0b0b;
    --surface-2: #161616;
    --border: #232323;
    --border-strong: #6e6e6e;
    --text: #f5f5f5;
    --muted: #a3a3a3;
    --faint: #8f8f8f;

    --accent: #f5f5f5;
    --accent-strong: #ffffff;
    --accent-weak: rgba(255, 255, 255, 0.08);

    --best-bg: rgba(255, 255, 255, 0.08);
    --best-ring: #f5f5f5;
    --best-text: #ffffff;

    --pos: #22c77a;
    --pos-weak: rgba(34, 199, 122, 0.14);
    --neg: #ff5a5f;
    --neg-weak: rgba(255, 90, 95, 0.13);
    --live: #ff4d55;

    --track: #1c1c1c;
    --shadow-sm: none;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.6), 0 16px 40px rgba(0, 0, 0, 0.7);
    --border-color: var(--border);
    --on-accent: #000000;
    --scrim: rgba(0, 0, 0, 0.7);
  }

  body {
    margin: 0;
    font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  .app { min-height: 100vh; background: var(--bg); color: var(--text); transition: background 0.2s ease, color 0.2s ease; }
  a { color: inherit; text-decoration: none; }

  /*
    Display face: a condensed grotesk, confined to headlines and scoreboard
    figures, where a swapped metric costs a line-break and not a reflowed
    table. Falls back to Geist, so a blocked font request costs character
    and not layout.
  */
  .display {
    font-family: 'Barlow Condensed', 'Geist', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: none;
  }
  /* Older pages pair .display with font-black and tracking-tight, which on
     a condensed face reads cramped and heavier than the rest of the site.
     One weight and one tracking for every headline. */
  .display.font-black { font-weight: 800; }
  .display.tracking-tight { letter-spacing: -0.005em; }
  .figure-xl {
    font-family: 'Barlow Condensed', 'Geist', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* Tabular mono so a ticking number never reflows its column. */
  .num {
    font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .soft { background: var(--surface-2); }
  .bd { border-color: var(--border); }
  .muted { color: var(--muted); }
  .faint { color: var(--faint); }
  .accent { color: var(--accent-strong); }
  .pos { color: var(--pos); }
  .neg { color: var(--neg); }
  .live { color: var(--live); }

  .btn { border: 1px solid var(--border); color: var(--text); background: var(--surface); transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease; }
  .btn:hover { border-color: var(--border-strong); background: var(--surface-2); }
  .btn:active { transform: translateY(1px); }
  /* Ink on paper, paper on ink: the label flips with the fill. */
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .btn-primary:hover { background: var(--accent); border-color: var(--accent); opacity: 0.86; }
  .icon-btn { border: 1px solid var(--border); color: var(--text); background: var(--surface); }
  .icon-btn:hover { background: var(--surface-2); }

  .brandmark { background: var(--accent); color: var(--on-accent); }

  /* Pill: the one shape for status, side, and filter chips. */
  .pill { display: inline-flex; align-items: center; gap: 0.35rem; height: 1.5rem; padding: 0 0.6rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.01em; background: var(--surface-2); color: var(--muted); white-space: nowrap; }
  .pill.yes, .pill.pos { background: var(--pos-weak); color: var(--pos); }
  .pill.no, .pill.neg { background: var(--neg-weak); color: var(--neg); }
  .pill.ink { background: var(--accent); color: var(--on-accent); }
  .pill.live { background: var(--neg-weak); color: var(--live); }

  .live-pulse { position: relative; display: inline-block; width: 7px; height: 7px; border-radius: 9999px; background: var(--live); }
  .live-pulse::after { content: ''; position: absolute; inset: -3px; border-radius: 9999px; border: 2px solid var(--live); opacity: 0; animation: live-pulse 1.8s ease-out infinite; }
  @keyframes live-pulse { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }

  /* Signed-in and signed-out variants, switched by the pre-paint script. */
  :root:not([data-auth="in"]) .auth-in { display: none !important; }
  :root[data-auth="in"] .auth-out { display: none !important; }

  /* Keyboard focus stays visible on both themes. */
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn { transition: none; }
    .btn:active { transform: none; }
    .live-pulse::after { animation: none; }
  }
</style>
