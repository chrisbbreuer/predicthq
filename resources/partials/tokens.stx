<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..900&family=Geist+Mono:wght@400..600&display=swap">
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@800,700&display=swap">

<script>
  /*
    Resolve the theme before the first paint.

    Doing this from Alpine's x-data runs after the first frame, which is a
    visible flash of the wrong theme on every single load. The flash is
    worst going into dark mode, which is exactly when it is least welcome.
    A blocking inline script in the head is the one reliable fix, and it is
    small enough to be worth the block.

    An explicit choice always wins. With none stored we follow the system
    AND keep following it, so a machine that flips at sunset flips the page
    with it rather than pinning the user to whatever it happened to be on
    their first visit.
  */
  (function () {
    var KEY = 'predicthq-theme'
    var LEGACY_KEY = 'ob-theme'
    var root = document.documentElement
    var query = window.matchMedia('(prefers-color-scheme: dark)')

    function stored() {
      try {
        // The legacy key predates the rename. Read it once so an existing
        // visitor keeps the theme they chose instead of being silently
        // reset to their system preference.
        return localStorage.getItem(KEY) || localStorage.getItem(LEGACY_KEY)
      }
      catch (e) {
        // Storage can throw outright in private mode. A theme is not worth
        // taking the page down for.
        return null
      }
    }

    function apply(theme) {
      root.setAttribute('data-theme', theme)
    }

    apply(stored() || (query.matches ? 'dark' : 'light'))

    query.addEventListener('change', function (event) {
      if (!stored())
        apply(event.matches ? 'dark' : 'light')
    })

    // Pages drive the toggle through this so the storage key and the
    // attribute are written in exactly one place.
    window.predicthqTheme = {
      current: function () {
        return root.getAttribute('data-theme') || 'light'
      },
      toggle: function () {
        var next = this.current() === 'dark' ? 'light' : 'dark'
        try {
          localStorage.setItem(KEY, next)
        }
        catch (e) {}
        apply(next)
        return next
      },
    }
  })()
</script>

<style>
  /*
    PredictHQ design tokens.

    Included from every page's <head>, since it emits the font links as
    well as the variables. Before this existed each view carried its own
    copy of the palette, so a brand change meant a find-and-replace across
    four files and any page that got missed just looked slightly wrong
    forever.

    Two decisions worth knowing:

    Cobalt is the brand; green and red are semantic. The old palette used
    one green for "this is highlighted" and for "this number is up", so on
    the odds board a best price and a rising price were the same color and
    neither read as either. The brand now sits in a hue nothing else uses.

    Numbers are Geist Mono everywhere. A probability that shifts its column
    width as it ticks is unreadable, and this product is mostly numbers
    that tick.
  */

  [x-cloak] { display: none !important; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  :root {
    /* Cool off-white, not paper. This is an instrument. */
    --bg: #f7f9fc;
    --bg-2: #eef2f8;
    --surface: #ffffff;
    --surface-2: #f4f7fb;
    --border: #e3e9f2;
    /* 3:1 against both light surfaces, so inputs and icon buttons retain a
       visible boundary without relying on color vision or a box shadow. */
    --border-strong: #8290a3;
    --text: #0f141c;
    --muted: #5b6780;
    /* Small metadata still clears WCAG AA on --surface-2 (4.63:1). */
    --faint: #667085;

    --accent: #3e64e0;
    --accent-strong: #2742b0; /* passes AA as text on --surface */
    --accent-weak: rgba(62, 100, 224, 0.10);

    /* A best-price highlight is a brand act, so it uses the brand hue. */
    --best-bg: rgba(62, 100, 224, 0.10);
    --best-ring: #3e64e0;
    --best-text: #2742b0;

    /* Semantic only. Never used for emphasis. */
    --pos: #087a4b;
    --neg: #d92d20;

    --track: #e9eef6;
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
    --shadow: 0 1px 2px rgba(15, 23, 42, 0.05), 0 8px 24px rgba(15, 23, 42, 0.07);
    --border-color: var(--border);
    --on-accent: #ffffff;
    --scrim: rgba(10, 13, 20, 0.45);
  }

  /*
    Keyed off the root rather than the .app wrapper, because the pre-paint
    script above can only reach <html> -- the wrapper does not exist yet
    when the head runs, which is the whole point of resolving it there.
  */
  :root[data-theme="dark"] {
    --bg: #08090b;
    --bg-2: #0e1013;
    --surface: #16181c;
    --surface-2: #1e2126;
    /* Barely there. Elevation does the separating; the line is a backstop
       for the few places two surfaces sit at the same height. */
    --border: #26292f;
    --border-strong: #626975;
    --text: #f2f3f5;
    --muted: #9698a0;
    --faint: #81848d;

    --accent: #5b83f5;
    --accent-strong: #93aef9;
    --accent-weak: rgba(91, 131, 245, 0.15);

    --best-bg: rgba(91, 131, 245, 0.15);
    --best-ring: #5b83f5;
    --best-text: #93aef9;

    --pos: #34d399;
    --neg: #f87171;

    --track: #1b2333;
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.45);
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 16px 36px rgba(0, 0, 0, 0.5);
    --border-color: var(--border);
    --on-accent: #08090b;
    --scrim: rgba(2, 4, 8, 0.66);
  }

  body {
    margin: 0;
    font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  .app { min-height: 100vh; background: var(--bg); color: var(--text); transition: background 0.2s ease, color 0.2s ease; }
  a { color: inherit; text-decoration: none; }

  /*
    Display face. Geist carries the UI and Cabinet Grotesk carries the
    headlines: Geist is a good interface sans and a slightly anonymous
    display one, and headlines are the only place a product this text-heavy
    gets to have a voice. Confined to headlines on purpose, where a swapped
    metric costs a line-break and not a reflowed table.

    Falls back to Geist, so a blocked Fontshare request costs character and
    not layout.
  */
  .display {
    font-family: 'Cabinet Grotesk', 'Geist', ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.022em;
  }

  /* Tabular mono so a ticking number never reflows its column. */
  .num {
    font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
  }
  /* On dark the hairline all but disappears and the raise carries the edge. */
  :root[data-theme="dark"] .card {
    border-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 28px rgba(0, 0, 0, 0.5);
  }
  .soft { background: var(--surface-2); }
  .bd { border-color: var(--border); }
  .muted { color: var(--muted); }
  .faint { color: var(--faint); }
  .accent { color: var(--accent-strong); }
  .pos { color: var(--pos); }
  .neg { color: var(--neg); }

  .btn { border: 1px solid var(--border-strong); color: var(--text); background: var(--surface); transition: transform 0.12s ease, border-color 0.12s ease; }
  .btn:hover { border-color: var(--accent); }
  .btn:active { transform: translateY(1px); }
  /*
    The label colour flips with the theme because the fill does.
    Light: white on #3e64e0 is 5.1:1.
    Dark: the fill has to stay bright or the button sinks into a near-black
    page (a darker blue reads 3.5:1 against the background and stops looking
    raised), so the label goes near-black instead, at 5.7:1.
  */
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .btn-primary:hover { border-color: var(--accent-strong); }
  .icon-btn { border: 1px solid var(--border-strong); color: var(--text); background: var(--surface); }

  .brandmark { background: var(--accent); color: var(--on-accent); }

  /* Keyboard focus stays visible on both themes. */
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn { transition: none; }
    .btn:active { transform: none; }
  }
</style>
