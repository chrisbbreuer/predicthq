<script server>
/**
 * PredictHQ: my bets.
 *
 * Everything the signed-in user has riding right now, laid out to be
 * followed rather than audited: games in progress first, each with its
 * score, clock, and how the market's probability has moved since tip-off;
 * then what starts next; then parlays leg by leg; then everything else.
 *
 * Client-rendered, unlike the odds board next door, and deliberately so:
 * every number here is private to one user. Server-rendering it would
 * put one account's positions into a document the page cache treats like
 * any other, and the failure mode of that mistake is somebody else's
 * portfolio. The page ships empty and fills from
 * `/api/trading/positions`, which authenticates every call.
 *
 * The payload is turned into finished display strings in `apply()` rather
 * than formatted in the markup. Template expressions here are evaluated
 * by the stx runtime rather than by a full JavaScript engine, and a getter
 * or a `.map(...)` in an attribute fails silently. Charts are built as SVG
 * strings for the same reason and bound with `x-html`.
 *
 * @see app/Actions/Trading/GetPositions.ts for the payload.
 * @see app/Services/trading/book-tracking.ts for games, legs, and charts.
 */
const ogImage = '/images/og/positions.png'
// Private to the signed-in user: kept out of search results and the sitemap.
const noindex = true
const navActive = 'positions'
const pageTitle = 'PredictHQ: my bets'
const pageDescription = 'Every open bet across your connected venues, with live scores and how the odds moved through the game.'

/** How often the page re-reads. Matches the venue read floor in the action. */
const POLL_SECONDS = 10
</script>

<script client>
import { useBrowserLocation, useIntervalFn } from '@stacksjs/composables'
import { withCsrfHeader } from '@stacksjs/browser/composables/csrf'
import { useAuth } from '@stacksjs/browser/composables/useAuth'
import { chartSvg, contracts, cents, gameClock, pct, signedUsd, sparkSvg, startLabel, teamColor, teamShort, tone, usd } from '../functions/bets'

const bookAuth = useAuth()
const loading = state(true)
const live = state(false)
// No private section is revealed until `/api/trading/positions` confirms the
// current PredictHQ session. The server-rendered document carries no book data.
const signedIn = state(false)
const error = state('')
const note = state('')
const busy = state(0)
const tab = state('all')
const browserLocation = useBrowserLocation()
const panel = state(['#suggestion-slate', '#checkout-receipts'].includes(browserLocation.hash.value) ? 'suggestions' : browserLocation.hash.value === '#paper-tracking' ? 'paper' : 'positions')
const accounts = state<any[]>([])
const broken = state<any[]>([])
const liveGames = state<any[]>([])
const upcoming = state<any[]>([])
const parlays = state<any[]>([])
const others = state<any[]>([])
const paper = state<any[]>([])
const orders = state<any[]>([])
const pending = state<any[]>([])
const suggestions = state<any[]>([])
const suggestionsLoading = state(true)
const suggestionsError = state(false)
const purchaseReason = state('')
const checkoutBusy = state(0)
const checkout = state<Record<number, { state: string, offer?: { id: string, payout: number, maxCost: number } }>>({})
interface CheckoutReceipt {
  id: number
  labels: string[]
  at: string
  state: string
  payout?: number
  reason?: string
}
const checkoutReceipts = state<CheckoutReceipt[]>([])
const checkoutNotice = state<{ id: number, title: string, message: string, receipt: boolean } | null>(null)
const selectedSlate = state<any>(null)
let refreshingSuggestions = false
const settled = state<any[]>([])
const paperSettled = state<any[]>([])
/** Which parlay cards have their settled legs unfolded, by position key. */
const openSettled = state<Record<string, boolean>>({})

function toggleSettled(key: string): void {
  openSettled.set({ ...openSettled(), [key]: !openSettled()[key] })
}
const counts = state<any>({ all: 0, live: 0, upcoming: 0, parlays: 0, other: 0 })
const empty = state(false)
const totals = state(blankTotals())

function blankTotals(): any {
  return {
    portfolio: '$0.00',
    cash: '$0.00',
    unrealized: '+$0.00',
    unrealizedTone: 'muted',
    realizedToday: '+$0.00',
    realizedTodayTone: 'muted',
    realizedAll: '+$0.00',
    realizedAllTone: 'muted',
    committed: '$0.00',
    paperUnrealized: '+$0.00',
    paperTone: 'muted',
    paperRealizedAll: '+$0.00',
    paperRealizedTone: 'muted',
    unpricedCount: 0,
  }
}

function instant(value: unknown): number {
  const valueString = String(value || '')
  if (!valueString)
    return 0

  const iso = valueString.indexOf('T') === -1 ? valueString.replace(' ', 'T') + 'Z' : valueString
  const parsed = Date.parse(iso)
  return Number.isFinite(parsed) ? parsed : 0
}

function ago(value: unknown): string {
  const at = instant(value)
  if (!at)
    return ''

  const seconds = Math.max(0, Math.round((Date.now() - at) / 1000))
  if (seconds < 60)
    return seconds + 's ago'
  if (seconds < 3600)
    return Math.round(seconds / 60) + 'm ago'
  if (seconds < 86400)
    return Math.round(seconds / 3600) + 'h ago'
  return Math.round(seconds / 86400) + 'd ago'
}

function sideOf(value: unknown): { label: string, cls: string } {
  const side = String(value || '').toLowerCase()
  return { label: side.toUpperCase(), cls: side === 'no' ? 'no' : 'yes' }
}

const LEAGUE_LABELS: Record<string, string> = { nba: 'NBA', wnba: 'WNBA', nfl: 'NFL', ncaaf: 'College football', ncaab: 'College basketball', ncaaw: 'Women’s college basketball', nhl: 'NHL', mlb: 'MLB', mls: 'MLS', epl: 'Premier League' }

function teamView(team: any, side: string, game: any): any {
  const rooting = game.rooting === side
  return {
    abbr: team.abbreviation,
    name: teamShort(team),
    logo: team.logo || '',
    hasLogo: Boolean(team.logo),
    record: team.record || '',
    score: team.score === null || team.score === undefined || game.state === 'pre' ? '' : String(team.score),
    rooting,
    lead: game.state !== 'pre' && Number(team.score) > Number(game[side === 'home' ? 'away' : 'home'].score),
    color: teamColor(team.color),
  }
}

function gameView(game: any): any {
  if (!game)
    return null
  return {
    league: LEAGUE_LABELS[game.league] || String(game.league || '').toUpperCase(),
    isLive: game.state === 'in',
    isFinal: game.state === 'post',
    clock: gameClock(game),
    lastPlay: game.lastPlay || '',
    standing: game.standing,
    standingClass: game.tone === 'live' ? 'live' : game.tone,
    showStanding: game.rooting !== null && game.state !== 'pre',
    away: teamView(game.away, 'away', game),
    home: teamView(game.home, 'home', game),
    title: teamShort(game.away) + ' at ' + teamShort(game.home),
    href: game.gameUrl,
  }
}

/**
 * A leg's live count (points, total, margin) as display fields. Green once
 * it is going the holder's way, red only when the game is over and it did
 * not, and neutral while it is still being played for.
 */
function progressView(progress: any, game: any, status: string): any {
  if (!progress)
    return { has: false, text: '', target: '', width: '0%', tone: '', showBar: false }
  const done = status === 'won' || status === 'lost' || (game && game.state === 'post')
  return {
    has: true,
    text: progress.text,
    target: progress.target === null || progress.target === undefined ? '' : 'of ' + progress.target,
    width: Math.round((Number(progress.ratio) || 0) * 100) + '%',
    showBar: progress.ratio !== null && progress.ratio !== undefined,
    tone: progress.onTrack ? 'pos' : (done ? 'neg' : 'muted'),
  }
}

function legView(leg: any, index: number, fallbackHref: string, settledLeg: boolean): any {
  const game = leg.game
  const upcoming = leg.status !== 'won' && leg.status !== 'lost' && leg.status !== 'live'
  return {
    kind: 'leg',
    key: String(index) + leg.ticker,
    settled: settledLeg,
    label: leg.label,
    choice: String(leg.choice || 'yes').toUpperCase(),
    choiceClass: leg.choice === 'no' ? 'no' : 'yes',
    status: leg.status,
    statusLabel: leg.status === 'won' ? 'Hit' : (leg.status === 'lost' ? 'Missed' : (leg.status === 'live' ? 'Live' : 'Upcoming')),
    statusClass: leg.status === 'won' ? 'pos' : (leg.status === 'lost' ? 'neg' : (leg.status === 'live' ? 'live' : '')),
    chance: upcoming || leg.status === 'live' ? pct(leg.chance) : (leg.status === 'won' ? '✓' : '✕'),
    chanceTone: leg.status === 'won' ? 'pos' : (leg.status === 'lost' ? 'neg' : (leg.chance === null ? 'muted' : (leg.chance >= 0.6 ? 'pos' : (leg.chance <= 0.35 ? 'neg' : '')))),
    hasGame: Boolean(game),
    gameLine: game
      ? game.away.abbreviation + (game.state === 'pre' ? ' at ' : ' ' + game.away.score + '–' + game.home.score + ' ') + game.home.abbreviation
      : '',
    gameClock: game ? gameClock(game) : '',
    isLive: leg.status === 'live',
    // Every leg opens something: its game when it has one, otherwise
    // the parlay itself.
    href: game && game.gameUrl ? game.gameUrl : fallbackHref,
    progress: progressView(leg.progress, game, leg.status),
  }
}

const startOf = (leg: any): number => {
  const at = leg.game ? Date.parse(String(leg.game.startsAt || '')) : Number.NaN
  return Number.isFinite(at) ? at : Number.MAX_SAFE_INTEGER
}

/**
 * A parlay as the card draws it: what is live first, then what plays next
 * in start order, and the settled legs folded behind one line. On a
 * twenty-leg ticket the hits are the least interesting rows, and listing
 * them in the venue's order buried the one game being played.
 */
function parlayView(parlay: any, fallbackHref = ''): any {
  if (!parlay)
    return null
  const all = (parlay.legs || []).map((leg: any, index: number) => ({ leg, index }))
  const live = all.filter((item: any) => item.leg.status === 'live')
  const upcoming = all.filter((item: any) => item.leg.status !== 'live' && item.leg.status !== 'won' && item.leg.status !== 'lost')
    .sort((a: any, b: any) => startOf(a.leg) - startOf(b.leg))
  const missed = all.filter((item: any) => item.leg.status === 'lost')
  const hit = all.filter((item: any) => item.leg.status === 'won')

  const settledCount = missed.length + hit.length
  const settledText = [hit.length ? hit.length + ' hit' : '', missed.length ? missed.length + ' missed' : ''].filter(Boolean).join(' · ')
  const legs = [
    ...live.map((item: any) => legView(item.leg, item.index, fallbackHref, false)),
    ...upcoming.map((item: any) => legView(item.leg, item.index, fallbackHref, false)),
    ...(settledCount > 0 ? [{ kind: 'toggle', key: 'toggle', settled: false, text: settledText }] : []),
    ...missed.map((item: any) => legView(item.leg, item.index, fallbackHref, true)),
    ...hit.map((item: any) => legView(item.leg, item.index, fallbackHref, true)),
  ]

  const summary: string[] = []
  if (parlay.won)
    summary.push(parlay.won + ' hit')
  if (parlay.live)
    summary.push(parlay.live + ' live')
  if (parlay.open)
    summary.push(parlay.open + ' to play')
  if (parlay.lost)
    summary.push(parlay.lost + ' missed')

  const next = upcoming.find((item: any) => item.leg.game && item.leg.game.state === 'pre')
  return {
    total: parlay.total,
    summary: summary.join(' · '),
    liveNow: live.length > 0,
    next: live.length > 0
      ? live.length + (live.length === 1 ? ' leg' : ' legs') + ' in play now'
      : (next ? 'Next leg ' + startLabel(next.leg.game.startsAt) : (upcoming.length === 0 && missed.length === 0 ? 'Every leg is in' : '')),
    chance: pct(parlay.chance),
    progress: Math.round(((parlay.won || 0) / Math.max(1, parlay.total)) * 100) + '%',
    busted: parlay.lost > 0,
    missedLabel: missed.length > 0 ? 'Missed on ' + missed.map((item: any) => item.leg.label).join(', ') : '',
    settledCount,
    legs,
  }
}

/**
 * The older college-football scorecard, for a parlay whose legs Kalshi did
 * not describe, in the same shape as a tracked one so one card draws both.
 */
function scorecardParlay(card: any): any {
  if (!card || !Array.isArray(card.legs) || card.legs.length === 0)
    return null
  const legs = card.legs.map((leg: any) => ({
    status: leg.standing === 'Won' ? 'won' : (leg.standing === 'Lost' ? 'lost' : (leg.state === 'in' ? 'live' : 'open')),
    chance: null,
    choice: leg.choice,
    label: leg.team,
    ticker: leg.team,
    game: leg.found
      ? {
          state: leg.state,
          status: leg.status,
          clock: leg.clock,
          gameUrl: leg.gameUrl,
          away: { abbreviation: leg.team, score: leg.selectedScore },
          home: { abbreviation: leg.opponent, score: leg.opponentScore },
        }
      : null,
  }))
  return parlayView({
    total: legs.length,
    won: legs.filter((leg: any) => leg.status === 'won').length,
    lost: legs.filter((leg: any) => leg.status === 'lost').length,
    live: legs.filter((leg: any) => leg.status === 'live').length,
    open: legs.filter((leg: any) => leg.status === 'open').length,
    chance: null,
    legs,
  })
}

function holding(row: any, isPaper: boolean): any {
  const marked = row.mark !== null && row.mark !== undefined && Number.isFinite(Number(row.mark))
  const side = sideOf(row.side)
  const track = row.track || null
  const game = track && track.game ? track.game : null
  const betHref = row.venue === 'kalshi' ? '/bet?ticker=' + encodeURIComponent(row.marketExternalId) + '&side=' + String(row.side || 'yes').toLowerCase() : ''
  const parlay = track && track.parlay ? parlayView(track.parlay, betHref) : scorecardParlay(row.scorecard)
  const spark = track && Array.isArray(track.spark) ? track.spark : []
  const chance = track && track.chance !== null && track.chance !== undefined ? Number(track.chance) : (marked ? Number(row.mark) : null)
  const rootingTeam = game && game.rooting ? game[game.rooting] : null
  const lineColor = rootingTeam ? teamColor(rootingTeam.color, 'var(--text)') : 'var(--text)'
  const group = parlay
    ? 'parlays'
    : (game && game.state === 'in' ? 'live' : (game && game.state === 'pre' ? 'upcoming' : 'other'))

  return {
    key: row.venue + row.marketExternalId + row.side + (isPaper ? 'p' : ''),
    href: row.venue === 'kalshi' ? '/bet?ticker=' + encodeURIComponent(row.marketExternalId) + '&side=' + String(row.side || 'yes').toLowerCase() : '',
    linkable: row.venue === 'kalshi',
    question: parlay ? parlay.total + '-leg parlay' : (row.question || row.marketExternalId),
    outcome: parlay ? '' : (row.outcomeLabel || ''),
    ticker: row.marketExternalId,
    venue: row.venue,
    side: side.label,
    sideClass: side.cls,
    pick: (side.label === 'NO' ? 'No · ' : '') + (row.outcomeLabel || row.question || ''),
    strategies: (row.strategies || []).map((strategy: any) => strategy.name).join(', '),
    hand: row.source === 'venue',
    size: contracts(row.size),
    paid: cents(row.avgPrice),
    cost: usd(row.cost),
    mark: marked ? cents(row.mark) : 'Unpriced',
    value: marked ? usd(row.markValue) : '—',
    pnl: marked ? signedUsd(row.unrealized) : '—',
    pnlTone: marked ? tone(row.unrealized) : 'muted',
    toWin: usd(Number(row.size) || 0),
    // A parlay's last trade is the holder's own purchase, so its "mark" is
    // just the cost. The legs' live prices say more; shown as an estimate
    // and kept out of the totals, since correlated legs make the product
    // a rough figure rather than a price.
    estValue: track && track.parlay && track.parlay.chance !== null ? usd((Number(row.size) || 0) * Number(track.parlay.chance)) : '—',
    estRaw: track && track.parlay && track.parlay.chance !== null ? (Number(row.size) || 0) * Number(track.parlay.chance) : null,
    costRaw: Number(row.cost) || 0,
    chance: pct(chance),
    chanceTone: chance === null ? 'muted' : (chance >= 0.5 ? 'pos' : 'neg'),
    hasSpark: spark.length > 1,
    spark: sparkSvg(spark),
    chart: spark.length > 1 ? chartSvg([{ points: spark, color: lineColor, fill: true }], spark[0][0], spark[spark.length - 1][0], 640, 150) : '',
    chartColor: lineColor,
    game: gameView(game),
    hasGame: Boolean(game),
    gameHref: game ? game.gameUrl : '',
    progress: progressView(track ? track.progress : null, game, ''),
    starts: game && game.state === 'pre' ? startLabel(game.startsAt) : '',
    parlay,
    legs: parlay ? parlay.legs : [],
    group,
  }
}

function clearPrivateBook(): void {
  accounts.set([])
  broken.set([])
  liveGames.set([])
  upcoming.set([])
  parlays.set([])
  others.set([])
  paper.set([])
  orders.set([])
  pending.set([])
  settled.set([])
  paperSettled.set([])
  suggestions.set([])
  suggestionsLoading.set(true)
  suggestionsError.set(false)
  purchaseReason.set('')
  selectedSlate.set(null)
  checkout.set({})
  checkoutReceipts.set([])
  checkoutNotice.set(null)
  counts.set({ all: 0, live: 0, upcoming: 0, parlays: 0, other: 0 })
  totals.set(blankTotals())
  empty.set(false)
}

function apply(data: any): void {
  const rows = data.positions || []
  const rawTotals = data.totals || {}
  const groups: Record<string, any[]> = { live: [], upcoming: [], parlays: [], other: [] }
  const paperPositions: any[] = []

  for (const row of rows) {
    if (row.source === 'paper') {
      paperPositions.push(holding(row, true))
      continue
    }
    const view = holding(row, false)
    groups[view.group].push(view)
  }

  const nextAccounts = (data.accounts || []).map((account: any) => ({
    venue: account.venue,
    venueLabel: account.venue === 'kalshi' ? 'Kalshi' : (account.venue === 'polymarket-us' ? 'Polymarket US' : (account.venue === 'polymarket' ? 'Polymarket' : account.venue)),
    balance: usd(account.balance),
    identifier: account.maskedIdentifier,
    status: account.status,
    healthy: account.status === 'active' && !account.lastError,
    error: account.lastError,
    syncedAt: account.lastSyncedAt,
    fault: account.status === 'active' ? 'not syncing' : account.status,
  }))
  accounts.set(nextAccounts)
  broken.set(nextAccounts.filter((account: any) => account.status !== 'active' || account.error))
  liveGames.set(groups.live)
  upcoming.set(groups.upcoming)
  parlays.set(groups.parlays)
  others.set(groups.other)
  paper.set(paperPositions)
  counts.set({
    all: groups.live.length + groups.upcoming.length + groups.parlays.length + groups.other.length,
    live: groups.live.length,
    upcoming: groups.upcoming.length,
    parlays: groups.parlays.length,
    other: groups.other.length,
  })

  orders.set((data.orders || []).map((order: any, index: number) => ({
    key: 'o' + index,
    question: order.question,
    venue: order.venue,
    side: String(order.side || '').toUpperCase(),
    sideClass: String(order.side || '').toLowerCase() === 'no' ? 'no' : 'yes',
    outcome: order.outcomeLabel || '',
    status: order.status,
    strategy: order.strategy || '',
    hand: order.source === 'venue',
    placedAt: order.placedAt,
    limit: cents(order.limitPrice),
    left: contracts(order.remaining) + ' / ' + contracts(order.size),
    committed: usd(order.committed),
  })))

  pending.set((data.pending || []).map((decision: any) => ({
    id: decision.id,
    question: decision.question || decision.venue,
    side: String(decision.side || '').toUpperCase(),
    sideClass: String(decision.side || '').toLowerCase() === 'no' ? 'no' : 'yes',
    outcome: decision.outcomeLabel || '',
    strategy: decision.strategy,
    evidence: 'edge ' + Math.round((Number(decision.edge) || 0) * 100) + ' pts · confidence ' + Math.round((Number(decision.confidence) || 0) * 100) + '%',
    rationale: decision.rationale || '',
    stake: usd(decision.notional),
    limit: cents(decision.limitPrice),
  })))

  const settledRow = (prefix: string) => (position: any, index: number) => {
    const realized = Number(position.realized) || 0
    return {
      key: prefix + index,
      question: position.question,
      outcome: position.outcomeLabel || position.side,
      result: position.resultLabel || (position.won ? 'Won' : 'Lost'),
      resultClass: position.resultLabel ? 'muted' : (position.won ? 'pos' : 'neg'),
      strategy: position.strategy + (position.mode === 'paper' ? ' · paper' : ''),
      settledAt: position.settledAt,
      size: contracts(position.size),
      cost: usd(position.cost),
      realized: signedUsd(realized),
      realizedTone: tone(realized),
    }
  }
  settled.set((data.settled || []).map(settledRow('s')))
  paperSettled.set((data.paperSettled || []).map(settledRow('p')))

  const cash = Number(rawTotals.cash) || 0
  const held = rawTotals.markValue === null || rawTotals.markValue === undefined ? Number(rawTotals.cost) || 0 : Number(rawTotals.markValue) || 0
  totals.set({
    portfolio: usd(cash + held),
    cash: usd(cash),
    unrealized: rawTotals.unrealized === null ? '—' : signedUsd(rawTotals.unrealized),
    unrealizedTone: tone(rawTotals.unrealized),
    realizedToday: signedUsd(rawTotals.realizedToday),
    realizedTodayTone: tone(rawTotals.realizedToday),
    realizedAll: signedUsd(rawTotals.realizedAll),
    realizedAllTone: tone(rawTotals.realizedAll),
    committed: usd(rawTotals.committed),
    paperUnrealized: rawTotals.paperUnrealized === null ? '—' : signedUsd(rawTotals.paperUnrealized),
    paperTone: tone(rawTotals.paperUnrealized),
    paperRealizedAll: signedUsd(rawTotals.paperRealizedAll),
    paperRealizedTone: tone(rawTotals.paperRealizedAll),
    unpricedCount: Number(rawTotals.unpricedCount) || 0,
  })

  empty.set(counts().all === 0 && orders().length === 0 && pending().length === 0)
}

function show(section: string): boolean {
  return tab() === 'all' || tab() === section
}

function messageOf(value: unknown): string {
  return value instanceof Error ? value.message : String(value)
}

let refreshing: Promise<boolean> | null = null

async function refreshBookSession(): Promise<boolean> {
  if (refreshing)
    return refreshing

  const refreshToken = bookAuth.getRefreshToken()
  if (!refreshToken)
    return false

  refreshing = (async () => {
    try {
      const response = await fetch('/api/auth/refresh', {
        method: 'POST',
        credentials: 'same-origin',
        headers: withCsrfHeader({
          'Content-Type': 'application/json',
          Accept: 'application/json',
        }),
        body: JSON.stringify({ refresh_token: refreshToken }),
      })
      if (!response.ok)
        return false

      const data = await response.json()
      const accessToken = data.access_token || data.token
      if (!accessToken)
        return false

      bookAuth.token.value = accessToken
      if (data.refresh_token)
        bookAuth.refreshToken.value = data.refresh_token
      return true
    }
    catch {
      return false
    }
    finally {
      refreshing = null
    }
  })()

  return refreshing
}

/**
 * The app's private API is mounted below `/api`, including token refresh.
 * Keep the framework-managed token refs and retry semantics, while targeting
 * the route that is actually reachable through the production proxy.
 */
async function bookFetch(input: string, init: RequestInit = {}): Promise<Response> {
  const send = (): Promise<Response> => {
    const accessToken = bookAuth.getToken()
    return fetch(input, {
      ...init,
      headers: withCsrfHeader({
        ...init.headers,
        ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {}),
        Accept: 'application/json',
      }),
    })
  }

  const response = await send()
  if (response.status !== 401 || !bookAuth.getRefreshToken())
    return response

  if (!await refreshBookSession())
    return response

  return send()
}

async function load(fromVenue = false): Promise<void> {
  try {
    const response = await bookFetch('/api/trading/positions' + (fromVenue ? '?refresh=1' : ''), {
      credentials: 'same-origin',
    })

    if (response.status === 401) {
      signedIn.set(false)
      live.set(false)
      clearPrivateBook()
      return
    }

    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'))

    signedIn.set(true)
    apply(data)
    error.set('')
    live.set(true)
    void loadSuggestions()
  }
  catch (requestError) {
    error.set(messageOf(requestError))
    live.set(false)
  }
  finally {
    loading.set(false)
  }
}

function suggestionView(row: any, quote: any, matchups: Record<string, any>): any {
  const legs = (row.legs || []).map((leg: any, index: number) => {
    const confidence = Number(leg.confidence ?? (leg.side === 'yes' ? leg.yesMid : 1 - leg.yesMid))
    const current = quote?.legs[index]
    const matchup = matchups[leg.ticker]
    const team = (value: any) => ({ logo: value.logo || '', initials: String(value.abbreviation || '').slice(0, 4) })
    return {
      label: String(leg.label).replace(/ \(NO on .+\)$/, ''),
      confidence: current ? pct(current.confidence) : Number.isFinite(confidence) ? pct(confidence) : '',
      confidenceLabel: current ? 'Market chance' : 'At selection',
      book: current ? cents(current.bid) + ' bid · ' + cents(current.ask) + ' ask' : '',
      starts: leg.live ? 'Live' : startLabel(leg.startsAt),
      side: leg.side === 'no' ? 'NO' : 'YES',
      matchup: matchup ? matchup.away.name + ' at ' + matchup.home.name : '',
      league: matchup ? (LEAGUE_LABELS[matchup.league] || String(matchup.league).toUpperCase()) : '',
      teams: matchup ? [team(matchup.away), team(matchup.home)] : [],
      href: '/bet?ticker=' + encodeURIComponent(leg.ticker) + '&side=' + String(leg.side || 'yes').toLowerCase(),
    }
  })
  return {
    id: row.id,
    kind: legs.length + '-leg combo',
    legs,
    stake: usd(row.stake),
    payout: quote?.paperPayout != null ? usd(quote.paperPayout) : '',
  }
}

function receiptTitle(receipt: CheckoutReceipt): string {
  if (receipt.state === 'executed')
    return 'Filled on Kalshi'
  if (receipt.state === 'partial' || receipt.state === 'partial_pending')
    return 'Partially filled on Kalshi'
  if (receipt.state === 'not_filled')
    return 'Order did not fill'
  if (receipt.state === 'unverified')
    return 'Fill still unverified'
  return 'Waiting for Kalshi'
}

function receiptMessage(receipt: CheckoutReceipt): string {
  if (receipt.payout != null)
    return usd(receipt.payout) + ' total payout if every leg wins.'
  if (receipt.reason)
    return receipt.reason
  if (receipt.state === 'unverified')
    return 'Kalshi hasn’t returned a final status. This receipt will update when it does.'
  return 'This receipt will update when Kalshi confirms the result.'
}

function receiptTime(at: string): string {
  const stamp = instant(at)
  return stamp ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(stamp) : ''
}

function showCheckoutReceipt(receipt: CheckoutReceipt): void {
  const title = receiptTitle(receipt)
  const message = receiptMessage(receipt)
  const notice = checkoutNotice()
  if (notice?.id !== receipt.id || notice.title !== title || notice.message !== message)
    checkoutNotice.set({ id: receipt.id, title, message, receipt: true })
}

function viewCheckoutReceipts(): void {
  panel.set('suggestions')
  checkoutNotice.set(null)
}

function finalReceipt(receipt: CheckoutReceipt): boolean {
  return ['executed', 'partial', 'not_filled'].includes(receipt.state)
}

async function loadSuggestions(): Promise<void> {
  if (refreshingSuggestions)
    return
  refreshingSuggestions = true
  try {
    const response = await bookFetch('/api/trading/suggestions', { credentials: 'same-origin' })
    if (!response.ok)
      throw new Error('Could not refresh suggestions')
    const data = await response.json()
    const receipts = new Map(checkoutReceipts().map(receipt => [receipt.id, receipt]))
    for (const receipt of (data.receipts || []) as CheckoutReceipt[]) {
      const old = receipts.get(receipt.id)
      if (!old || !finalReceipt(old) || finalReceipt(receipt))
        receipts.set(receipt.id, receipt)
    }
    checkoutReceipts.set([...receipts.values()].sort((a, b) => instant(b.at) - instant(a.at)).slice(0, 8))
    const notice = checkoutNotice()
    const latest = notice?.receipt && receipts.get(notice.id)
    if (latest)
      showCheckoutReceipt(latest)
    const cards = (data.live || []).filter((ticket: any) => Date.parse(ticket.expiresAt) > Date.now()
      && !checkoutReceipts().some(receipt => receipt.id === ticket.id))
    suggestions.set(cards.map((ticket: any) => suggestionView(ticket, data.prices?.[ticket.id], data.matchups || {})))
    const slate = data.slate
    const summary = slate ? ['won', 'lost', 'pending', 'partial'].map(status => slate.tickets.filter((ticket: any) => ticket.paperResult === status).length) : []
    const day = instant(slate?.createdAt)
    selectedSlate.set(slate ? {
      title: day ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(day) + ' picks' : 'Saved picks',
      summary: summary[0] + ' won · ' + summary[1] + ' lost · ' + summary[2] + ' awaiting results' + (summary[3] ? ' · ' + summary[3] + ' partial' : ''),
    } : null)
    purchaseReason.set(data.purchaseReason || '')
    suggestionsError.set(false)
  }
  catch {
    suggestions.set([])
    suggestionsError.set(true)
  }
  finally {
    refreshingSuggestions = false
    suggestionsLoading.set(false)
  }
}

async function liveCheckout(id: number, quoteId?: string): Promise<void> {
  if (checkoutBusy())
    return
  checkoutBusy.set(id)
  checkoutNotice.set(quoteId ? { id, title: 'Submitting your $1 purchase', message: 'Waiting for Kalshi to respond.', receipt: false } : null)
  const ticket = suggestions().find(row => row.id === id)
  try {
    const response = await bookFetch('/api/trading/suggestions/' + id + '/checkout', {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(quoteId ? { operation: 'buy', quoteId } : { operation: 'quote' }),
    })
    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || 'Kalshi could not update this checkout.')
    checkout.set({ ...checkout(), [id]: data })
    if (['submitted', 'executed', 'partial', 'partial_pending', 'not_filled', 'unverified'].includes(data.state)) {
      const receipt = { ...data, id, labels: (ticket?.legs || []).map((leg: any) => leg.label), at: new Date().toISOString() } as CheckoutReceipt
      checkoutReceipts.set([receipt, ...checkoutReceipts().filter(row => row.id !== id)].slice(0, 8))
      showCheckoutReceipt(receipt)
      suggestions.set(suggestions().filter(ticket => ticket.id !== id))
      void load(true)
    }
  }
  catch (exception) {
    checkoutNotice.set({ id, title: quoteId ? 'Couldn’t confirm the purchase' : 'Couldn’t get a live quote', message: messageOf(exception), receipt: false })
    checkout.set({ ...checkout(), [id]: { state: 'waiting' } })
    void loadSuggestions()
  }
  finally {
    checkoutBusy.set(0)
  }
}

async function review(id: number, approve: boolean): Promise<void> {
  busy.set(id)
  note.set('')
  try {
    const response = await bookFetch('/api/trading/decisions/' + id + '/review', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ approve }),
    })
    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'))

    note.set(approve
      ? (data.status === 'executed' ? 'Order placed.' : 'Approved, but no order was placed: ' + (data.reason || 'see the decision feed.'))
      : 'Decision skipped.')
    await load(true)
  }
  catch (requestError) {
    note.set(messageOf(requestError))
  }
  finally {
    busy.set(0)
  }
}

const polling = useIntervalFn(() => void load(true), {{ POLL_SECONDS }} * 1000, { immediate: false })

async function start(): Promise<void> {
  await bookAuth.completeSocialLogin()
  await load(true)
  polling.resume()
}

onMount(start)
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
    <style>
      .desk-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0 0 1.25rem; }
      .desk-heading h1 { font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.03; letter-spacing: -0.055em; }
      .desk-nav { display: flex; gap: clamp(.4rem, 2vw, 1.5rem); border-bottom: 1px solid var(--border); }
      .desk-nav button { display: inline-flex; flex: 0 1 auto; align-items: center; justify-content: center; gap: .45rem; min-height: 3rem; padding: .55rem .45rem; border-bottom: 2px solid transparent; color: var(--muted); text-align: center; font-size: .875rem; font-weight: 650; }
      .desk-nav button:hover, .desk-nav button[aria-pressed="true"] { color: var(--text); }
      .desk-nav button[aria-pressed="true"] { border-color: var(--accent); }
      .desk-panel { margin-top: 1.5rem; scroll-margin-top: 5rem; }
      .desk-panel-heading { margin-bottom: 1.15rem; max-width: 42rem; }
      .desk-panel-heading h2 { font-size: 1.6rem; letter-spacing: -.035em; }
      .saved-picks, .purchase-status { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1rem; padding: .95rem 1.05rem; border: 1px solid var(--border); border-radius: .85rem; background: var(--surface); }
      .saved-picks { margin-top: .85rem; border-inline-start: 3px solid var(--accent); }
      .purchase-status { flex-wrap: nowrap; justify-content: flex-start; color: var(--muted); font-size: .8rem; }
      .purchase-status i { flex-shrink: 0; }
      .checkout-receipts { margin: 0 0 1.15rem; padding: .95rem 1.05rem; border: 1px solid var(--border); border-radius: .85rem; background: var(--surface); scroll-margin-top: 5rem; }
      .checkout-receipt { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .35rem 1rem; padding: .75rem 0; border-bottom: 1px solid var(--border); }
      .checkout-receipt:last-child { padding-bottom: 0; border-bottom: 0; }
      .checkout-notice { position: fixed; z-index: 60; inset-inline-end: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); width: min(24rem, calc(100% - 2rem)); padding: .95rem 1.05rem; border: 1px solid var(--border); border-inline-start: 3px solid var(--accent); border-radius: .85rem; background: var(--surface); box-shadow: 0 12px 40px #0005; }
      .position-overview { display: grid; grid-template-columns: minmax(11rem, 1.4fr) repeat(3, minmax(0, 1fr)); padding: 1.05rem 1.25rem; gap: .85rem 1.05rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
      .balance-hero, .balance-metric { display: grid; align-content: center; gap: .2rem; }
      .balance-metric { padding-inline-start: 1rem; border-inline-start: 1px solid var(--border); }
      .balance-metric span, .balance-label { display: flex; align-items: center; gap: .5rem; color: var(--muted); font-size: .8rem; }
      .balance-hero strong { font-size: clamp(1.55rem, 4vw, 2.3rem); letter-spacing: -.05em; line-height: 1.1; }
      .balance-metric strong { font-size: 1.05rem; }
      .pick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; align-items: stretch; }
      .pick-card { display: flex; flex-direction: column; min-width: 0; padding: .95rem; gap: .75rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
      .pick-card-head, .pick-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .45rem .8rem; }
      .pick-card-head { color: var(--muted); font-size: .78rem; }
      .pick-card-head h4 { color: var(--text); font-weight: 700; }
      .pick-legs { display: grid; gap: .35rem; }
      .pick-leg { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .65rem; padding: .65rem; border-radius: .7rem; background: var(--surface-2); color: var(--text); }
      .pick-leg:hover { background: var(--soft); }
      .match-marks { display: flex; align-items: center; justify-content: center; min-width: 3rem; color: var(--muted); }
      .match-mark { display: grid; place-items: center; width: 2.05rem; height: 2.05rem; padding: .12rem; border: 1px solid var(--border); border-radius: .65rem; background: var(--surface); font-size: .55rem; font-weight: 800; }
      .match-mark + .match-mark { margin-inline-start: -.45rem; }
      .match-mark img { width: 100%; height: 100%; object-fit: contain; }
      .pick-name, .pick-matchup, .pick-meta { display: block; }
      .pick-name { font-size: .94rem; font-weight: 730; line-height: 1.25; text-wrap: pretty; }
      .pick-matchup, .pick-meta, .pick-chance small { color: var(--muted); font-size: .71rem; line-height: 1.35; }
      .pick-matchup { margin-top: .2rem; }
      .pick-meta { margin-top: .15rem; }
      .pick-chance { text-align: right; }
      .pick-chance .num { display: block; font-size: 1.05rem; font-weight: 750; line-height: 1.1; }
      .pick-chance small { white-space: nowrap; }
      .pick-details { color: var(--muted); font-size: .78rem; }
      .pick-details summary { cursor: pointer; font-weight: 650; }
      .pick-details p { margin-top: .45rem; }
      .pick-actions { margin-top: auto; padding-top: .7rem; border-top: 1px solid var(--border); }
      .pick-stake { display: grid; gap: .08rem; font-size: .72rem; color: var(--muted); }
      .pick-stake .num { font-size: .88rem; font-weight: 750; color: var(--text); }
      .pick-primary, .desk-text-action { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; min-height: 2.15rem; font-size: .78rem; font-weight: 700; }
      .pick-primary { padding: .35rem .7rem; border-radius: .55rem; background: var(--accent); color: var(--on-accent); }
      .live-checkout-button { width: 100%; min-height: 2.75rem; margin-top: .6rem; font-size: .9rem; }
      .pick-primary:hover { opacity: .9; }
      .desk-text-action { color: var(--text); }
      .desk-text-action:hover { text-decoration: underline; text-underline-offset: .14rem; }
      .desk-text-action:disabled, .pick-primary:disabled { opacity: .55; }
      :is(.desk-nav button, .desk-text-action, .pick-primary, .pick-leg, .pick-details summary):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      @media (max-width: 48rem) {
        .pick-grid { grid-template-columns: minmax(0, 1fr); }
        .position-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .balance-metric:nth-child(3) { padding-inline-start: 0; border-inline-start: 0; }
      }
      @media (max-width: 27rem) {
        .desk-nav button { gap: .25rem; padding-inline: .25rem; font-size: .78rem; }
        .desk-nav button i { display: none; }
        .pick-card { padding: .7rem; }
        .pick-leg { gap: .45rem; padding: .55rem; }
        .match-marks { min-width: 2.55rem; }
        .match-mark { width: 1.7rem; height: 1.7rem; }
      }
      .status-dot { width: 8px; height: 8px; border-radius: 9999px; background: var(--faint); }
      .status-dot.on { background: var(--pos); }

      .chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
      .chips::-webkit-scrollbar { display: none; }
      .chip { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px; border-radius: 9999px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 13px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease; }
      .chip:hover { color: var(--text); border-color: var(--border-strong); }
      .chip.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
      .chip-count { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; opacity: 0.7; }

      .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 36px 0 12px; }
      .section-title { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; display: flex; align-items: center; gap: 10px; }

      /* Game card: scoreboard, chart, and the position, top to bottom. */
      .game-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
      .game-card { display: block; padding: 18px; transition: border-color 0.15s ease; }
      .game-card:hover { border-color: var(--border-strong); }
      .team-row { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 6px 0; }
      .team-logo { width: 32px; height: 32px; object-fit: contain; }
      .team-logo-fallback { width: 32px; height: 32px; border-radius: 9999px; background: var(--surface-2); display: grid; place-items: center; font-size: 10px; font-weight: 800; color: var(--muted); }
      .team-score { font-size: 34px; min-width: 2ch; text-align: right; }
      .team-score.trail { color: var(--faint); }
      .you { display: inline-grid; place-items: center; height: 18px; padding: 0 6px; border-radius: 6px; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; background: var(--accent); color: var(--on-accent); }
      .last-play { font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mini-chart { position: relative; height: 96px; margin-top: 12px; }
      .stat-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
      .stat-label { display: block; font-size: 11px; font-weight: 600; color: var(--faint); }
      .stat-value { display: block; margin-top: 2px; font-weight: 700; font-size: 15px; }

      /* Compact rows: everything that is not a game. */
      .row { display: grid; gap: 16px; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--border); grid-template-columns: minmax(0, 1fr) 132px 86px 96px 96px; }
      .row:last-child { border-bottom: 0; }
      a.row:hover { background: var(--surface-2); }
      .row-meta { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin-top: 6px; }
      .spark { height: 40px; }
      .cell { text-align: right; }
      .cell-label { display: block; font-size: 11px; font-weight: 600; color: var(--faint); }
      .simple-row { display: grid; gap: 16px; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--border); grid-template-columns: minmax(0, 1fr) auto; }
      .paper-legs { display: grid; gap: 6px; padding: 0 18px 14px; margin-top: -6px; border-bottom: 1px solid var(--border); }
      .paper-leg { display: flex; gap: 8px; align-items: center; min-width: 0; }
      .simple-row:last-child { border-bottom: 0; }
      .figures { display: flex; gap: 22px; align-items: baseline; justify-content: flex-end; flex-wrap: wrap; }
      .figure { text-align: right; min-width: 58px; }

      /* Parlay: one line per leg, each with its own chance. */
      .leg { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto 52px; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--border); }
      .leg-status { justify-self: start; white-space: nowrap; }
      a.leg { border-radius: 10px; margin: 0 -8px; padding-left: 8px; padding-right: 8px; transition: background 0.12s ease; }
      a.leg:hover { background: var(--surface-2); }
      .leg-bar { height: 3px; }
      /* Long leg names wrap to two lines rather than losing their ending. */
      .leg-label { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; }
      .leg-settled { opacity: 0.72; }
      .leg-settled:hover { opacity: 1; }
      .leg-toggle { display: flex; gap: 8px; align-items: center; width: calc(100% + 16px); margin: 0 -8px; padding: 10px 8px; border-top: 1px solid var(--border); border-radius: 10px; text-align: left; cursor: pointer; transition: background 0.12s ease; }
      .leg-toggle:hover { background: var(--surface-2); }
      .leg-toggle > span:first-of-type { flex: 1; }
      .parlay-busted { display: flex; gap: 8px; align-items: center; margin-top: 12px; padding: 8px 12px; border-radius: 10px; font-size: 13px; font-weight: 600; color: var(--neg); background: var(--neg-weak); }
      .game-link { border-radius: 12px; margin: -6px; padding: 6px; transition: background 0.12s ease; }
      .game-link:hover { background: var(--surface-2); }
      .progress { height: 4px; border-radius: 9999px; background: var(--track); overflow: hidden; }
      .progress > span { display: block; height: 100%; background: var(--pos); border-radius: inherit; }

      @media (max-width: 760px) {
        .row { grid-template-columns: minmax(0, 1fr) 72px 88px; }
        .row .hide-sm { display: none; }
        .stat-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .simple-row { grid-template-columns: minmax(0, 1fr); }
        .figures { justify-content: flex-start; }
        .figure { text-align: left; }
        .leg { grid-template-columns: 80px minmax(0, 1fr) 46px; }
        .leg .leg-game { display: none; }
      }
    </style>
  </head>

  <body>
    <div class="app">
      <div x-data="{ menu: false, theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
        @include('nav')
      </div>

      <main class="mx-auto pb-4 pt-8 px-4 sm:px-6 max-w-6xl">
        <header class="desk-heading">
          <h1 class="display">My bets</h1>
          <div x-show="signedIn()" class="flex gap-2 items-center">
            <a href="/history" data-no-router class="inline-flex gap-2 items-center px-4 h-10 font-semibold text-sm rounded-full btn"><i aria-hidden="true" class="h-4 w-4 i-hugeicons-clock-01"></i>History</a>
            <button type="button" class="inline-flex gap-2 items-center px-4 h-10 font-semibold text-sm rounded-full btn" @click="load(true)"><i aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></i>Refresh</button>
          </div>
        </header>

        <p x-show="loading()" x-cloak class="mt-6 text-sm muted" role="status">Loading your bets…</p>
        <p x-show="error()" x-cloak class="mt-5 px-4 py-3 text-sm rounded-xl card" role="status">
          <span class="font-bold neg">Not updating</span>
          <span class="muted" x-text="'— ' + error() + '. These are the last figures received.'"></span>
        </p>
        <p x-show="note()" x-cloak class="mt-5 px-4 py-3 text-sm rounded-xl card" role="status" x-text="note()"></p>

        {{-- Not signed in. Nothing here is public, so this is the whole page. --}}
        <section x-show="!loading() && !signedIn()" x-cloak class="mt-8 p-10 text-center card">
          <h2 class="text-3xl display">Sign in to follow your bets</h2>
          <p class="mt-2 mx-auto max-w-md leading-relaxed muted">Positions, live games, and P&amp;L are private to the account that holds them. Sign in, connect Kalshi, and this page fills itself.</p>
          <div class="flex flex-wrap gap-3 justify-center mt-6">
            <a href="/login" data-no-router class="px-6 py-2.5 font-bold text-sm rounded-full btn btn-primary">Log in</a>
            <a href="/signup" data-no-router class="px-6 py-2.5 font-bold text-sm rounded-full btn">Create an account</a>
          </div>
        </section>

        <div x-show="signedIn()" x-cloak>
          <nav class="desk-nav" aria-label="Bet views">
            <button type="button" :aria-pressed="panel() === 'positions'" @click="panel.set('positions')">
              <i aria-hidden="true" class="h-4 w-4 i-hugeicons-wallet-01"></i>Positions
            </button>
            <button type="button" :aria-pressed="panel() === 'suggestions'" @click="panel.set('suggestions')">
              <i aria-hidden="true" class="h-4 w-4 i-hugeicons-target-01"></i>Suggested bets
            </button>
            <button type="button" :aria-pressed="panel() === 'paper'" @click="panel.set('paper')">
              <i aria-hidden="true" class="h-4 w-4 i-hugeicons-chart-line-data-01"></i>Paper tracking
            </button>
          </nav>

          <aside x-show="checkoutNotice()" class="checkout-notice">
            <div class="flex gap-3 items-start justify-between">
              <div role="status">
                <p class="font-bold text-sm" x-text="checkoutNotice()?.title"></p>
                <p class="mt-1 text-sm muted" x-text="checkoutNotice()?.message"></p>
              </div>
              <button type="button" aria-label="Dismiss checkout message" class="desk-text-action" @click="checkoutNotice.set(null)">
                <i aria-hidden="true" class="h-4 w-4 i-hugeicons-cancel-01"></i>
              </button>
            </div>
            <a x-show="checkoutNotice()?.receipt" href="#checkout-receipts" data-no-router class="desk-text-action" @click="viewCheckoutReceipts()">View receipt</a>
          </aside>

          <section id="suggestion-slate" x-show="panel() === 'suggestions'" class="desk-panel" aria-labelledby="picks-title">
            <header class="desk-panel-heading">
              <div class="flex gap-3 items-center justify-between">
                <h2 id="picks-title" class="section-title">Suggested bets</h2>
                <button type="button" class="desk-text-action" @click="loadSuggestions()">Refresh</button>
              </div>
              <p class="mt-1 text-sm muted">Get a live quote for a $1 combo and review the payout before buying.</p>
            </header>

            <section x-show="checkoutReceipts().length" id="checkout-receipts" class="checkout-receipts" aria-labelledby="checkout-receipts-title">
              <h3 id="checkout-receipts-title" class="font-bold text-sm">Recent checkouts</h3>
              <template :for="receipt in checkoutReceipts">
                <div class="checkout-receipt">
                  <div class="min-w-0">
                    <p class="font-bold text-sm" x-text="receiptTitle(receipt)"></p>
                    <p class="mt-1 text-xs muted" x-text="receipt.labels.join(' · ')"></p>
                    <p class="mt-1 text-xs muted" x-text="receiptMessage(receipt)"></p>
                  </div>
                  <time class="text-xs muted" :datetime="receipt.at" x-text="receiptTime(receipt.at)"></time>
                </div>
              </template>
            </section>

            <p x-show="purchaseReason()" class="purchase-status" role="status">
              <i aria-hidden="true" class="h-4 w-4 i-hugeicons-information-circle"></i>
              <span x-text="purchaseReason()"></span>
              <a x-show="purchaseReason().startsWith('Connect')" href="/account" class="font-semibold">Open Account</a>
            </p>

            <p x-show="suggestionsLoading()" class="py-6 text-sm muted" role="status">Loading suggested bets…</p>
            <p x-show="suggestionsError()" class="py-4 text-sm neg" role="status">Suggested bets couldn’t refresh. Try Refresh.</p>
            <p x-show="!suggestionsLoading() && !suggestionsError() && !purchaseReason() && suggestions().length === 0" class="py-8 text-sm muted">No live suggestions meet your $1.50 minimum payout and 70% per-leg cutoff right now.</p>

            <div class="pick-grid">
              <template :for="ticket in suggestions">
                <article class="pick-card">
                  <header class="pick-card-head">
                    <h4 x-text="ticket.kind"></h4>
                    <span class="num" x-text="ticket.stake + ' stake'"></span>
                  </header>
                  <div class="pick-legs">
                    <template :for="leg in ticket.legs">
                      <a :href="leg.href" data-no-router class="pick-leg">
                        <div class="match-marks" aria-hidden="true">
                          <template :for="team in leg.teams">
                            <span class="match-mark">
                              <img x-show="team.logo" :src="team.logo" alt="" width="27" height="27" loading="lazy">
                              <span x-show="!team.logo" x-text="team.initials"></span>
                            </span>
                          </template>
                          <i x-show="leg.teams.length === 0" class="h-5 w-5 i-hugeicons-basketball-01"></i>
                        </div>
                        <div class="min-w-0">
                          <span class="pick-name" x-text="leg.label"></span>
                          <span x-show="leg.matchup" class="pick-matchup" x-text="leg.matchup"></span>
                          <span class="pick-meta" x-text="leg.league ? leg.league + ' · ' + leg.starts : leg.starts"></span>
                        </div>
                        <div x-show="leg.confidence" class="pick-chance">
                          <span class="num" x-text="leg.confidence"></span>
                          <small x-text="leg.confidenceLabel"></small>
                        </div>
                      </a>
                    </template>
                  </div>
                  <div class="pick-actions">
                    <div class="pick-stake">
                      <span class="num" x-text="checkout()[ticket.id]?.offer ? usd(checkout()[ticket.id]?.offer?.payout) : ticket.payout"></span>
                      <span x-text="checkout()[ticket.id]?.offer ? 'Live payout if all legs win' : 'Estimated total payout'"></span>
                    </div>
                  </div>
                  <p x-show="checkout()[ticket.id]?.offer" class="text-sm muted" role="status" x-text="'Up to ' + usd(checkout()[ticket.id]?.offer?.maxCost) + ' including fees'"></p>
                  <button x-show="!checkout()[ticket.id]?.offer" type="button" class="live-checkout-button pick-primary" :disabled="checkoutBusy() !== 0" @click="liveCheckout(ticket.id)" x-text="checkoutBusy() === ticket.id ? 'Checking Kalshi…' : checkout()[ticket.id]?.state === 'waiting' ? 'Check again for a quote' : 'Get live quote · $1'"></button>
                  <button x-show="checkout()[ticket.id]?.offer" type="button" class="live-checkout-button pick-primary" :disabled="checkoutBusy() !== 0" @click="liveCheckout(ticket.id, checkout()[ticket.id]?.offer?.id)" x-text="checkoutBusy() === ticket.id ? 'Submitting…' : 'Confirm $1 purchase'"></button>
                  <button x-show="checkout()[ticket.id]?.offer" type="button" class="desk-text-action" :disabled="checkoutBusy() !== 0" @click="liveCheckout(ticket.id)">Refresh quote</button>
                  <p x-show="checkout()[ticket.id]?.state === 'waiting'" class="text-xs muted" role="status">Waiting for a live payout of at least $1.50.</p>
                  <details class="pick-details">
                    <summary>Individual leg prices</summary>
                    <template :for="leg in ticket.legs">
                      <p class="text-xs muted"><strong x-text="leg.label"></strong> <span x-text="leg.side"></span> <span x-show="leg.book" x-text="' · ' + leg.book"></span></p>
                    </template>
                  </details>
                </article>
              </template>
            </div>
          </section>

          <div x-show="panel() === 'positions'" id="real-positions" class="desk-panel">
            <div class="position-overview">
              <div class="balance-hero">
                <span class="balance-label"><span class="status-dot" :class="live() ? 'on' : ''"></span>Available cash</span>
                <strong class="num" x-text="totals().cash"></strong>
              </div>
              <div class="balance-metric"><span>Portfolio value</span><strong class="num" x-text="totals().portfolio"></strong></div>
              <div class="balance-metric"><span>Unrealized P&amp;L</span><strong class="num" :class="totals().unrealizedTone" x-text="totals().unrealized"></strong></div>
              <div class="balance-metric"><span>Settled today</span><strong class="num" :class="totals().realizedTodayTone" x-text="totals().realizedToday"></strong></div>
            </div>
            <div x-show="selectedSlate() && empty()" class="saved-picks">
              <div><h2 class="font-bold" x-text="selectedSlate()?.title"></h2><p class="mt-1 text-sm muted">Review the picks PredictHQ saved for you.</p></div>
              <button type="button" class="desk-text-action" @click="panel.set('suggestions')">View suggested bets <i aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></i></button>
            </div>
          {{-- Connected venues, with whatever the venue last said. --}}
          <section x-show="accounts().length > 0" class="flex flex-wrap gap-2 items-center mt-6">
            <template :for="account in accounts">
              <div class="flex gap-2.5 items-center pl-3 pr-4 h-10 rounded-full card">
                <span class="status-dot" :class="account.healthy ? 'on' : ''"></span>
                <span class="font-semibold text-sm" x-text="account.venueLabel"></span>
                <span class="text-sm num" x-text="account.balance"></span>
                <span class="text-xs faint" x-text="account.status === 'active' ? 'synced ' + ago(account.syncedAt) : account.status"></span>
              </div>
            </template>
            <a href="/account" data-no-router class="inline-flex items-center px-4 h-10 font-semibold text-sm rounded-full btn">Manage</a>
          </section>

          {{-- A venue that stopped answering. Said plainly, because a stale
               balance that looks live is how somebody trades on a number
               that is hours old. --}}
          <template :for="account in broken">
            <p class="mt-3 px-4 py-3 text-sm rounded-xl card">
              <strong class="neg" x-text="account.venueLabel + ' · ' + account.fault"></strong>
              <span class="muted" x-text="account.error ? '— ' + account.error : '— reconnect it from your account page.'"></span>
            </p>
          </template>

          {{-- No venue connected: the one thing to do, said once. --}}
          <section x-show="!loading() && accounts().length === 0" class="mt-6 p-10 text-center card">
            <h2 class="text-3xl display">Connect Kalshi to see your bets</h2>
            <p class="mt-2 mx-auto max-w-lg leading-relaxed muted">
              Add a Kalshi API key and this page shows everything that account holds — including bets you placed in Kalshi's own app — with live scores and odds charts.
            </p>
            <a href="/account" data-no-router class="inline-flex items-center mt-6 px-6 py-2.5 font-bold text-sm rounded-full btn btn-primary">Connect a venue</a>
          </section>

          {{-- Filters. --}}
          <nav x-show="counts().all > 0" class="mt-8 chips" aria-label="Filter bets">
            <button type="button" class="chip" :class="tab() === 'all' ? 'on' : ''" @click="tab.set('all')">All <span class="chip-count" x-text="counts().all"></span></button>
            <button type="button" class="chip" :class="tab() === 'live' ? 'on' : ''" @click="tab.set('live')" x-show="counts().live > 0"><span class="live-pulse"></span> Live <span class="chip-count" x-text="counts().live"></span></button>
            <button type="button" class="chip" :class="tab() === 'upcoming' ? 'on' : ''" @click="tab.set('upcoming')" x-show="counts().upcoming > 0">Upcoming <span class="chip-count" x-text="counts().upcoming"></span></button>
            <button type="button" class="chip" :class="tab() === 'parlays' ? 'on' : ''" @click="tab.set('parlays')" x-show="counts().parlays > 0">Parlays <span class="chip-count" x-text="counts().parlays"></span></button>
            <button type="button" class="chip" :class="tab() === 'other' ? 'on' : ''" @click="tab.set('other')" x-show="counts().other > 0">Markets <span class="chip-count" x-text="counts().other"></span></button>
          </nav>

          {{-- Nothing riding. Not an error, and it should not look like one. --}}
          <section x-show="!loading() && accounts().length > 0 && empty()" class="mt-6 p-10 text-center card">
            <h2 class="text-3xl display">No open bets</h2>
            <p class="mt-2 mx-auto max-w-lg leading-relaxed muted">Your connected venues report no positions and no resting orders. Anything you place appears here within {{ POLL_SECONDS }} seconds.</p>
            <div class="flex flex-wrap gap-3 justify-center mt-6">
              <a href="/" data-no-router class="px-6 py-2.5 font-bold text-sm rounded-full btn btn-primary">Browse markets</a>
              <a href="/scores/nba/today" data-no-router class="px-6 py-2.5 font-bold text-sm rounded-full btn">Today's games</a>
            </div>
          </section>

          {{-- Live now: the reason this page exists. --}}
          <section x-show="liveGames().length > 0 && show('live')">
            <div class="section-head">
              <h2 class="section-title"><span class="live-pulse"></span> Live now</h2>
              <span class="text-xs faint">Scores and odds refresh every {{ POLL_SECONDS }}s</span>
            </div>
            <div class="game-grid">
              <template :for="position in liveGames">
                <div class="card game-card">
                  <a :href="position.gameHref" data-no-router class="block game-link" aria-label="Open the game: score, box score, and stats">
                  <div class="flex gap-2 items-center justify-between">
                    <div class="flex gap-2 items-center min-w-0">
                      <span class="font-bold text-xs tracking-wide uppercase faint" x-text="position.game.league"></span>
                      <span class="live pill"><span class="live-pulse"></span><span x-text="position.game.clock"></span></span>
                    </div>
                    <span x-show="position.game.showStanding" class="pill" :class="position.game.standingClass" x-text="position.game.standing"></span>
                  </div>

                  <div class="mt-3">
                    <div class="team-row">
                      <img x-show="position.game.away.hasLogo" :src="position.game.away.logo" alt="" class="team-logo" loading="lazy">
                      <span x-show="!position.game.away.hasLogo" class="team-logo-fallback" x-text="position.game.away.abbr"></span>
                      <div class="min-w-0">
                        <div class="flex gap-2 items-center">
                          <span class="font-bold truncate" x-text="position.game.away.name"></span>
                          <span x-show="position.game.away.rooting" class="you">YOU</span>
                        </div>
                        <div class="text-xs faint" x-text="position.game.away.record"></div>
                      </div>
                      <span class="figure-xl team-score" :class="position.game.away.lead ? '' : 'trail'" x-text="position.game.away.score"></span>
                    </div>
                    <div class="team-row">
                      <img x-show="position.game.home.hasLogo" :src="position.game.home.logo" alt="" class="team-logo" loading="lazy">
                      <span x-show="!position.game.home.hasLogo" class="team-logo-fallback" x-text="position.game.home.abbr"></span>
                      <div class="min-w-0">
                        <div class="flex gap-2 items-center">
                          <span class="font-bold truncate" x-text="position.game.home.name"></span>
                          <span x-show="position.game.home.rooting" class="you">YOU</span>
                        </div>
                        <div class="text-xs faint" x-text="position.game.home.record"></div>
                      </div>
                      <span class="figure-xl team-score" :class="position.game.home.lead ? '' : 'trail'" x-text="position.game.home.score"></span>
                    </div>
                  </div>

                  <p x-show="position.game.lastPlay" class="mt-2 last-play" x-text="position.game.lastPlay"></p>
                  <span class="inline-flex gap-1 items-center mt-2 font-semibold text-xs muted">Box score &amp; stats <i class="h-3.5 w-3.5 i-hugeicons-arrow-right-01"></i></span>
                  </a>

                  <a :href="position.href" data-no-router class="block">
                  <div class="flex gap-3 items-end justify-between mt-4">
                    <div class="min-w-0">
                      <div class="flex gap-2 items-center">
                        <span class="pill" :class="position.sideClass" x-text="position.side"></span>
                        <span class="font-semibold text-sm truncate" x-text="position.question"></span>
                      </div>
                      <div x-show="position.progress.has" class="mt-2 text-sm">
                        <span class="font-bold num" :class="position.progress.tone" x-text="position.progress.text"></span>
                        <span class="faint num" x-text="position.progress.target"></span>
                        <div x-show="position.progress.showBar" class="mt-1.5 w-40 progress"><span :style="'width:' + position.progress.width"></span></div>
                      </div>
                    </div>
                    <div class="shrink-0 text-right">
                      <div class="text-4xl figure-xl" :style="'color:' + position.chartColor" x-text="position.chance"></div>
                      <div class="font-semibold text-[11px] faint">chance</div>
                    </div>
                  </div>
                  <div x-show="position.hasSpark" class="mini-chart" x-html="position.chart"></div>

                  <div class="stat-strip">
                    <div><span class="stat-label">Contracts</span><span class="num stat-value" x-text="position.size"></span></div>
                    <div><span class="stat-label">Avg · Now</span><span class="num stat-value" x-text="position.paid + ' · ' + position.mark"></span></div>
                    <div><span class="stat-label">P&amp;L</span><span class="num stat-value" :class="position.pnlTone" x-text="position.pnl"></span></div>
                    <div><span class="stat-label">To win</span><span class="num stat-value" x-text="position.toWin"></span></div>
                  </div>
                  </a>
                </div>
              </template>
            </div>
          </section>

          {{-- Starting soon. --}}
          <section x-show="upcoming().length > 0 && show('upcoming')">
            <div class="section-head">
              <h2 class="section-title">Upcoming</h2>
            </div>
            <div class="game-grid">
              <template :for="position in upcoming">
                <div class="card game-card">
                  <a :href="position.gameHref" data-no-router class="block game-link" aria-label="Open the game preview">
                  <div class="flex gap-2 items-center justify-between">
                    <span class="font-bold text-xs tracking-wide uppercase faint" x-text="position.game.league"></span>
                    <span class="pill" x-text="position.starts"></span>
                  </div>
                  <div class="flex gap-4 items-center justify-between mt-4">
                    <div class="flex gap-3 items-center min-w-0">
                      <img x-show="position.game.away.hasLogo" :src="position.game.away.logo" alt="" class="team-logo" loading="lazy">
                      <span class="font-bold" x-text="position.game.away.abbr"></span>
                      <span x-show="position.game.away.rooting" class="you">YOU</span>
                    </div>
                    <span class="font-semibold text-xs faint">at</span>
                    <div class="flex gap-3 items-center justify-end min-w-0">
                      <span x-show="position.game.home.rooting" class="you">YOU</span>
                      <span class="font-bold" x-text="position.game.home.abbr"></span>
                      <img x-show="position.game.home.hasLogo" :src="position.game.home.logo" alt="" class="team-logo" loading="lazy">
                    </div>
                  </div>
                  </a>
                  <a :href="position.href" data-no-router class="block">
                  <div class="flex gap-3 items-end justify-between mt-4">
                    <div class="flex gap-2 items-center min-w-0">
                      <span class="pill" :class="position.sideClass" x-text="position.side"></span>
                      <span class="font-semibold text-sm truncate" x-text="position.question"></span>
                    </div>
                    <div class="shrink-0 text-right">
                      <div class="text-3xl figure-xl" x-text="position.chance"></div>
                      <div class="font-semibold text-[11px] faint">chance</div>
                    </div>
                  </div>
                  <div x-show="position.hasSpark" class="mini-chart" style="height:64px" x-html="position.chart"></div>
                  <div class="stat-strip">
                    <div><span class="stat-label">Contracts</span><span class="num stat-value" x-text="position.size"></span></div>
                    <div><span class="stat-label">Avg · Now</span><span class="num stat-value" x-text="position.paid + ' · ' + position.mark"></span></div>
                    <div><span class="stat-label">P&amp;L</span><span class="num stat-value" :class="position.pnlTone" x-text="position.pnl"></span></div>
                    <div><span class="stat-label">To win</span><span class="num stat-value" x-text="position.toWin"></span></div>
                  </div>
                  </a>
                </div>
              </template>
            </div>
          </section>

          {{-- Parlays, leg by leg. --}}
          <section x-show="parlays().length > 0 && show('parlays')">
            <div class="section-head">
              <h2 class="section-title">Parlays</h2>
            </div>
            <div class="game-grid">
              <template :for="position in parlays">
                <div class="card game-card">
                  <a :href="position.href" data-no-router class="block">
                    <div class="flex gap-3 items-start justify-between">
                      <div class="min-w-0">
                        <div class="font-bold text-lg" x-text="position.question"></div>
                        <div class="mt-1 text-xs faint" x-text="position.parlay ? position.parlay.summary : ''"></div>
                        <div x-show="position.parlay && position.parlay.next" class="flex gap-1.5 items-center mt-1.5 font-semibold text-xs" :class="position.parlay && position.parlay.liveNow ? 'live' : 'muted'">
                          <span x-show="position.parlay && position.parlay.liveNow" class="live-pulse"></span>
                          <span x-text="position.parlay ? position.parlay.next : ''"></span>
                        </div>
                      </div>
                      <div class="shrink-0 text-right">
                        <div class="text-4xl figure-xl" :class="position.parlay && position.parlay.busted ? 'neg' : ''" x-text="position.parlay ? position.parlay.chance : position.chance"></div>
                        <div class="font-semibold text-[11px] faint">chance to hit</div>
                      </div>
                    </div>
                    <div x-show="position.parlay" class="mt-3 progress"><span :style="'width:' + (position.parlay ? position.parlay.progress : '0%')"></span></div>
                  </a>
                  <p x-show="position.parlay && position.parlay.busted" class="parlay-busted"><i class="h-4 w-4 i-hugeicons-cancel-circle"></i><span x-text="position.parlay ? position.parlay.missedLabel : ''"></span></p>

                  <div x-show="position.legs.length > 0" class="mt-3">
                    <template :for="leg in position.legs">
                      <button x-show="leg.kind === 'toggle'" type="button" class="leg-toggle" @click="toggleSettled(position.key)" :aria-expanded="openSettled()[position.key] ? 'true' : 'false'">
                        <i class="h-4 w-4 i-hugeicons-checkmark-circle-02 pos"></i>
                        <span class="font-semibold text-sm" x-text="leg.text"></span>
                        <span class="text-xs muted" x-text="openSettled()[position.key] ? 'Hide' : 'Show'"></span>
                        <i class="h-4 w-4 muted" :class="openSettled()[position.key] ? 'i-hugeicons-arrow-up-01' : 'i-hugeicons-arrow-down-01'"></i>
                      </button>
                      <a x-show="leg.kind === 'leg' && (!leg.settled || openSettled()[position.key])" :href="leg.href" data-no-router class="leg" :class="leg.settled ? 'leg-settled' : ''">
                        <span class="leg-status pill" :class="leg.statusClass"><span x-show="leg.isLive" class="live-pulse"></span><span x-text="leg.statusLabel"></span></span>
                        <div class="min-w-0">
                          <div class="flex gap-1.5 items-center min-w-0">
                            <span x-show="leg.choice === 'NO'" class="no pill">NO</span>
                            <span class="font-semibold text-sm leg-label" :title="leg.label" x-text="leg.label"></span>
                          </div>
                          <div x-show="leg.progress.has" class="flex gap-2 items-center mt-1">
                            <span class="font-bold text-xs num" :class="leg.progress.tone" x-text="leg.progress.text"></span>
                            <span class="text-[11px] faint num" x-text="leg.progress.target"></span>
                            <div x-show="leg.progress.showBar" class="w-16 leg-bar progress"><span :style="'width:' + leg.progress.width"></span></div>
                          </div>
                        </div>
                        <div class="text-right leg-game">
                          <div x-show="leg.hasGame" class="font-semibold text-xs num" x-text="leg.gameLine"></div>
                          <div x-show="leg.hasGame" class="text-[11px]" :class="leg.isLive ? 'live' : 'faint'" x-text="leg.gameClock"></div>
                        </div>
                        <span class="font-bold text-right text-sm num" :class="leg.chanceTone" x-text="leg.chance"></span>
                      </a>
                    </template>
                  </div>

                  <div class="stat-strip">
                    <div><span class="stat-label">Contracts</span><span class="num stat-value" x-text="position.size"></span></div>
                    <div><span class="stat-label">Cost</span><span class="num stat-value" x-text="position.cost"></span></div>
                    <div><span class="stat-label" title="Your contracts times the product of each leg's live price. Legs in the same game move together, so this is a rough guide, not a price.">Est. value</span><span class="num stat-value" x-text="position.estValue"></span></div>
                    <div><span class="stat-label">To win</span><span class="num stat-value" x-text="position.toWin"></span></div>
                  </div>
                </div>
              </template>
            </div>
          </section>

          {{-- Everything else: elections, economics, props, finished games. --}}
          <section x-show="others().length > 0 && show('other')">
            <div class="section-head">
              <h2 class="section-title">Markets</h2>
              <span class="text-xs faint"><span class="num" :class="totals().unrealizedTone" x-text="totals().unrealized"></span> open P&amp;L overall</span>
            </div>
            <div class="overflow-hidden card">
              <template :for="position in others">
                <a :href="position.linkable ? position.href : '/positions'" data-no-router class="row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="position.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="position.sideClass" x-text="position.side"></span>
                      <span class="text-xs truncate muted" x-show="position.outcome" x-text="position.outcome"></span>
                      <span class="text-xs faint" x-text="position.size + ' @ ' + position.paid"></span>
                      <span class="text-xs faint" x-show="position.strategies" x-text="position.strategies"></span>
                    </div>
                  </div>
                  <div class="hide-sm spark" x-html="position.spark"></div>
                  <div class="cell"><span class="cell-label">Chance</span><span class="font-bold num" x-text="position.chance"></span></div>
                  <div class="cell hide-sm"><span class="cell-label">Value</span><span class="font-bold num" x-text="position.value"></span></div>
                  <div class="cell"><span class="cell-label">P&amp;L</span><span class="font-bold num" :class="position.pnlTone" x-text="position.pnl"></span></div>
                </a>
              </template>
            </div>
          </section>

          {{-- Orders still working. --}}
          <section x-show="orders().length > 0 && tab() === 'all'">
            <div class="section-head">
              <h2 class="section-title">Open orders</h2>
              <span class="text-xs faint"><span class="num" x-text="totals().committed"></span> committed</span>
            </div>
            <div class="overflow-hidden card">
              <template :for="order in orders">
                <div class="simple-row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="order.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="order.sideClass" x-text="order.side"></span>
                      <span class="text-xs muted" x-show="order.outcome" x-text="order.outcome"></span>
                      <span class="text-xs faint" x-text="order.status"></span>
                      <span class="text-xs faint" x-show="order.strategy" x-text="order.strategy"></span>
                      <span class="text-xs faint" x-text="ago(order.placedAt)"></span>
                    </div>
                  </div>
                  <div class="figures">
                    <div class="figure"><span class="cell-label">Limit</span><span class="font-bold num" x-text="order.limit"></span></div>
                    <div class="figure"><span class="cell-label">Left</span><span class="font-bold num" x-text="order.left"></span></div>
                    <div class="figure"><span class="cell-label">Committed</span><span class="font-bold num" x-text="order.committed"></span></div>
                  </div>
                </div>
              </template>
            </div>
          </section>

          {{-- Decisions the engine has made and is waiting on a person for.
               Approving runs the same executor the schedule does, so the
               risk checks are the same ones. --}}
          <section x-show="pending().length > 0 && tab() === 'all'">
            <div class="section-head">
              <h2 class="section-title">Waiting on you</h2>
              <span class="text-xs faint"><span x-text="pending().length"></span> to review</span>
            </div>
            <div class="overflow-hidden card">
              <template :for="decision in pending">
                <div class="simple-row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="decision.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="decision.sideClass" x-text="decision.side"></span>
                      <span class="text-xs muted" x-show="decision.outcome" x-text="decision.outcome"></span>
                      <span class="text-xs muted" x-text="decision.strategy"></span>
                      <span class="text-xs faint num" x-text="decision.evidence"></span>
                    </div>
                    <p class="mt-1.5 max-w-xl leading-relaxed text-xs muted" x-show="decision.rationale" x-text="decision.rationale"></p>
                  </div>
                  <div class="flex flex-wrap gap-3 items-center justify-end">
                    <div class="figure"><span class="cell-label">Stake</span><span class="font-bold num" x-text="decision.stake"></span></div>
                    <div class="figure"><span class="cell-label">Limit</span><span class="font-bold num" x-text="decision.limit"></span></div>
                    <button type="button" class="px-4 h-9 font-bold text-sm rounded-full btn btn-primary" :disabled="busy() === decision.id" @click="review(decision.id, true)">Place</button>
                    <button type="button" class="px-4 h-9 font-bold text-sm rounded-full btn" :disabled="busy() === decision.id" @click="review(decision.id, false)">Skip</button>
                  </div>
                </div>
              </template>
            </div>
          </section>

          <section x-show="settled().length > 0 && tab() === 'all'">
            <div class="section-head">
              <h2 class="section-title">Recently settled</h2>
              <span class="text-xs faint">all time <span class="num" :class="totals().realizedAllTone" x-text="totals().realizedAll"></span> · <a href="/history" data-no-router class="font-semibold underline">full history</a></span>
            </div>
            <div class="overflow-hidden card">
              <template :for="position in settled">
                <div class="simple-row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="position.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="position.resultClass" x-text="position.result"></span>
                      <span class="text-xs faint" x-text="position.outcome"></span>
                      <span class="text-xs muted" x-text="position.strategy"></span>
                      <span class="text-xs faint" x-text="ago(position.settledAt)"></span>
                    </div>
                  </div>
                  <div class="figures">
                    <div class="figure"><span class="cell-label">Size</span><span class="font-bold num" x-text="position.size"></span></div>
                    <div class="figure"><span class="cell-label">Cost</span><span class="font-bold num" x-text="position.cost"></span></div>
                    <div class="figure"><span class="cell-label">Result</span><span class="font-bold num" :class="position.realizedTone" x-text="position.realized"></span></div>
                  </div>
                </div>
              </template>
            </div>
          </section>

            <p x-show="totals().unpricedCount > 0" class="mt-6 text-sm muted" x-text="totals().unpricedCount + ' positions are awaiting quotes.'"></p>
          </div>

          <section x-show="panel() === 'paper'" id="paper-tracking" class="desk-panel" aria-labelledby="paper-title">
            <header class="desk-panel-heading">
              <h2 id="paper-title" class="section-title">Paper tracking</h2>
              <p class="mt-1 text-sm muted">Simulated trades and outcomes.</p>
            </header>
            <aside x-show="selectedSlate()" class="saved-picks">
              <div><h3 class="font-bold" x-text="selectedSlate()?.title"></h3><p class="mt-1 text-sm muted" x-text="selectedSlate()?.summary"></p></div>
              <button type="button" class="desk-text-action" @click="panel.set('suggestions')">View picks <i aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></i></button>
            </aside>
            <p x-show="!paper().length && !paperSettled().length && !selectedSlate()" class="py-8 text-sm muted">Your paper bets will appear here.</p>
          {{-- Paper, kept apart from the money above rather than summed into
               it. A simulated gain added to a real balance is a number that
               describes nothing. --}}
          <section x-show="paper().length > 0">
            <div class="section-head">
              <h2 class="section-title">Paper positions</h2>
              <span class="text-xs faint">Open P&amp;L <span class="num" :class="totals().paperTone" x-text="totals().paperUnrealized"></span></span>
            </div>
            <div class="overflow-hidden card">
              <template :for="position in paper">
                <div class="simple-row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="position.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="position.sideClass" x-text="position.side"></span>
                      <span class="text-xs muted" x-show="position.outcome" x-text="position.outcome"></span>
                      <span class="text-xs faint" x-text="position.strategies"></span>
                    </div>
                  </div>
                  <div class="figures">
                    <div class="figure"><span class="cell-label">Size</span><span class="font-bold num" x-text="position.size"></span></div>
                    <div class="figure"><span class="cell-label">Avg</span><span class="font-bold num" x-text="position.paid"></span></div>
                    <div class="figure"><span class="cell-label">Now</span><span class="font-bold num" x-text="position.mark"></span></div>
                    <div class="figure"><span class="cell-label">P&amp;L</span><span class="font-bold num" :class="position.pnlTone" x-text="position.pnl"></span></div>
                  </div>
                </div>
                {{-- A paper parlay's legs, each with how it stands. --}}
                <div x-show="position.legs.length > 0" class="paper-legs">
                  <template :for="leg in position.legs">
                    <div x-show="leg.kind === 'leg'" class="paper-leg">
                      <span class="leg-status pill" :class="leg.statusClass"><span x-show="leg.isLive" class="live-pulse"></span><span x-text="leg.statusLabel"></span></span>
                      <span x-show="leg.choice === 'NO'" class="no pill">NO</span>
                      <span class="min-w-0 text-sm truncate" :title="leg.label" x-text="leg.label"></span>
                      <span class="ml-auto font-semibold text-sm num" :class="leg.chanceTone" x-text="leg.chance"></span>
                    </div>
                  </template>
                </div>
              </template>
            </div>
          </section>

          {{-- What already happened. --}}
          {{-- Paper results, apart from real money. --}}
          <section x-show="paperSettled().length > 0">
            <div class="section-head">
              <h2 class="section-title">Paper results</h2>
              <span class="text-xs faint">All time <span class="num" :class="totals().paperRealizedTone" x-text="totals().paperRealizedAll"></span></span>
            </div>
            <div class="overflow-hidden card">
              <template :for="position in paperSettled">
                <div class="simple-row">
                  <div class="min-w-0">
                    <div class="font-semibold truncate" x-text="position.question"></div>
                    <div class="row-meta">
                      <span class="pill" :class="position.resultClass" x-text="position.result"></span>
                      <span class="text-xs faint" x-text="position.outcome"></span>
                      <span class="text-xs muted" x-text="position.strategy"></span>
                      <span class="text-xs faint" x-text="ago(position.settledAt)"></span>
                    </div>
                  </div>
                  <div class="figures">
                    <div class="figure"><span class="cell-label">Cost</span><span class="font-bold num" x-text="position.cost"></span></div>
                    <div class="figure"><span class="cell-label">Result</span><span class="font-bold num" :class="position.realizedTone" x-text="position.realized"></span></div>
                  </div>
                </div>
              </template>
            </div>
          </section>

          </section>
        </div>
      </main>

      @include('footer')
    </div>
  </body>
</html>
