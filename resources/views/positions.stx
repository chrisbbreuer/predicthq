<script server>
/**
 * PredictHQ: your book.
 *
 * Everything the signed-in user has riding right now — holdings marked
 * to the current price, orders still working, decisions waiting on a
 * person, and what has already settled.
 *
 * Client-rendered, unlike the odds board next door, and deliberately so:
 * every number here is private to one user. Server-rendering it would
 * put one account's positions into a document the page cache treats like
 * any other, and the failure mode of that mistake is somebody else's
 * portfolio. The page ships empty and fills from
 * `/api/trading/positions`, which authenticates every call.
 *
 * The payload is turned into finished display strings in `apply()` rather
 * than formatted in the markup. Template expressions here are evaluated
 * by the stx runtime rather than by a full JavaScript engine, and the
 * first draft of this page rendered zeroes forever because a getter and
 * a `.map(s => s.name)` in an attribute failed silently. Everything the
 * markup reads is now a plain property that was computed in one place.
 *
 * @see app/Actions/Trading/GetPositions.ts for the payload.
 */
const navActive = 'positions'
const pageTitle = 'PredictHQ: your book'
const pageDescription = 'Every open position, working order, and pending decision across your connected venues, marked to the current price.'

/** How often the page re-reads. Matches the venue read floor in the action. */
const POLL_SECONDS = 10
</script>

<script client>
import { useIntervalFn } from '@stacksjs/composables'
import { withCsrfHeader } from '@stacksjs/browser/composables/csrf'
import { useAuth } from '@stacksjs/browser/composables/useAuth'

const bookAuth = useAuth()
const loading = state(true)
const live = state(false)
// No private section is revealed until `/api/trading/positions` confirms the
// current PredictHQ session. The server-rendered document carries no book data.
const signedIn = state(false)
const error = state('')
const note = state('')
const busy = state(0)
const stamp = state('')
const accounts = state<any[]>([])
const broken = state<any[]>([])
const positions = state<any[]>([])
const paper = state<any[]>([])
const orders = state<any[]>([])
const pending = state<any[]>([])
const settled = state<any[]>([])
const empty = state(false)
const totals = state(blankTotals())

function blankTotals(): any {
  return {
    cash: '$0.00',
    cost: '$0.00',
    markValue: '$0.00',
    unrealized: '+$0.00',
    unrealizedTone: 'muted',
    realizedToday: '+$0.00',
    realizedTodayTone: 'muted',
    realizedAll: '+$0.00',
    realizedAllTone: 'muted',
    committed: '$0.00',
    paperUnrealized: '+$0.00',
    paperTone: 'muted',
    positionCount: 0,
  }
}

function usd(value: unknown): string {
  const amount = Number(value) || 0
  const body = Math.abs(amount).toFixed(2)
  return (amount < 0 ? '-$' : '$') + body
}

function signed(value: unknown): string {
  const amount = Number(value) || 0
  return (amount > 0 ? '+' : '') + usd(amount)
}

function tone(value: unknown): string {
  const amount = Number(value) || 0
  return amount > 0 ? 'pos' : (amount < 0 ? 'neg' : 'muted')
}

function cents(value: unknown): string {
  return Math.round((Number(value) || 0) * 100) + '¢'
}

function count(value: unknown): string {
  return String(Math.round((Number(value) || 0) * 100) / 100)
}

function instant(value: unknown): number {
  const valueString = String(value || '')
  if (!valueString)
    return 0

  const iso = valueString.indexOf('T') === -1 ? valueString.replace(' ', 'T') + 'Z' : valueString
  const parsed = Date.parse(iso)
  return Number.isFinite(parsed) ? parsed : 0
}

function ago(value: unknown): string {
  const at = instant(value)
  if (!at)
    return ''

  const seconds = Math.max(0, Math.round((Date.now() - at) / 1000))
  if (seconds < 60)
    return seconds + 's ago'
  if (seconds < 3600)
    return Math.round(seconds / 60) + 'm ago'
  if (seconds < 86400)
    return Math.round(seconds / 3600) + 'h ago'
  return Math.round(seconds / 86400) + 'd ago'
}

function clock(): string {
  const at = new Date()
  return ('0' + at.getHours()).slice(-2) + ':' + ('0' + at.getMinutes()).slice(-2) + ':' + ('0' + at.getSeconds()).slice(-2)
}

function day(value: unknown): string {
  return value ? String(value).slice(0, 10) : ''
}

function kickoff(value: unknown): string {
  const parsed = new Date(String(value || ''))
  if (!Number.isFinite(parsed.getTime()))
    return 'Scheduled'

  return parsed.toLocaleString([], {
    weekday: 'short',
    hour: 'numeric',
    minute: '2-digit',
  })
}

function gameStatus(leg: any): string {
  if (leg.state === 'in')
    return leg.clock || leg.status || 'Live'
  if (leg.state === 'post')
    return leg.status || 'Final'
  if (leg.state === 'pre')
    return kickoff(leg.startsAt)
  return leg.status || 'Waiting for matchup'
}

function scorecard(value: any): any {
  if (!value || !Array.isArray(value.legs))
    return null

  const summary: string[] = []
  if (Number(value.live) > 0)
    summary.push(value.live + ' live')
  if (Number(value.final) > 0)
    summary.push(value.final + ' final')
  if (Number(value.upcoming) > 0)
    summary.push(value.upcoming + ' upcoming')
  if (Number(value.missing) > 0)
    summary.push(value.missing + ' waiting for matchup')

  return {
    total: Number(value.total) || value.legs.length,
    summary: summary.join(' · '),
    legs: value.legs.map((leg: any, index: number) => ({
      key: String(index) + leg.team,
      href: leg.gameUrl || '/scores/ncaaf/today',
      choice: String(leg.choice || 'yes').toUpperCase(),
      team: leg.team,
      opponent: leg.opponent || 'Matchup not published',
      selectedScore: leg.selectedScore == null ? '—' : String(leg.selectedScore),
      opponentScore: leg.opponentScore == null ? '—' : String(leg.opponentScore),
      status: gameStatus(leg),
      standing: leg.standing,
      tone: leg.tone,
      live: leg.state === 'in',
      found: leg.found,
    })),
  }
}

function holding(row: any, isPaper: boolean): any {
  const marked = Number(row.mark) > 0
  const tracker = scorecard(row.scorecard)
  return {
    key: row.venue + row.marketExternalId + row.side + (isPaper ? 'p' : ''),
    question: tracker ? tracker.total + '-leg college football parlay' : row.question,
    ticker: row.marketExternalId,
    venue: row.venue,
    side: String(row.side || '').toUpperCase(),
    sideClass: String(row.side || '').toLowerCase() === 'no' ? 'no' : 'yes',
    outcome: tracker ? '' : (row.outcomeLabel || ''),
    strategies: (row.strategies || []).map((strategy: any) => strategy.name).join(', '),
    hand: row.source === 'venue',
    closes: day(row.endsAt),
    size: count(row.size),
    paid: cents(row.avgPrice),
    mark: marked ? cents(row.mark) : '—',
    value: usd(row.markValue),
    pnl: marked ? signed(row.unrealized) : '—',
    pnlTone: marked ? tone(row.unrealized) : 'muted',
    scorecard: tracker,
  }
}

function clearPrivateBook(): void {
  accounts.set([])
  broken.set([])
  positions.set([])
  paper.set([])
  orders.set([])
  pending.set([])
  settled.set([])
  totals.set(blankTotals())
  empty.set(false)
  stamp.set('')
}

function apply(data: any): void {
  const rows = data.positions || []
  const rawTotals = data.totals || {}
  const livePositions: any[] = []
  const paperPositions: any[] = []

  for (const row of rows) {
    if (row.source === 'paper')
      paperPositions.push(holding(row, true))
    else
      livePositions.push(holding(row, false))
  }

  const nextAccounts = (data.accounts || []).map((account: any) => ({
    venue: account.venue,
    balance: (Number(account.balance) < 0 ? '-$' : '$') + Math.abs(Number(account.balance) || 0).toFixed(2),
    identifier: account.maskedIdentifier,
    status: account.status,
    error: account.lastError,
    syncedAt: account.lastSyncedAt,
    fault: account.status === 'active' ? 'not syncing' : account.status,
  }))
  accounts.set(nextAccounts)
  broken.set(nextAccounts.filter((account: any) => account.status !== 'active' || account.error))
  positions.set(livePositions)
  paper.set(paperPositions)

  orders.set((data.orders || []).map((order: any, index: number) => ({
    key: 'o' + index,
    question: order.question,
    venue: order.venue,
    side: String(order.side || '').toUpperCase(),
    sideClass: String(order.side || '').toLowerCase() === 'no' ? 'no' : 'yes',
    outcome: order.outcomeLabel || '',
    status: order.status,
    strategy: order.strategy || '',
    hand: order.source === 'venue',
    placedAt: order.placedAt,
    limit: cents(order.limitPrice),
    left: count(order.remaining) + ' / ' + count(order.size),
    committed: usd(order.committed),
  })))

  pending.set((data.pending || []).map((decision: any) => ({
    id: decision.id,
    question: decision.question || decision.venue,
    side: String(decision.side || '').toUpperCase(),
    sideClass: String(decision.side || '').toLowerCase() === 'no' ? 'no' : 'yes',
    outcome: decision.outcomeLabel || '',
    strategy: decision.strategy,
    evidence: 'edge ' + Math.round((Number(decision.edge) || 0) * 100) + ' pts · confidence ' + Math.round((Number(decision.confidence) || 0) * 100) + '%',
    rationale: decision.rationale || '',
    stake: usd(decision.notional),
    limit: cents(decision.limitPrice),
  })))

  settled.set((data.settled || []).map((position: any, index: number) => {
    const realized = Number(position.realized) || 0
    return {
      key: 's' + index,
      question: position.question,
      outcome: position.outcomeLabel || position.side,
      result: position.won ? 'won' : 'lost',
      resultClass: position.won ? 'yes' : 'no',
      strategy: position.strategy + (position.mode === 'paper' ? ' · paper' : ''),
      settledAt: position.settledAt,
      size: count(position.size),
      cost: usd(position.cost),
      realized: signed(realized),
      realizedTone: tone(realized),
    }
  }))

  totals.set({
    cash: usd(rawTotals.cash),
    cost: usd(rawTotals.cost),
    markValue: usd(rawTotals.markValue),
    unrealized: signed(rawTotals.unrealized),
    unrealizedTone: tone(rawTotals.unrealized),
    realizedToday: signed(rawTotals.realizedToday),
    realizedTodayTone: tone(rawTotals.realizedToday),
    realizedAll: signed(rawTotals.realizedAll),
    realizedAllTone: tone(rawTotals.realizedAll),
    committed: usd(rawTotals.committed),
    paperUnrealized: signed(rawTotals.paperUnrealized),
    paperTone: tone(rawTotals.paperUnrealized),
    positionCount: Number(rawTotals.positions) || 0,
  })

  empty.set(livePositions.length === 0 && paperPositions.length === 0 && orders().length === 0 && pending().length === 0)
  stamp.set(clock())
}

function messageOf(value: unknown): string {
  return value instanceof Error ? value.message : String(value)
}

let refreshing: Promise<boolean> | null = null

async function refreshBookSession(): Promise<boolean> {
  if (refreshing)
    return refreshing

  const refreshToken = bookAuth.getRefreshToken()
  if (!refreshToken)
    return false

  refreshing = (async () => {
    try {
      const response = await fetch('/api/auth/refresh', {
        method: 'POST',
        credentials: 'same-origin',
        headers: withCsrfHeader({
          'Content-Type': 'application/json',
          Accept: 'application/json',
        }),
        body: JSON.stringify({ refresh_token: refreshToken }),
      })
      if (!response.ok)
        return false

      const data = await response.json()
      const accessToken = data.access_token || data.token
      if (!accessToken)
        return false

      bookAuth.token.value = accessToken
      if (data.refresh_token)
        bookAuth.refreshToken.value = data.refresh_token
      return true
    }
    catch {
      return false
    }
    finally {
      refreshing = null
    }
  })()

  return refreshing
}

/**
 * The app's private API is mounted below `/api`, including token refresh.
 * Keep the framework-managed token refs and retry semantics, while targeting
 * the route that is actually reachable through the production proxy.
 */
async function bookFetch(input: string, init: RequestInit = {}): Promise<Response> {
  const send = (): Promise<Response> => {
    const accessToken = bookAuth.getToken()
    return fetch(input, {
      ...init,
      headers: withCsrfHeader({
        ...init.headers,
        ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {}),
        Accept: 'application/json',
      }),
    })
  }

  const response = await send()
  if (response.status !== 401 || !bookAuth.getRefreshToken())
    return response

  if (!await refreshBookSession())
    return response

  return send()
}

async function load(fromVenue = false): Promise<void> {
  try {
    const response = await bookFetch('/api/trading/positions' + (fromVenue ? '?refresh=1' : ''), {
      credentials: 'same-origin',
    })

    if (response.status === 401) {
      signedIn.set(false)
      live.set(false)
      clearPrivateBook()
      return
    }

    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'))

    signedIn.set(true)
    apply(data)
    error.set('')
    live.set(true)
  }
  catch (requestError) {
    error.set(messageOf(requestError))
    live.set(false)
  }
  finally {
    loading.set(false)
  }
}

async function review(id: number, approve: boolean): Promise<void> {
  busy.set(id)
  note.set('')
  try {
    const response = await bookFetch('/api/trading/decisions/' + id + '/review', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ approve }),
    })
    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'))

    note.set(approve
      ? (data.status === 'executed' ? 'Order placed.' : 'Approved, but no order was placed: ' + (data.reason || 'see the decision feed.'))
      : 'Decision skipped.')
    await load(true)
  }
  catch (requestError) {
    note.set(messageOf(requestError))
  }
  finally {
    busy.set(0)
  }
}

const polling = useIntervalFn(() => void load(true), {{ POLL_SECONDS }} * 1000, { immediate: false })

async function start(): Promise<void> {
  await bookAuth.completeSocialLogin()
  await load(true)
  polling.resume()
}

onMount(start)
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
    <style>
      a { color: inherit; text-decoration: none; }
      .live-dot { width: 9px; height: 9px; border-radius: 9999px; background: var(--faint); }
      .live-dot.on { background: var(--pos); animation: ping 2.4s ease-out infinite; }
      @keyframes ping { 0% { box-shadow: 0 0 0 0 currentColor; opacity: 1; } 70% { box-shadow: 0 0 0 6px transparent; opacity: 0.75; } 100% { box-shadow: 0 0 0 0 transparent; opacity: 1; } }

      /*
        One row shape for holdings, orders, and settlements. They carry
        different numbers but the same anatomy — what it is on the left,
        what it is worth on the right — and giving each its own table put
        three different column rhythms on one screen.
      */
      .row { display: grid; gap: 12px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); grid-template-columns: minmax(0, 1fr) auto; }
      .row:last-child { border-bottom: 0; }
      .row-meta { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin-top: 4px; }
      .figures { display: flex; gap: 18px; align-items: baseline; justify-content: flex-end; flex-wrap: wrap; }
      .figure { text-align: right; min-width: 58px; }
      .figure-label { display: block; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); font-weight: 700; }

      .position-scorecard { grid-column: 1 / -1; border-top: 1px solid var(--border); padding-top: 12px; }
      .score-leg { min-width: 0; border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 78%, transparent); }
      .score-leg:hover { border-color: var(--border-strong); }
      .score-leg.live { border-color: color-mix(in srgb, var(--neg) 35%, var(--border)); }
      .score-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 8px; }
      .score-dot { width: 7px; height: 7px; border-radius: 9999px; background: var(--neg); animation: ping 2.4s ease-out infinite; }

      .tag { display: inline-grid; place-items: center; padding: 1px 7px; border-radius: 9999px; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; border: 1px solid var(--border-strong); color: var(--muted); }
      .tag.yes { color: var(--pos); border-color: color-mix(in srgb, var(--pos) 45%, transparent); }
      .tag.no { color: var(--neg); border-color: color-mix(in srgb, var(--neg) 45%, transparent); }
      .tag.brand { color: var(--accent-strong); border-color: color-mix(in srgb, var(--accent) 45%, transparent); background: var(--accent-weak); }

      @media (max-width: 640px) {
        .row { grid-template-columns: minmax(0, 1fr); }
        .figures { justify-content: flex-start; }
        .figure { text-align: left; }
      }
      @media (prefers-reduced-motion: reduce) {
        .live-dot.on, .score-dot { animation: none; }
      }
    </style>
  </head>

  <body>
    <div class="app">
      <div x-data="{ menu: false, theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
        @include('nav')
      </div>

      <main class="mx-auto px-4 py-8 sm:px-6 max-w-6xl">
        <div class="flex flex-wrap gap-3 items-end justify-between">
          <div>
            <div class="flex gap-2 items-center">
              <span class="live-dot" :class="live() ? 'on' : ''"></span>
              <h1 class="display font-black text-3xl tracking-tight sm:text-4xl">Your book</h1>
            </div>
            <p class="mt-1 muted">
              Every position, order, and pending decision across your connected venues — marked to the price right now.
            </p>
          </div>

          <div class="flex gap-2 items-center">
            <span class="text-xs faint num" x-text="loading() ? 'loading…' : (stamp() ? 'as of ' + stamp() : '')"></span>
            <button type="button" class="px-4 h-9 font-bold text-sm rounded-lg btn" @click="load(true)">Refresh</button>
          </div>
        </div>

        <p x-show="error()" x-cloak class="px-4 py-3 mt-5 text-sm rounded-xl card" role="status">
          <span class="neg font-bold">Not updating</span>
          <span class="muted" x-text="'— ' + error() + '. These are the last figures received.'"></span>
        </p>
        <p x-show="note()" x-cloak class="px-4 py-3 mt-5 text-sm rounded-xl card" role="status" x-text="note()"></p>

        {{-- Not signed in. Nothing here is public, so this is the whole page. --}}
        <section x-show="!loading() && !signedIn()" x-cloak class="p-8 mt-6 text-center rounded-2xl card">
          <h2 class="display font-black text-xl">Sign in to see your book</h2>
          <p class="mt-2 mx-auto max-w-md leading-relaxed muted">Positions, orders, and P&amp;L are private to the account that holds them. Sign in, connect a venue, and this page fills itself.</p>
          <div class="flex flex-wrap gap-3 justify-center mt-6">
            <a href="/login" data-no-router class="px-5 py-2.5 font-bold text-sm rounded-lg btn btn-primary">Log in</a>
            <a href="/signup" data-no-router class="px-5 py-2.5 font-bold text-sm rounded-lg btn">Create an account</a>
          </div>
        </section>

        <div x-show="signedIn()">
          {{-- Money, five ways: what is uncommitted, what is committed, what
               that is worth now, the difference, and what today has already
               banked. --}}
          <section class="grid gap-3 grid-cols-2 mt-6 lg:grid-cols-5 sm:grid-cols-3">
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num" x-text="totals().cash"></div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Cash at venues</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num" x-text="totals().cost"></div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted"><span x-text="totals().positionCount"></span> positions, at cost</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num" x-text="totals().markValue"></div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Worth now</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num" :class="totals().unrealizedTone" x-text="totals().unrealized"></div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Unrealized</div>
            </div>
            <div class="p-4 rounded-2xl card">
              <div class="font-black text-2xl num" :class="totals().realizedTodayTone" x-text="totals().realizedToday"></div>
              <div class="mt-0.5 font-semibold text-xs tracking-wide uppercase muted">Realized today</div>
            </div>
          </section>

          {{-- No venue connected: the one thing to do, said once. --}}
          <section x-show="!loading() && accounts().length === 0" x-cloak class="p-8 mt-5 text-center rounded-2xl card">
            <h2 class="display font-black text-xl">No venue connected yet</h2>
            <p class="mt-2 mx-auto max-w-lg leading-relaxed muted">
              Connect Kalshi with an API key and this page shows what that account holds — including positions you took in Kalshi's own app, not only the ones PredictHQ opened.
            </p>
            <a href="/account" data-no-router class="inline-flex items-center px-5 py-2.5 mt-6 font-bold text-sm rounded-lg btn btn-primary">Connect a venue →</a>
          </section>

          {{-- Connected accounts, with whatever the venue last said. --}}
          <section x-show="accounts().length > 0" x-cloak class="flex flex-wrap gap-3 mt-5">
            <template :for="account in accounts">
              <div class="flex gap-3 items-center px-4 py-3 rounded-xl card">
                <span class="tag brand" x-text="account.venue"></span>
                <div class="min-w-0">
                  <div class="font-bold num" x-text="account.balance"></div>
                  <div class="text-xs truncate faint">
                    <span x-text="account.identifier"></span>
                    <span x-text="account.status === 'active' ? '· synced ' + ago(account.syncedAt) : '· ' + account.status"></span>
                  </div>
                </div>
              </div>
            </template>
            <a href="/account" data-no-router class="flex items-center px-4 py-3 font-bold text-sm rounded-xl btn">Manage venues</a>
          </section>

          {{-- A venue that stopped answering. Said plainly, because a stale
               balance that looks live is how somebody trades on a number
               that is hours old. --}}
          <template :for="account in broken">
            <p class="px-4 py-3 mt-3 text-sm rounded-xl card">
              <strong class="neg" x-text="account.venue + ' · ' + account.fault"></strong>
              <span class="muted" x-text="account.error ? '— ' + account.error : '— reconnect it from your account page.'"></span>
            </p>
          </template>

          {{-- Nothing riding. Not an error, and it should not look like one. --}}
          <section x-show="!loading() && accounts().length > 0 && empty()" x-cloak class="p-8 mt-5 text-center rounded-2xl card">
            <h2 class="display font-black text-xl">Nothing open right now</h2>
            <p class="mt-2 mx-auto max-w-lg leading-relaxed muted">Your connected venues report no positions and no resting orders. Anything a strategy opens, or you place yourself, appears here within {{ POLL_SECONDS }} seconds.</p>
            <div class="flex flex-wrap gap-3 justify-center mt-6">
              <a href="/" data-no-router class="px-5 py-2.5 font-bold text-sm rounded-lg btn btn-primary">Open the odds board</a>
              <a href="/markets" data-no-router class="px-5 py-2.5 font-bold text-sm rounded-lg btn">See what smart money is buying</a>
            </div>
          </section>

          {{-- Holdings. --}}
          <section x-show="positions().length > 0" x-cloak class="overflow-hidden mt-6 rounded-2xl card">
            <div class="flex items-center justify-between px-4 py-3 border-b bd">
              <span class="font-bold">Open positions</span>
              <span class="text-xs faint"><span x-text="positions().length"></span> held · <span class="num" :class="totals().unrealizedTone" x-text="totals().unrealized"></span> unrealized</span>
            </div>

            <template :for="position in positions">
              <div class="row">
                <div class="min-w-0">
                  <div class="font-bold truncate" x-text="position.question"></div>
                  <div class="row-meta">
                    <span class="tag" :class="position.sideClass" x-text="position.side"></span>
                    <span class="text-xs muted" x-show="position.outcome" x-text="position.outcome"></span>
                    <span class="text-xs faint num" x-text="position.ticker"></span>
                    <span class="text-xs muted" x-show="position.strategies" x-text="position.strategies"></span>
                    <span class="text-xs faint" x-show="position.hand">placed outside PredictHQ</span>
                    <span class="text-xs faint" x-show="position.closes" x-text="'closes ' + position.closes"></span>
                  </div>
                </div>

                <div class="figures">
                  <div class="figure"><span class="figure-label">Size</span><span class="font-bold num" x-text="position.size"></span></div>
                  <div class="figure"><span class="figure-label">Paid</span><span class="font-bold num" x-text="position.paid"></span></div>
                  <div class="figure"><span class="figure-label">Now</span><span class="font-bold num" x-text="position.mark"></span></div>
                  <div class="figure"><span class="figure-label">Value</span><span class="font-bold num" x-text="position.value"></span></div>
                  <div class="figure"><span class="figure-label">P&amp;L</span><span class="font-black num" :class="position.pnlTone" x-text="position.pnl"></span></div>
                </div>

                <template :if="position.scorecard">
                  <div class="position-scorecard">
                    <div class="flex flex-wrap gap-2 items-center justify-between mb-2.5">
                      <div class="flex gap-2 items-center">
                        <span class="font-black text-sm">Live leg tracker</span>
                        <span class="tag brand" x-text="position.scorecard.total + ' legs'"></span>
                      </div>
                      <span class="text-xs faint" x-text="position.scorecard.summary"></span>
                    </div>

                    <div class="score-grid">
                      <template :for="leg in position.scorecard.legs">
                        <a :href="leg.href" data-no-router class="block p-3 rounded-xl score-leg" :class="leg.live ? 'live' : ''">
                          <div class="flex gap-2 items-center justify-between">
                            <div class="flex gap-1.5 items-center min-w-0">
                              <span x-show="leg.live" class="score-dot shrink-0"></span>
                              <span class="font-bold text-[11px] truncate" :class="leg.live ? 'neg' : 'faint'" x-text="leg.status"></span>
                            </div>
                            <span class="font-black text-[11px] uppercase" :class="leg.tone" x-text="leg.standing"></span>
                          </div>

                          <div class="flex gap-3 items-center mt-2.5">
                            <span class="grid place-items-center h-8 w-8 rounded-lg soft shrink-0" aria-hidden="true">
                              <i class="h-4 w-4 i-hugeicons-american-football"></i>
                            </span>
                            <div class="min-w-0 grow">
                              <div class="flex gap-1.5 items-center min-w-0">
                                <span class="tag" :class="leg.tone" x-text="leg.choice"></span>
                                <span class="font-black text-sm truncate" x-text="leg.team"></span>
                              </div>
                              <div class="mt-1 text-xs truncate faint" x-text="'vs ' + leg.opponent"></div>
                            </div>

                            <div class="flex gap-2 items-baseline shrink-0" x-show="leg.found">
                              <span class="font-black text-xl num" :class="leg.tone" x-text="leg.selectedScore"></span>
                              <span class="text-xs faint">–</span>
                              <span class="font-bold text-sm num muted" x-text="leg.opponentScore"></span>
                            </div>
                          </div>
                        </a>
                      </template>
                    </div>
                  </div>
                </template>
              </div>
            </template>
          </section>

          {{-- Orders still working. --}}
          <section x-show="orders().length > 0" x-cloak class="overflow-hidden mt-5 rounded-2xl card">
            <div class="flex items-center justify-between px-4 py-3 border-b bd">
              <span class="font-bold">Working orders</span>
              <span class="text-xs faint"><span class="num" x-text="totals().committed"></span> committed</span>
            </div>

            <template :for="order in orders">
              <div class="row">
                <div class="min-w-0">
                  <div class="font-bold truncate" x-text="order.question"></div>
                  <div class="row-meta">
                    <span class="tag" :class="order.sideClass" x-text="order.side"></span>
                    <span class="text-xs muted" x-show="order.outcome" x-text="order.outcome"></span>
                    <span class="text-xs muted" x-text="order.status"></span>
                    <span class="text-xs faint" x-show="order.strategy" x-text="order.strategy"></span>
                    <span class="text-xs faint" x-show="order.hand">placed outside PredictHQ</span>
                    <span class="text-xs faint" x-text="ago(order.placedAt)"></span>
                  </div>
                </div>

                <div class="figures">
                  <div class="figure"><span class="figure-label">Limit</span><span class="font-bold num" x-text="order.limit"></span></div>
                  <div class="figure"><span class="figure-label">Left</span><span class="font-bold num" x-text="order.left"></span></div>
                  <div class="figure"><span class="figure-label">Committed</span><span class="font-black num" x-text="order.committed"></span></div>
                </div>
              </div>
            </template>
          </section>

          {{-- Decisions the engine has made and is waiting on a person for.
               Approving runs the same executor the schedule does, so the
               risk checks are the same ones. --}}
          <section x-show="pending().length > 0" x-cloak class="overflow-hidden mt-5 rounded-2xl card">
            <div class="flex items-center justify-between px-4 py-3 border-b bd">
              <span class="font-bold">Waiting on you</span>
              <span class="text-xs faint"><span x-text="pending().length"></span> to review</span>
            </div>

            <template :for="decision in pending">
              <div class="row">
                <div class="min-w-0">
                  <div class="font-bold truncate" x-text="decision.question"></div>
                  <div class="row-meta">
                    <span class="tag" :class="decision.sideClass" x-text="decision.side"></span>
                    <span class="text-xs muted" x-show="decision.outcome" x-text="decision.outcome"></span>
                    <span class="text-xs muted" x-text="decision.strategy"></span>
                    <span class="text-xs faint num" x-text="decision.evidence"></span>
                  </div>
                  <p class="mt-1.5 max-w-xl text-xs leading-relaxed muted" x-show="decision.rationale" x-text="decision.rationale"></p>
                </div>

                <div class="flex flex-wrap gap-3 items-center justify-end">
                  <div class="figure"><span class="figure-label">Stake</span><span class="font-bold num" x-text="decision.stake"></span></div>
                  <div class="figure"><span class="figure-label">Limit</span><span class="font-bold num" x-text="decision.limit"></span></div>
                  <button type="button" class="px-3 h-9 font-bold text-sm rounded-lg btn btn-primary" :disabled="busy() === decision.id" @click="review(decision.id, true)">Place</button>
                  <button type="button" class="px-3 h-9 font-bold text-sm rounded-lg btn" :disabled="busy() === decision.id" @click="review(decision.id, false)">Skip</button>
                </div>
              </div>
            </template>
          </section>

          {{-- Paper, kept apart from the money above rather than summed into
               it. A simulated gain added to a real balance is a number that
               describes nothing. --}}
          <section x-show="paper().length > 0" x-cloak class="overflow-hidden mt-5 rounded-2xl card">
            <div class="flex items-center justify-between px-4 py-3 border-b bd">
              <span class="font-bold">Paper positions</span>
              <span class="text-xs faint">not real money · <span class="num" :class="totals().paperTone" x-text="totals().paperUnrealized"></span></span>
            </div>

            <template :for="position in paper">
              <div class="row">
                <div class="min-w-0">
                  <div class="font-bold truncate" x-text="position.question"></div>
                  <div class="row-meta">
                    <span class="tag" :class="position.sideClass" x-text="position.side"></span>
                    <span class="text-xs muted" x-show="position.outcome" x-text="position.outcome"></span>
                    <span class="text-xs muted" x-text="position.strategies"></span>
                  </div>
                </div>
                <div class="figures">
                  <div class="figure"><span class="figure-label">Size</span><span class="font-bold num" x-text="position.size"></span></div>
                  <div class="figure"><span class="figure-label">Paid</span><span class="font-bold num" x-text="position.paid"></span></div>
                  <div class="figure"><span class="figure-label">Now</span><span class="font-bold num" x-text="position.mark"></span></div>
                  <div class="figure"><span class="figure-label">P&amp;L</span><span class="font-black num" :class="position.pnlTone" x-text="position.pnl"></span></div>
                </div>
              </div>
            </template>
          </section>

          {{-- What already happened. The only section here that is finished. --}}
          <section x-show="settled().length > 0" x-cloak class="overflow-hidden mt-5 rounded-2xl card">
            <div class="flex items-center justify-between px-4 py-3 border-b bd">
              <span class="font-bold">Recently settled</span>
              <span class="text-xs faint">all time <span class="num" :class="totals().realizedAllTone" x-text="totals().realizedAll"></span></span>
            </div>

            <template :for="position in settled">
              <div class="row">
                <div class="min-w-0">
                  <div class="font-bold truncate" x-text="position.question"></div>
                  <div class="row-meta">
                    <span class="tag" :class="position.resultClass" x-text="position.result"></span>
                    <span class="text-xs faint" x-text="position.outcome"></span>
                    <span class="text-xs muted" x-text="position.strategy"></span>
                    <span class="text-xs faint" x-text="ago(position.settledAt)"></span>
                  </div>
                </div>
                <div class="figures">
                  <div class="figure"><span class="figure-label">Size</span><span class="font-bold num" x-text="position.size"></span></div>
                  <div class="figure"><span class="figure-label">Cost</span><span class="font-bold num" x-text="position.cost"></span></div>
                  <div class="figure"><span class="figure-label">Result</span><span class="font-black num" :class="position.realizedTone" x-text="position.realized"></span></div>
                </div>
              </div>
            </template>
          </section>

          <p class="mt-6 max-w-3xl text-xs leading-relaxed faint">
            Positions and balances are read from the venue itself, so what is shown is what the venue reports — including anything you traded in its own app. Prices mark against the last trade seen, which is an estimate of value rather than a price you can sell at.
          </p>
        </div>
      </main>

      @include('footer')
    </div>
  </body>
</html>
