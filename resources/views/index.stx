<script server>
import { loadDiscovery, marketCategories, marketLeagues } from '../../app/Support/market-discovery'
const navActive = 'home'
const pageTitle = 'PredictHQ | A clearer view of every market'
const pageDescription = 'Discover prediction markets across sports, politics, crypto, and culture. Compare the chances, follow the money, and bring your friends.'
const discovery = await loadDiscovery(query)
const cards = discovery.cards
const featured = cards[0] || null
const selectedCategory = discovery.category
const selectedLeague = discovery.league
const heading = marketLeagues.find(item => item.slug === selectedLeague)?.label || marketCategories.find(item => item.slug === selectedCategory)?.label || 'Home'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <div class="app min-h-[100dvh] market-home">
      @include('nav')
      <nav aria-label="Market categories" class="border-b bd category-strip">
        <div class="flex items-center gap-6 overflow-x-auto mx-auto max-w-7xl px-4 sm:px-6">
          @foreach (marketCategories as category)
            <a href="/?category={{ category.slug }}" data-no-router class="category-link {{ selectedCategory === category.slug && !selectedLeague ? 'selected' : '' }}" {{ selectedCategory === category.slug && !selectedLeague ? 'aria-current=page' : '' }}>
              @if (category.image)<img src="/assets/images/markets/{{ category.image }}.png" alt="" width="22" height="22" class="object-contain">@endif
              {{ category.label }}
            </a>
          @endforeach
        </div>
      </nav>
      <main class="mx-auto max-w-7xl px-4 py-7 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
          <div class="min-w-0">
            @if (selectedCategory === 'all' && !selectedLeague && !discovery.query && featured)
              <section class="feature-market p-6 sm:p-8 rounded-2xl mb-7">
                <div class="flex items-center gap-2 text-sm muted">@if (featured.image)<img src="{{ featured.image }}" alt="" width="24" height="24" class="object-contain">@else<i class="h-6 w-6 accent i-hugeicons-chart-increase"></i>@endif<span>{{ featured.categoryLabel }}</span><span aria-hidden="true">·</span><span>{{ featured.venueLabel }}</span></div>
                <div class="grid gap-7 sm:grid-cols-[minmax(0,1fr)_150px] mt-5 items-center">
                  <div><h1 class="font-bold tracking-tight text-2xl sm:text-3xl leading-snug line-clamp-3">{{ featured.question }}</h1><p class="mt-3 text-sm muted">{{ featured.outcome_label || 'Market probability' }}</p><a href="{{ featured.href }}" data-no-router class="inline-flex mt-6 px-4 py-2.5 rounded-lg text-sm font-semibold btn btn-primary">Explore market <i class="ml-2 h-4 w-4 i-hugeicons-arrow-right-01"></i></a></div>
                  <div class="sm:text-right"><p class="text-5xl sm:text-6xl font-semibold tracking-tight accent num">{{ featured.yes }}</p><p class="mt-2 text-sm muted">chance of Yes</p><p class="mt-5 text-xs faint">{{ featured.volumeLabel }} volume</p></div>
                </div>
              </section>
            @endif
            <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
              <h2 class="font-bold text-xl">{{ discovery.query ? 'Search results' : heading === 'Home' ? 'Trending markets' : heading }}</h2>
              <form action="/" method="get" class="flex items-center gap-2 px-3 h-10 rounded-lg input market-search">
                <i class="h-4 w-4 faint i-hugeicons-search-01"></i>
                <input type="hidden" name="category" value="{{ selectedCategory }}">
                <input type="hidden" name="league" value="{{ selectedLeague }}">
                <input name="q" type="search" value="{{ discovery.query }}" maxlength="120" placeholder="Search markets" aria-label="Search markets" class="min-w-0 w-40 sm:w-48 bg-transparent text-sm outline-none">
                <button type="submit" class="text-sm font-semibold accent">Search</button>
              </form>
            </div>
            <div class="flex gap-2 overflow-x-auto mb-5 pb-1" aria-label="Popular leagues">
              @foreach (marketLeagues.slice(0, 8) as league)
                <a href="/?category=sports&league={{ league.slug }}" data-no-router class="flex shrink-0 gap-2 items-center px-3 py-2 rounded-lg text-xs font-semibold league-chip {{ selectedLeague === league.slug ? 'active' : '' }}"><img src="/assets/images/markets/{{ league.image }}.png" alt="" width="20" height="20" class="object-contain">{{ league.label }}</a>
              @endforeach
            </div>
            @if (cards.length > 0)
              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (cards as market)
                  <article class="market-card p-4 rounded-xl flex flex-col">
                    <div class="flex items-start gap-3">@if (market.image)<img src="{{ market.image }}" alt="" width="40" height="40" loading="lazy" class="h-10 w-10 object-contain shrink-0">@else<i class="h-10 w-10 shrink-0 accent i-hugeicons-chart-increase"></i>@endif<h3 class="font-semibold text-sm leading-snug line-clamp-3"><a href="{{ market.href }}" data-no-router>{{ market.question }}</a></h3></div>
                    <p class="text-xs mt-4 mb-4 muted line-clamp-1">{{ market.outcome_label || market.categoryLabel }}</p>
                    <div class="grid grid-cols-2 gap-2 mt-auto"><a href="{{ market.href }}" data-no-router class="probability-yes rounded-lg py-2.5 px-3 text-xs font-semibold flex justify-between"><span>Yes</span><span class="num">{{ market.yes }}</span></a><a href="{{ market.href }}" data-no-router class="probability-no rounded-lg py-2.5 px-3 text-xs font-semibold flex justify-between"><span>No</span><span class="num">{{ market.no }}</span></a></div>
                    <div class="flex justify-between items-center mt-4 text-xs faint"><span>{{ market.volumeLabel }} vol.</span><span>{{ market.venueLabel }}</span></div>
                  </article>
                @endforeach
              </div>
            @else
              <section class="p-8 sm:p-12 rounded-xl card">
                <i class="h-8 w-8 muted i-hugeicons-search-01"></i>
                <h2 class="mt-4 text-xl font-bold">{{ discovery.unavailable ? 'Markets are temporarily unavailable.' : 'No matching markets right now.' }}</h2>
                <p class="mt-3 text-sm muted">{{ discovery.unavailable ? 'We could not load the market feed. Please try again shortly.' : 'Try another category or search, or explore the odds board for more coverage.' }}</p>
                <div class="flex gap-3 mt-5"><a href="/" class="px-4 py-2 rounded-lg btn btn-primary">All markets</a><a href="/odds" class="px-4 py-2 rounded-lg btn">Odds board</a></div>
              </section>
            @endif
            <p class="mt-5 text-xs faint">Prices reflect the latest captured quote. Open a market to check its update time.</p>
          </div>
          <aside class="min-w-0">
            <section class="p-6 rounded-2xl circle-callout">
              <i class="h-8 w-8 i-hugeicons-user-group"></i>
              <h2 class="mt-5 text-2xl font-bold leading-tight">Your people.<br>Your predictions.</h2>
              <p class="mt-3 text-sm">Build a private group and bring your friends into the conversation.</p>
              <a href="/groups" data-no-router class="inline-flex mt-5 items-center gap-2 px-4 py-2.5 text-sm rounded-lg font-semibold group-cta">Create a group <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
            </section>
            <section class="mt-7">
              <h2 class="text-sm font-semibold muted mb-3">Popular leagues</h2>
              @foreach (marketLeagues as league)
                <a href="/?category=sports&league={{ league.slug }}" data-no-router class="flex items-center gap-3 py-3 hover:opacity-70"><img src="/assets/images/markets/{{ league.image }}.png" alt="" width="32" height="32" class="h-8 w-8 object-contain"><span class="flex-1"><small class="block text-xs faint">{{ league.sport }}</small><strong class="block mt-0.5 text-sm">{{ league.label }}</strong></span><i class="h-4 w-4 faint i-hugeicons-arrow-right-01"></i></a>
              @endforeach
            </section>
            <section class="pt-5 mt-5 border-t bd">
              <h2 class="font-semibold text-sm">See the bigger picture</h2>
              <a href="/markets" data-no-router class="flex items-center justify-between py-4 text-sm muted">Follow smart money <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
              <a href="/odds" data-no-router class="flex items-center justify-between py-3 text-sm muted">Compare every book <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
              <a href="/account" data-no-router class="flex items-center justify-between py-3 text-sm muted">Connect an exchange <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
            </section>
          </aside>
        </div>
      </main>
      @include('footer')
    </div>
  </body>
</html>

<style>
  .market-home { font-family: 'Geist', sans-serif; }
  .market-home .overflow-x-auto { scrollbar-width: none; }
  .market-home .overflow-x-auto::-webkit-scrollbar { display: none; }
  .category-strip { background: var(--surface); }
  .category-link { display: flex; align-items: center; gap: 0.4rem; position: relative; flex-shrink: 0; height: 52px; color: var(--muted); font-size: 13px; font-weight: 600; }
  .category-link.selected { color: var(--text); }
  .category-link.selected::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--accent); border-radius: 3px; }
  .feature-market { background: var(--surface-2); border: 1px solid var(--border); }
  .market-card { background: var(--surface); border: 1px solid var(--border); transition: border-color 150ms ease; min-height: 213px; }
  .market-card:hover { border-color: var(--border-strong); }
  .market-card h3 a:hover { color: var(--accent); }
  .league-chip { color: var(--muted); background: var(--surface); border: 1px solid var(--border); }
  .league-chip.active { color: var(--accent); border-color: var(--accent); }
  .probability-yes { background: color-mix(in srgb, var(--pos) 12%, var(--surface)); color: var(--pos); }
  .probability-no { background: color-mix(in srgb, var(--neg) 10%, var(--surface)); color: var(--neg); }
  .circle-callout { background: #3158ed; color: #fff; }
  .circle-callout p { color: #ecf0ff; }
  .group-cta { background: #fff; color: #2345ce; }
  @media (prefers-reduced-motion: reduce) { .market-card { transition: none; } }
</style>
