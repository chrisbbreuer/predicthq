<script server>
import { loadDiscovery, marketCategories, marketLeagues } from '../../app/Support/market-discovery'
const canonicalPath = '/'
const navActive = 'home'
const pageTitle = 'PredictHQ | A clearer view of every market'
const pageDescription = 'Kalshi and Polymarket prices side by side, live scores next to the markets they move, and a tracker that follows your bets leg by leg.'
const discovery = await loadDiscovery(query)
const cards = discovery.cards
const featured = cards[0] || null
const selectedCategory = discovery.category
const selectedLeague = discovery.league
const heading = marketLeagues.find(item => item.slug === selectedLeague)?.label || marketCategories.find(item => item.slug === selectedCategory)?.label || 'Home'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
    {{-- Who publishes the site, for search engines and AI answer engines. --}}
    <script type="application/ld+json">
      {
        "@@context": "https://schema.org",
        "@@graph": [
          {
            "@@type": "Organization",
            "@@id": "https://predicthq.org/#organization",
            "name": "PredictHQ",
            "url": "https://predicthq.org/",
            "logo": "https://predicthq.org/favicon-512x512.png"
          },
          {
            "@@type": "WebSite",
            "@@id": "https://predicthq.org/#website",
            "name": "PredictHQ",
            "url": "https://predicthq.org/",
            "description": "Prediction market prices from Kalshi and Polymarket, live scores, and a tracker for your own bets.",
            "publisher": { "@@id": "https://predicthq.org/#organization" }
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="min-h-[100dvh] app market-home">
      @include('nav')
      <nav aria-label="Market categories" class="border-b bd category-strip">
        <div class="flex overflow-x-auto gap-6 items-center mx-auto px-4 sm:px-6 max-w-7xl">
          @foreach (marketCategories as category)
            <a href="/?category={{ category.slug }}" data-no-router class="category-link {{ selectedCategory === category.slug && !selectedLeague ? 'selected' : '' }}" aria-current="{{ selectedCategory === category.slug && !selectedLeague ? 'page' : 'false' }}">
              @if (category.image)<img src="/assets/images/markets/{{ category.image }}.png" alt="" width="22" height="22" class="object-contain">@endif
              {{ category.label }}
            </a>
          @endforeach
        </div>
      </nav>
      <main class="mx-auto px-4 py-7 sm:px-6 max-w-7xl">
        {{-- What this is, said once, for anyone arriving cold. Hidden on a
             filtered or searched view, where the visitor already knows. --}}
        @if (selectedCategory === 'all' && !selectedLeague && !discovery.query)
          <section class="flex flex-wrap gap-6 items-end justify-between mb-8 pb-8 border-b bd">
            <div class="max-w-2xl">
              <h1 class="leading-[1.02] text-5xl sm:text-6xl display">Every prediction market, one clear view</h1>
              <p class="mt-4 leading-relaxed text-lg muted">Kalshi and Polymarket prices side by side, live scores next to the markets that depend on them, and a tracker that follows your own bets leg by leg.</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="/scanner" data-no-router class="inline-flex gap-2 items-center px-5 h-11 font-semibold text-sm rounded-full btn btn-primary"><span class="live-pulse"></span>Live scanner</a>
              <a href="/positions" data-no-router class="inline-flex items-center px-5 h-11 font-semibold text-sm rounded-full btn">Track my bets</a>
            </div>
          </section>
        @endif
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
          <div class="min-w-0">
            @if (selectedCategory === 'all' && !selectedLeague && !discovery.query && featured)
              <section class="mb-7 p-6 sm:p-8 rounded-2xl feature-market">
                <div class="flex gap-2 items-center text-sm muted">@if (featured.image)<img src="{{ featured.image }}" alt="" width="24" height="24" class="object-contain">@else<i class="h-6 w-6 accent i-hugeicons-chart-increase"></i>@endif<span>{{ featured.categoryLabel }}</span><span aria-hidden="true">·</span><span>{{ featured.venueLabel }}</span></div>
                <div class="grid gap-7 items-center sm:grid-cols-[minmax(0,1fr)_150px] mt-5">
                  <div><h2 class="font-bold leading-snug line-clamp-3 text-2xl tracking-tight sm:text-3xl">{{ featured.question }}</h2><p class="mt-3 text-sm muted">{{ featured.outcome_label || 'Market probability' }}</p><a href="{{ featured.href }}" data-no-router class="inline-flex mt-6 px-4 py-2.5 font-semibold text-sm rounded-lg btn btn-primary">Explore market <i class="ml-2 h-4 w-4 i-hugeicons-arrow-right-01"></i></a></div>
                  <div class="sm:text-right"><p class="font-semibold text-5xl tracking-tight sm:text-6xl accent num">{{ featured.yes }}</p><p class="mt-2 text-sm muted">chance of Yes</p><p class="mt-5 text-xs faint">{{ featured.volumeLabel }} volume</p></div>
                </div>
              </section>
            @endif
            <div class="flex flex-wrap gap-4 items-center justify-between mb-5">
              <h2 class="font-bold text-xl">{{ discovery.query ? 'Search results' : heading === 'Home' ? 'Trending markets' : heading }}</h2>
              <form action="/" method="get" class="flex gap-2 items-center px-3 h-10 rounded-lg input market-search">
                <i class="h-4 w-4 faint i-hugeicons-search-01"></i>
                <input type="hidden" name="category" value="{{ selectedCategory }}">
                <input type="hidden" name="league" value="{{ selectedLeague }}">
                <input name="q" type="search" value="{{ discovery.query }}" maxlength="120" placeholder="Search markets" aria-label="Search markets" class="min-w-0 w-40 sm:w-48 text-sm bg-transparent outline-none">
                <button type="submit" class="font-semibold text-sm accent">Search</button>
              </form>
            </div>
            <div class="flex overflow-x-auto gap-2 mb-5 pb-1" aria-label="Popular leagues">
              @foreach (marketLeagues.slice(0, 8) as league)
                <a href="/?category=sports&league={{ league.slug }}" data-no-router class="flex shrink-0 gap-2 items-center px-3 py-2 rounded-lg text-xs font-semibold league-chip {{ selectedLeague === league.slug ? 'active' : '' }}"><img src="/assets/images/markets/{{ league.image }}.png" alt="" width="20" height="20" class="object-contain">{{ league.label }}</a>
              @endforeach
            </div>
            @if (cards.length > 0)
              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (cards as market)
                  <article class="flex flex-col p-4 rounded-xl market-card">
                    <div class="flex gap-3 items-start">@if (market.image)<img src="{{ market.image }}" alt="" width="40" height="40" loading="lazy" class="object-contain shrink-0 h-10 w-10">@else<i class="shrink-0 h-10 w-10 accent i-hugeicons-chart-increase"></i>@endif<h3 class="font-semibold leading-snug line-clamp-3 text-sm"><a href="{{ market.href }}" data-no-router>{{ market.question }}</a></h3></div>
                    <p class="mb-4 mt-4 line-clamp-1 text-xs muted">{{ market.outcome_label || market.categoryLabel }}</p>
                    <div class="grid gap-2 grid-cols-2 mt-auto"><a href="{{ market.href }}" data-no-router class="flex justify-between px-3 py-2.5 font-semibold text-xs rounded-lg probability-yes"><span>Yes</span><span class="num">{{ market.yes }}</span></a><a href="{{ market.href }}" data-no-router class="flex justify-between px-3 py-2.5 font-semibold text-xs rounded-lg probability-no"><span>No</span><span class="num">{{ market.no }}</span></a></div>
                    <div class="flex items-center justify-between mt-4 text-xs faint"><span>{{ market.volumeLabel }} vol.</span><span>{{ market.venueLabel }}</span></div>
                  </article>
                @endforeach
              </div>
            @else
              <section class="p-8 sm:p-12 rounded-xl card">
                <i class="h-8 w-8 i-hugeicons-search-01 muted"></i>
                <h2 class="mt-4 font-bold text-xl">{{ discovery.unavailable ? 'Markets are temporarily unavailable.' : 'No matching markets right now.' }}</h2>
                <p class="mt-3 text-sm muted">{{ discovery.unavailable ? 'We could not load the market feed. Please try again shortly.' : 'Try another category or search, or explore the odds board for more coverage.' }}</p>
                <div class="flex gap-3 mt-5"><a href="/" class="px-4 py-2 rounded-lg btn btn-primary">All markets</a><a href="/odds" class="px-4 py-2 rounded-lg btn">Odds board</a></div>
              </section>
            @endif
            <p class="mt-5 text-xs faint">Prices reflect the latest captured quote. Open a market to check its update time.</p>
          </div>
          <aside class="min-w-0">
            <section class="p-6 rounded-2xl circle-callout">
              <i class="h-8 w-8 i-hugeicons-user-group"></i>
              <h2 class="mt-5 font-bold leading-tight text-2xl">Your people.<br>Your predictions.</h2>
              <p class="mt-3 text-sm">Build a private group and bring your friends into the conversation.</p>
              <a href="/groups" data-no-router class="inline-flex gap-2 items-center mt-5 px-4 py-2.5 font-semibold text-sm rounded-lg group-cta">Create a group <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
            </section>
            <section class="mt-7">
              <h2 class="mb-3 font-semibold text-sm muted">Popular leagues</h2>
              @foreach (marketLeagues as league)
                <a href="/?category=sports&league={{ league.slug }}" data-no-router class="flex gap-3 items-center py-3 hover:opacity-70"><img src="/assets/images/markets/{{ league.image }}.png" alt="" width="32" height="32" class="object-contain h-8 w-8"><span class="flex-1"><small class="block text-xs faint">{{ league.sport }}</small><strong class="block mt-0.5 text-sm">{{ league.label }}</strong></span><i class="h-4 w-4 faint i-hugeicons-arrow-right-01"></i></a>
              @endforeach
            </section>
            <section class="mt-5 pt-5 border-t bd">
              <h2 class="font-semibold text-sm">See the bigger picture</h2>
              <a href="/markets" data-no-router class="flex items-center justify-between py-4 text-sm muted">Follow smart money <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
              <a href="/odds" data-no-router class="flex items-center justify-between py-3 text-sm muted">Compare every book <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
              <a href="/account" data-no-router class="flex items-center justify-between py-3 text-sm muted">Connect an exchange <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
            </section>
          </aside>
        </div>
      </main>
      @include('footer')
    </div>
  </body>
</html>

<style>
  .market-home { font-family: 'Geist', sans-serif; }
  .market-home .overflow-x-auto { scrollbar-width: none; }
  .market-home .overflow-x-auto::-webkit-scrollbar { display: none; }
  .category-strip { background: var(--surface); }
  .category-link { display: flex; align-items: center; gap: 0.4rem; position: relative; flex-shrink: 0; height: 52px; color: var(--muted); font-size: 13px; font-weight: 600; }
  .category-link.selected { color: var(--text); }
  .category-link.selected::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--accent); border-radius: 3px; }
  .feature-market { background: var(--surface-2); border: 1px solid var(--border); }
  .market-card { background: var(--surface); border: 1px solid var(--border); transition: border-color 150ms ease; min-height: 213px; }
  .market-card:hover { border-color: var(--border-strong); }
  .market-card h3 a:hover { color: var(--accent); }
  .league-chip { color: var(--muted); background: var(--surface); border: 1px solid var(--border); }
  .league-chip.active { color: var(--accent); border-color: var(--accent); }
  .probability-yes { background: color-mix(in srgb, var(--pos) 12%, var(--surface)); color: var(--pos); }
  .probability-no { background: color-mix(in srgb, var(--neg) 10%, var(--surface)); color: var(--neg); }
  .circle-callout { background: var(--accent); color: var(--on-accent); }
  .circle-callout p { color: color-mix(in srgb, var(--on-accent) 78%, transparent); }
  .group-cta { background: var(--on-accent); color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .market-card { transition: none; } }
</style>
