<script server>
/**
 * PredictHQ: feature index.
 *
 * The map of everything the product does, split by whether it reads a
 * market or acts on one. That split is the same one the pricing page
 * charges on, so the two pages tell the same story about what changes
 * when you upgrade.
 *
 * Counts come from the live database, so the page cannot claim coverage
 * the ingestion has not actually achieved.
 */
import { loadIntelSummary } from '../../app/Support/intel'
import { loadBoard } from '../../app/Support/odds'
const canonicalPath = '/features'

const navActive = 'features'
const pageTitle = 'Features | PredictHQ'
const pageDescription = 'Kalshi, Polymarket, and sportsbook prices in one place, live scores beside your bets, and automated orders inside limits you set.'

const intel = await loadIntelSummary()
const { summary } = await loadBoard()

/**
 * A count is only worth printing once there is something to count.
 *
 * These lines read off tables that are empty until ingestion has run, so
 * on a fresh install every card here said "0 fills priced", "0 accounts
 * scored". A zero next to a feature name claims the feature does nothing,
 * which is a different statement from "the tape has not been pulled yet".
 * The fallbacks are the same shape as the static lines the non-numeric
 * cards already carry, so the row stays even.
 */
function counted(value, phrase, fallback) {
  return value ? `${value.toLocaleString()} ${phrase}` : fallback
}

const analysis = [
  {
    href: '/features/evidence',
    name: 'Evidence engine',
    blurb: 'Signals from the trade tape, the other venue, and the schedule move fair value off the quote. Each is capped and records the sample behind it, and in play only flow since tip-off counts.',
    stat: counted(intel.recentFills, 'fills priced in the last 24h', 'Prices every fill the tape carries'),
  },
  {
    href: '/features/smart-money',
    name: 'Smart money',
    blurb: 'Per-account win rates on settled markets, shrunk toward a coin flip so a 2-for-2 record never outranks a 40-for-50 one.',
    stat: intel.traderCount
      ? `${intel.traderCount.toLocaleString()} accounts scored${intel.whaleCount ? `, ${intel.whaleCount} flagged for size` : ''}`
      : 'Scoring begins at the first settled market',
  },
  {
    href: '/features/odds',
    name: 'Odds comparison',
    blurb: 'Sportsbook prices and prediction-market probabilities on one row, with the best available price on each outcome ringed.',
    stat: summary.bookmakerCount && summary.eventCount
      ? `${summary.bookmakerCount} books across ${summary.eventCount.toLocaleString()} games`
      : 'Every book on one row',
  },
  {
    href: '/features/live',
    name: 'Live moves',
    blurb: 'Every price change streamed as it lands, so a line that moves against you is visible before the next page load.',
    stat: 'Broadcast over WebSocket, one-minute ingest',
  },
]

const follow = [
  {
    href: '/positions',
    name: 'My bets',
    blurb: 'Every position on your connected Kalshi account with the live score, the clock, and how its chance has moved since the start. Player props show the stat they need, totals show the running score.',
    stat: 'Refreshes every 10 seconds',
  },
  {
    href: '/scanner',
    name: 'Live scanner',
    blurb: 'Every game market in play or starting soon, with its price change over 5, 15, and 60 minutes and a flag when trading surges.',
    stat: 'NBA, NFL, college, NHL, MLB, and soccer',
  },
  {
    href: '/scores/nba/today',
    name: 'Game pages',
    blurb: 'Score, last play, box score, team stats, and the win-probability chart from Kalshi on one page that updates while the game is on.',
    stat: 'Scores from ESPN',
  },
  {
    href: '/history',
    name: 'History',
    blurb: 'Your trades, settlements, and results across connected exchanges, with lifetime profit and loss.',
    stat: 'Imported from your venues',
  },
]

const execution = [
  {
    href: '/features/automation',
    name: 'Automated trading',
    blurb: 'Strategies place orders on Kalshi and Polymarket inside limits you set, sized by quarter-Kelly on your own bankroll.',
    stat: 'Two venues, one order model',
  },
  {
    href: '/features/risk',
    name: 'Risk limits',
    blurb: 'Bankroll, per-trade cap, open positions, and a daily loss limit re-checked before every order leaves the process.',
    stat: 'Every refusal recorded with its reason',
  },
  {
    href: '/features/sheets',
    name: 'Bet sheets',
    blurb: 'Stack picks across games into a parlay and watch the combined price and payout update against live odds.',
    stat: 'Saved server-side, shareable',
  },
  {
    href: '/features/api',
    name: 'JSON API',
    blurb: 'Everything the pages read is a documented endpoint, including the candidate feed with its full evidence.',
    stat: 'No key required for reads',
  },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body x-data="{ menu: false,
      theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto pt-14 px-4 sm:pt-20 sm:px-6 max-w-6xl">
        <div class="max-w-3xl">
          <h1 class="font-black leading-[1.06] text-4xl tracking-tight sm:text-5xl display">Read the market, follow your bets, act inside your limits.</h1>
          <p class="mt-5 max-w-2xl leading-relaxed text-lg muted">
            Every plan reads the same data: Kalshi, Polymarket, and sportsbook prices, live scores, and the public trade tape. Paid plans also let PredictHQ place orders for you.
          </p>
        </div>

        <section class="mt-16">
          <div class="flex flex-wrap gap-3 items-baseline justify-between pb-4 border-b bd">
            <h2 class="font-black text-2xl tracking-tight display">Know</h2>
            <p class="text-sm muted">On every plan, including the free one.</p>
          </div>

          <div class="grid gap-px sm:grid-cols-2 mt-px" style="background:var(--border)">
            @foreach (analysis as item)
              <a href="{{ item.href }}" data-no-router class="flex flex-col p-6 sm:p-7 group" style="background:var(--surface)">
                <h3 class="font-bold text-lg tracking-tight group-hover:opacity-70">{{ item.name }}</h3>
                <p class="mt-2 leading-relaxed text-sm muted">{{ item.blurb }}</p>
                <span class="mt-4 font-semibold text-xs faint num">{{ item.stat }}</span>
              </a>
            @endforeach
          </div>
        </section>

        <section class="mt-16">
          <div class="flex flex-wrap gap-3 items-baseline justify-between pb-4 border-b bd">
            <h2 class="font-black text-2xl tracking-tight display">Follow</h2>
            <p class="text-sm muted">Connect Kalshi and your bets fill in.</p>
          </div>

          <div class="grid gap-px sm:grid-cols-2 mt-px" style="background:var(--border)">
            @foreach (follow as item)
              <a href="{{ item.href }}" data-no-router class="flex flex-col p-6 sm:p-7 group" style="background:var(--surface)">
                <h3 class="font-bold text-lg tracking-tight group-hover:opacity-70">{{ item.name }}</h3>
                <p class="mt-2 leading-relaxed text-sm muted">{{ item.blurb }}</p>
                <span class="mt-4 font-semibold text-xs faint num">{{ item.stat }}</span>
              </a>
            @endforeach
          </div>
        </section>

        <section class="mt-16">
          <div class="flex flex-wrap gap-3 items-baseline justify-between pb-4 border-b bd">
            <h2 class="font-black text-2xl tracking-tight display">Act</h2>
            <p class="text-sm muted">Placing orders needs a plan that includes it.</p>
          </div>

          <div class="grid gap-px sm:grid-cols-2 mt-px" style="background:var(--border)">
            @foreach (execution as item)
              <a href="{{ item.href }}" data-no-router class="flex flex-col p-6 sm:p-7 group" style="background:var(--surface)">
                <h3 class="font-bold text-lg tracking-tight group-hover:opacity-70">{{ item.name }}</h3>
                <p class="mt-2 leading-relaxed text-sm muted">{{ item.blurb }}</p>
                <span class="mt-4 font-semibold text-xs faint num">{{ item.stat }}</span>
              </a>
            @endforeach
          </div>
        </section>

        <section class="flex flex-col gap-5 items-start justify-between lg:flex-row lg:items-center mt-16 p-8 sm:p-10 rounded-2xl card">
          <div>
            <h2 class="font-black text-2xl tracking-tight display">See it price a real market</h2>
            <p class="mt-2 max-w-xl leading-relaxed muted">The candidate feed is open and needs no account. It is the same call the trading loop makes every thirty minutes.</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/features/evidence" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn btn-primary">How pricing works</a>
            <a href="/api/trading/candidates" data-no-router class="px-5 py-3 font-bold text-sm rounded-lg btn">Open the feed</a>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
