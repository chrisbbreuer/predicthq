<script server>
/**
 * PredictHQ: Pricing.
 *
 * The plans come straight from `config/saas.ts`, so the page and the
 * entitlement check can never disagree about what a tier includes. A
 * pricing page maintained separately from the thing that grants access
 * is a pricing page that eventually lies.
 *
 * Checkout posts a plan KEY to /api/billing/checkout, never a Stripe
 * price id: the tier is resolved server-side from our own config.
 *
 * Read through `@stacksjs/config` rather than importing config/saas.ts
 * directly. A default import resolves to an empty module in the stx
 * server scope, which fails silently: the const is simply undefined and
 * every interpolation after it renders as literal `{{ }}`.
 */
import { config } from '@stacksjs/config'

/** What each tier actually unlocks, keyed by the metadata tier name. */
const tierFeatures = {
  signal: [
    'Live Kalshi and Polymarket flow, refreshed continuously and pushed to every paid account as venues permit',
    'Smart-money leaderboard, whale flow, and the signal graph',
    'Every decision the engine would make, with its full evidence',
    'One strategy you can watch run',
  ],
  auto: [
    'Everything in Signal',
    'Connect your Kalshi and Polymarket accounts',
    'Orders placed automatically inside your limits',
    'Model review on every candidate before it executes',
    'Five strategies',
  ],
  desk: [
    'Everything in Auto',
    'Unlimited strategies',
    'Deeper model research on every candidate',
    'Priority ingestion',
  ],
}

const tiers = (config.saas?.plans ?? []).map((plan) => {
  const tier = plan.metadata?.tier ?? ''
  const monthly = plan.pricing.find(p => p.interval === 'month')
  const yearly = plan.pricing.find(p => p.interval === 'year')

  return {
    tier,
    name: plan.productName,
    description: plan.description,
    monthlyLabel: monthly ? `$${(monthly.price / 100).toFixed(0)}` : '',
    monthlyKey: monthly?.key ?? '',
    // Stated as the monthly equivalent so the two numbers are comparable
    // at a glance; the billed amount is spelled out next to it.
    yearlyPerMonth: yearly ? `$${Math.round(yearly.price / 100 / 12)}` : '',
    yearlyTotal: yearly ? `$${(yearly.price / 100).toFixed(0)}` : '',
    yearlyKey: yearly?.key ?? '',
    trades: plan.metadata?.autoExecute === 'true',
    featuresHtml: featureList(tierFeatures[tier] ?? []),
  }
})

/**
 * The capability list as markup.
 *
 * Built here rather than looped in the template: a nested @foreach whose
 * body is a single attributed element compiles to a client-side `@for`,
 * which has no access to server data and renders an empty list with no
 * error. The input is the static copy above, never user input.
 */
function featureList(items) {
  return items
    .map(item => `<li class="flex gap-2.5 items-start"><span class="mt-0.5 font-bold tick">✓</span><span class="muted">${item}</span></li>`)
    .join('')
}

const navActive = 'pricing'
</script>

<script client>
import { withCsrfHeader } from '@stacksjs/browser/composables/csrf'
import { useStorage } from '@stacksjs/browser/composables/useStorage'

const billingToken = useStorage('token', '')

function billingHeaders(): Record<string, string> {
  const bearer = billingToken.value ? { Authorization: `Bearer ${billingToken.value}` } : {}
  return withCsrfHeader({ 'Content-Type': 'application/json', ...bearer })
}
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @include('tokens')
    <meta name="description" content="PredictHQ pricing. Read the markets and every decision on Signal, or let the engine place the trades on Auto and Desk.">
    <title>PredictHQ: pricing</title>
    <style>
      [x-cloak] { display: none !important; }
      * { box-sizing: border-box; }
      a { color: inherit; text-decoration: none; }
      .btn:active { transform: translateY(1px); }
      /* The featured plan is raised by its border, not by a shadow that
         would fight the flat card system used across the app. */
      .featured { border-color: var(--accent); border-width: 2px; }
      .tick { color: var(--accent-strong); flex: none; }
      @media (prefers-reduced-motion: reduce) {
        .btn:active { transform: none; }
      }
    </style>
  </head>

  <body
    x-data="{
      menu: false,
      theme: predicthqTheme.current(),
      cycle: 'yearly',
      busy: '',
      error: '',
      toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu },
      async subscribe(planKey) {
        if (!planKey || this.busy) return
        this.busy = planKey
        this.error = ''
        try {
          const res = await fetch('/api/billing/checkout', {
            method: 'POST',
            headers: billingHeaders(),
            body: JSON.stringify({ plan: planKey }),
          })
          const data = await res.json()
          if (!res.ok || !data.url) {
            this.error = data.message || 'Checkout is unavailable right now. Please try again.'
            this.busy = ''
            return
          }
          location.assign(data.url)
        } catch (e) {
          this.error = 'Could not reach the server. Check your connection and try again.'
          this.busy = ''
        }
      },
    }"
    :class="theme === 'dark' ? 'app' : 'app'"
  >
    <div class="app">
      @include('nav')

      <main class="mx-auto px-4 py-12 sm:px-6 max-w-6xl sm:py-16">
        <div class="max-w-2xl">
          <h1 class="display font-black leading-[1.08] text-3xl tracking-tight sm:text-5xl">Read the market, or let it trade.</h1>
          <p class="mt-4 leading-relaxed text-lg muted">
            Every plan sees the same analysis and the same evidence. What changes is whether PredictHQ places the order for you.
          </p>
        </div>

        <div class="inline-flex gap-1 items-center p-1 mt-8 rounded-xl soft" role="group" aria-label="Billing cycle">
          <button
            class="px-4 py-2 font-bold text-sm rounded-lg"
            :style="cycle === 'monthly' ? 'background:var(--surface);box-shadow:var(--shadow-sm)' : 'color:var(--muted)'"
            @click="cycle = 'monthly'"
          >Monthly</button>
          <button
            class="px-4 py-2 font-bold text-sm rounded-lg"
            :style="cycle === 'yearly' ? 'background:var(--surface);box-shadow:var(--shadow-sm)' : 'color:var(--muted)'"
            @click="cycle = 'yearly'"
          >Yearly, two months free</button>
        </div>

        <div x-show="error" x-cloak class="px-4 py-3 mt-6 max-w-2xl text-sm rounded-xl card" style="border-color:var(--neg);color:var(--neg)" x-text="error" role="alert"></div>

        <div class="grid gap-5 lg:grid-cols-3 mt-8">
          @foreach (tiers as row)
            <div class="flex flex-col p-6 rounded-2xl card {{ row.tier === 'auto' ? 'featured' : '' }}">
              @if (row.tier === 'auto')
                <span class="self-start px-2.5 py-1 mb-4 font-bold text-xs tracking-wide uppercase rounded-full" style="background:var(--accent-weak);color:var(--accent-strong)">Most chosen</span>
              @endif

              <h2 class="display font-black text-xl tracking-tight">{{ row.name }}</h2>
              <p class="mt-2 leading-relaxed text-sm muted">{{ row.description }}</p>

              <div class="mt-6">
                <div x-show="cycle === 'yearly'">
                  <span class="font-black text-4xl num">{{ row.yearlyPerMonth }}</span>
                  <span class="ml-1 text-sm muted">per month</span>
                  <div class="mt-1 text-xs faint">{{ row.yearlyTotal }} billed yearly</div>
                </div>
                <div x-show="cycle === 'monthly'" x-cloak>
                  <span class="font-black text-4xl num">{{ row.monthlyLabel }}</span>
                  <span class="ml-1 text-sm muted">per month</span>
                  <div class="mt-1 text-xs faint">billed monthly</div>
                </div>
              </div>

              <button
                class="px-5 py-3 mt-6 w-full font-bold text-sm rounded-lg btn {{ row.tier === 'auto' ? 'btn-primary' : '' }}"
                :disabled="busy !== ''"
                @click="subscribe(cycle === 'yearly' ? '{{ row.yearlyKey }}' : '{{ row.monthlyKey }}')"
              >
                <span x-show="busy !== '{{ row.yearlyKey }}' && busy !== '{{ row.monthlyKey }}'">Choose {{ row.name }}</span>
                <span x-show="busy === '{{ row.yearlyKey }}' || busy === '{{ row.monthlyKey }}'" x-cloak>Opening checkout</span>
              </button>

              <!-- Rendered as one interpolation rather than an inner
                   @foreach: a nested loop whose body is a single
                   attributed element compiles to a client `@for`, which
                   cannot see server data and silently renders nothing.
                   `featuresHtml` is built from our own static copy in the
                   server script, so there is no untrusted input here. -->
              <ul class="flex flex-col gap-3 mt-6 text-sm">{!! row.featuresHtml !!}</ul>

              @if (!row.trades)
                <p class="pt-4 mt-6 text-xs border-t faint bd">Analysis only. This plan does not place orders.</p>
              @endif
            </div>
          @endforeach
        </div>

        <section class="pt-12 mt-16 border-t bd">
          <h2 class="display font-black text-2xl tracking-tight">Before you connect an account</h2>
          <div class="grid gap-x-10 gap-y-7 md:grid-cols-2 mt-6 max-w-4xl">
            <div>
              <h3 class="font-bold">Your venue keys stay yours</h3>
              <p class="mt-1.5 leading-relaxed text-sm muted">Kalshi and Polymarket credentials are encrypted with your application key and read only to sign a request. They are never logged and never returned by the API.</p>
            </div>
            <div>
              <h3 class="font-bold">Your limits are the ceiling</h3>
              <p class="mt-1.5 leading-relaxed text-sm muted">Bankroll, per-trade cap, open positions, and a daily loss limit are re-checked before every order. A strategy that breaches one halts itself and says so.</p>
            </div>
            <div>
              <h3 class="font-bold">Cancel whenever</h3>
              <p class="mt-1.5 leading-relaxed text-sm muted">Your subscription runs to the end of the period you paid for, then stops. Cancelling stops new orders; it never touches positions you already hold at a venue.</p>
            </div>
            <div>
              <h3 class="font-bold">This is not advice</h3>
              <p class="mt-1.5 leading-relaxed text-sm muted">PredictHQ measures flow and prices it. It does not know your circumstances, and a modelled edge is an estimate that can be wrong. You can lose money on every plan.</p>
            </div>
          </div>
        </section>
      </main>

      @include('footer')
    </div>
  </body>
</html>
