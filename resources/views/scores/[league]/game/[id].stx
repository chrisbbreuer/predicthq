<script server>
/**
 * PredictHQ - one game.
 *
 * The matchup with logos and the live score, how Kalshi's win probability
 * moved through the game, the line score, each team's player box score,
 * team stats, and the book's line. Refreshes itself while the game is on.
 *
 * Routed as /scores/<league>/game/<id>. The `game` segment keeps this
 * distinct from /scores/<league>/<day>, which would otherwise match the
 * same shape and make an event id look like a day name.
 *
 * Client-rendered from `/api/scores/{league}/game/{id}` so a live game can
 * update in place; the server only validates the route and names the page.
 *
 * The import path is four levels up. A path that does not resolve takes
 * the whole server scope with it and every const below becomes undefined.
 */
import { isKnownLeague, leagueFor } from '../../../../../app/Services/scores/espn'
import { iconForLeague } from '../../../../../app/Support/branding'

const navActive = 'scores'

const routeParams = (typeof params !== 'undefined' && params) ? params : {}
const rawLeague = String(routeParams.league ?? 'nfl').toLowerCase()
const league = leagueFor(isKnownLeague(rawLeague) ? rawLeague : 'nfl')
const leagueKey = league.key
const leagueLabel = league.label
const leagueIcon = iconForLeague(league.key)
const eventId = /^\d{1,20}$/.test(String(routeParams.id ?? '')) ? String(routeParams.id) : ''

const pageTitle = `${league.label} game | PredictHQ`
const pageDescription = 'Live score, box score, team stats, and how the odds moved through the game.'
</script>

<script client>
import { useIntervalFn, useWindowSize } from '@stacksjs/composables'
import { probabilityChart } from '@ts-charts/plot'
import { axisLabels, gameClock, startLabel, teamColor, teamShort } from '../../../../functions/bets'

const LEAGUE = {{ leagueKey }}
const EVENT = {{ eventId }}
const RANGES = [
  { key: 'live', label: 'GAME' },
  { key: '1d', label: '1D' },
  { key: '1w', label: '1W' },
  { key: '1m', label: '1M' },
  { key: 'all', label: 'ALL' },
]
const BASKETBALL_COLUMNS = ['MIN', 'PTS', 'REB', 'AST', '3PT', 'FG', 'FT', 'STL', 'BLK', 'TO', '+/-']

const loading = state(true)
const failed = state('')
const view = state<any>(null)
const axis = state<string[]>([])
/** What the chart draws: one series per outcome, and the time span. */
const chartSeries = state<any[]>([])
const chartDomain = state<number[]>([])
const chartWidth = state(720)
const chartBox = useRef('chartBox')

/** Read the chart box's width. It is hidden until data arrives, so this runs then too. */
function measureChart(): void {
  void nextTick(() => {
    const width = chartBox.current?.clientWidth ?? 0
    if (width > 0 && width !== chartWidth())
      chartWidth.set(width)
  })
}

/**
 * The win-probability chart, from @ts-charts/plot. Drawn at the box's real
 * pixel width so text and lines stay crisp, and redrawn when it resizes.
 */
const chartHtml = derived(() => {
  const series = chartSeries()
  const domain = chartDomain()
  if (series.length === 0 || domain.length !== 2)
    return ''
  const width = chartWidth()
  const narrow = width < 560
  return probabilityChart({
    width,
    height: narrow ? 220 : 260,
    labelWidth: narrow ? 84 : 120,
    series,
    domain: [domain[0]!, domain[1]!],
    extendTo: domain[1],
    grid: [0.25, 0.5, 0.75],
    title: 'Win probability',
    idPrefix: 'game',
  }).svg
})
const periods = state<any[]>([])
const awayLine = state<any[]>([])
const homeLine = state<any[]>([])
const stats = state<any[]>([])
const boxSide = state('away')
let boxes: any = { away: null, home: null }
const boxHeaders = state<any[]>([])
const boxRows = state<any[]>([])
const range = state('live')
const ranges = state(RANGES)
const betHref = state('')
const board = state<any>(null)
const boardRows = state<any[]>([])

/** Decimal odds the way an exchange prints a payout: `1.83x`. */
function multiplier(price: unknown): string {
  const value = Number(price)
  return Number.isFinite(value) && value > 1 ? value.toFixed(2) + 'x' : '—'
}

function signed(point: unknown): string {
  const value = Number(point)
  if (!Number.isFinite(value))
    return ''
  return (value > 0 ? '+' : '') + (Number.isInteger(value) ? String(value) : value.toFixed(1))
}

const BOOK_NAMES: Record<string, string> = { kalshi: 'Kalshi', polymarket: 'Polymarket', pinnacle: 'Pinnacle', draftkings: 'DraftKings' }

/** One team's row of the lines card. */
function boardRow(data: any, side: 'away' | 'home', team: any): any {
  const spread = data.spread[side]
  const winner = data.winner[side]
  const total = side === 'away' ? data.total.over : data.total.under
  return {
    key: side,
    abbr: team.abbreviation,
    logo: team.logo || '',
    hasLogo: Boolean(team.logo),
    spreadPoint: spread ? signed(spread.point) : '',
    spreadPrice: spread ? multiplier(spread.price) : '—',
    hasSpread: Boolean(spread),
    winnerPrice: winner ? multiplier(winner.price) : '—',
    hasWinner: Boolean(winner),
    totalLabel: total ? (side === 'away' ? 'O ' : 'U ') + total.point : '',
    totalPrice: total ? multiplier(total.price) : '—',
    hasTotal: Boolean(total),
  }
}

function columnsFor(team: any): number[] {
  if (!team)
    return []
  const preferred = team.labels.includes('PTS') ? BASKETBALL_COLUMNS : team.labels
  return preferred.map((label: string) => team.labels.indexOf(label)).filter((index: number) => index !== -1)
}

function boxView(team: any, abbr: string): any {
  if (!team || !team.players.length)
    return null
  const columns = columnsFor(team)
  const ptsIndex = team.labels.indexOf('PTS')
  const rows = team.players
    .slice()
    .sort((a: any, b: any) => Number(b.starter) - Number(a.starter))
    .map((player: any, index: number) => ({
      key: index + player.name,
      name: player.shortName || player.name,
      meta: [player.position, player.jersey ? '#' + player.jersey : ''].filter(Boolean).join(' · '),
      starter: player.starter,
      dnp: player.dnp,
      cells: player.dnp ? [] : columns.map((column: number, at: number) => ({ key: String(at), value: player.stats[column] ?? '', strong: column === ptsIndex })),
      dnpText: 'Did not play',
    }))
  return {
    abbr,
    headers: columns.map((column: number, at: number) => ({ key: String(at), label: team.labels[column] })),
    rows,
  }
}

/** Whether two `#rrggbb` colours are too close to tell apart as lines. */
function similarColors(a: string, b: string): boolean {
  const rgb = (value: string) => {
    const match = /^#([0-9a-f]{6})$/i.exec(String(value || '').trim())
    if (!match)
      return null
    const n = Number.parseInt(match[1]!, 16)
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
  }
  const x = rgb(a)
  const y = rgb(b)
  if (!x || !y)
    return false
  return Math.hypot(x[0]! - y[0]!, x[1]! - y[1]!, x[2]! - y[2]!) < 90
}

function apply(data: any): void {
  const game = data.game
  const kalshi = data.kalshi
  const live = game.state === 'in'
  const done = game.state === 'post'
  const awayWon = done && Number(game.away.total) > Number(game.home.total)
  const homeWon = done && Number(game.home.total) > Number(game.away.total)

  view.set({
    title: teamShort(game.away) + ' at ' + teamShort(game.home),
    isLive: live,
    isFinal: done,
    status: live ? gameClock({ ...game, league: LEAGUE }) : (done ? (game.status || 'Final') : startLabel(game.startsAt)),
    lastPlay: game.lastPlay || '',
    away: { abbr: game.away.abbreviation, name: game.away.shortName || game.away.name, logo: game.away.logo || '', hasLogo: Boolean(game.away.logo), record: game.away.record || '', score: game.state === 'pre' ? '' : String(game.away.total ?? ''), dim: done && !awayWon },
    home: { abbr: game.home.abbreviation, name: game.home.shortName || game.home.name, logo: game.home.logo || '', hasLogo: Boolean(game.home.logo), record: game.home.record || '', score: game.state === 'pre' ? '' : String(game.home.total ?? ''), dim: done && !homeWon },
    venue: game.venue || '',
    attendance: game.attendance ? Number(game.attendance).toLocaleString('en-US') : '',
    broadcast: game.broadcast || '',
    note: game.note || '',
    odds: game.odds
      ? {
          provider: game.odds.provider,
          details: game.odds.details || '—',
          total: game.odds.overUnder ?? '—',
          awayMl: game.odds.awayMoneyLine === null ? '—' : (game.odds.awayMoneyLine > 0 ? '+' : '') + game.odds.awayMoneyLine,
          homeMl: game.odds.homeMoneyLine === null ? '—' : (game.odds.homeMoneyLine > 0 ? '+' : '') + game.odds.homeMoneyLine,
        }
      : null,
    hasKalshi: Boolean(kalshi),
    volume: kalshi && Number(kalshi.volume) > 0 ? Math.round(Number(kalshi.volume)).toLocaleString('en-US') + ' contracts traded' : '',
    hasBoard: Boolean(data.board),
    hasBox: Boolean(game.box && (game.box.away || game.box.home)),
  })

  boardRows.set(data.board ? [boardRow(data.board, 'away', game.away), boardRow(data.board, 'home', game.home)] : [])
  board.set(data.board
    ? {
        rows: [boardRow(data.board, 'away', game.away), boardRow(data.board, 'home', game.home)],
        draw: data.board.winner.draw ? multiplier(data.board.winner.draw.price) : '',
        books: (data.board.books || []).map((book: string) => BOOK_NAMES[book] || book).join(' · '),
      }
    : null)

  periods.set((game.periods || []).map((label: string, index: number) => ({ key: String(index), label })))
  awayLine.set((game.away.line || []).map((value: string, index: number) => ({ key: String(index), value })))
  homeLine.set((game.home.line || []).map((value: string, index: number) => ({ key: String(index), value })))

  stats.set((game.stats || []).map((stat: any, index: number) => ({
    key: String(index),
    label: stat.label,
    away: stat.away,
    home: stat.home,
    awayWidth: stat.awayShare + '%',
  })))

  boxes = {
    away: boxView(game.box && game.box.away, game.away.abbreviation),
    home: boxView(game.box && game.box.home, game.home.abbreviation),
  }
  showBox(boxSide())

  if (kalshi && kalshi.chart) {
    const c = kalshi.chart
    const colorFor = (label: string, index: number) => {
      for (const key of ['away', 'home']) {
        const team = game[key]
        if ([team.location, team.name, team.shortName, team.abbreviation].map((value: string) => String(value || '').toLowerCase()).includes(String(label || '').toLowerCase()))
          return teamColor(team.color, index === 0 ? 'var(--text)' : 'var(--faint)')
      }
      return index === 0 ? 'var(--text)' : 'var(--faint)'
    }
    const labelFor = (label: string) => {
      for (const key of ['away', 'home']) {
        const team = game[key]
        if ([team.location, team.name, team.shortName, team.abbreviation].map((value: string) => String(value || '').toLowerCase()).includes(String(label || '').toLowerCase()))
          return team.abbreviation || label
      }
      return label
    }
    const lines = c.outcomes.map((outcome: any, index: number) => ({ id: outcome.ticker, label: labelFor(outcome.label), points: outcome.points, color: colorFor(outcome.label, index), fill: false, last: outcome.last }))
    let leader = 0
    lines.forEach((line: any, index: number) => {
      if ((Number(line.last) || 0) > (Number(lines[leader].last) || 0))
        leader = index
    })
    // Two teams in near-identical colours (Florida's and Notre Dame's
    // navies) read as one line. The trailing side steps back to grey.
    if (lines.length === 2 && similarColors(lines[0].color, lines[1].color)) {
      const trailing = leader === 0 ? 1 : 0
      lines[trailing].color = 'var(--faint)'
    }
    if (lines[leader])
      lines[leader].fill = true
    chartSeries.set(lines)
    chartDomain.set([c.start, c.end])
    measureChart()
    axis.set(axisLabels(c.start, c.end, c.intervalMinutes))
    betHref.set('/bet?ticker=' + encodeURIComponent(kalshi.tickers[0]) + '&side=yes')
  }
}

async function load(): Promise<void> {
  if (!EVENT) {
    failed.set('No game was named in the link.')
    loading.set(false)
    return
  }
  try {
    const response = await fetch('/api/scores/' + LEAGUE + '/game/' + EVENT + '?range=' + range(), { headers: { Accept: 'application/json' } })
    const data = await response.json()
    if (!response.ok)
      throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'))
    apply(data)
    failed.set('')
  }
  catch (requestError) {
    failed.set(requestError instanceof Error ? requestError.message : String(requestError))
  }
  finally {
    loading.set(false)
  }
}

function showBox(side: string): void {
  boxSide.set(side)
  const team = boxes[side]
  boxHeaders.set(team ? team.headers : [])
  boxRows.set(team ? team.rows : [])
}

function setRange(key: string): void {
  range.set(key)
  void load()
}

// Only a live game needs the fast cadence; the poll is cheap either way
// because every upstream read behind the endpoint is cached.
const poll = useIntervalFn(() => {
  if (!view() || view().isLive)
    void load()
}, 15_000, { immediate: false })

onMount(async () => {
  // Redraw at the box's real width whenever the window changes size.
  const windowSize = useWindowSize()
  const unsubscribe = windowSize.width.subscribe(() => measureChart())
  onDestroy(unsubscribe)

  await load()
  poll.resume()
})
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
    <style>
      .matchup { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; }
      .logo { width: 64px; height: 64px; object-fit: contain; }
      .score { font-size: 60px; }
      .score.dim { color: var(--faint); }
      .chart-box { min-height: 220px; color: var(--text); }
      .chart-axis { padding-right: 136px; }
      .lines { display: grid; gap: 10px; }
      .lines-row { display: grid; grid-template-columns: minmax(0, 1fr) repeat(3, minmax(84px, 120px)); gap: 10px; align-items: center; }
      .lines-head { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: var(--muted); }
      .lines-head > span:not(:first-child) { text-align: center; }
      .line-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 58px; border: 1px solid var(--border); border-radius: 14px; }
      .line-cell.empty { opacity: 0.45; }
      .line-point { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
      .line-price { font-size: 16px; font-weight: 700; color: var(--pos); font-variant-numeric: tabular-nums; }
      .range { height: 32px; padding: 0 12px; border-radius: 9999px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: var(--faint); background: transparent; border: 0; cursor: pointer; }
      .range.on { color: var(--text); background: var(--surface-2); }
      .tabs { display: inline-flex; gap: 4px; padding: 4px; border-radius: 9999px; background: var(--surface-2); }
      .tab { height: 32px; padding: 0 16px; border-radius: 9999px; font-size: 13px; font-weight: 700; color: var(--muted); border: 0; background: transparent; cursor: pointer; }
      .tab.on { background: var(--surface); color: var(--text); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08); }
      table.box { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.box th { position: sticky; top: 0; padding: 10px 8px; font-size: 11px; font-weight: 700; color: var(--faint); text-align: right; white-space: nowrap; background: var(--surface); }
      table.box th:first-child, table.box td:first-child { text-align: left; position: sticky; left: 0; background: var(--surface); }
      table.box td { padding: 10px 8px; border-top: 1px solid var(--border); text-align: right; white-space: nowrap; font-family: 'Geist Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
      table.box td:first-child { font-family: inherit; }
      table.box tr.bench td:first-child { color: var(--muted); }
      @media (max-width: 640px) {
        .logo { width: 48px; height: 48px; }
        .score { font-size: 44px; }
        .chart-axis { padding-right: 100px; }
        .lines-row { grid-template-columns: minmax(0, 1fr) repeat(3, minmax(64px, 1fr)); gap: 6px; }
        .line-cell { min-height: 52px; border-radius: 12px; }
        .line-price { font-size: 14px; }
      }
    </style>
  </head>

  <body x-data="{ menu: false, theme: predicthqTheme.current(), toggleTheme() { this.theme = predicthqTheme.toggle() }, toggleMenu() { this.menu = !this.menu } }">
    <div class="app">
      @include('nav')

      <main class="mx-auto pb-16 pt-8 px-4 sm:px-6 max-w-4xl">
        <div class="flex flex-wrap gap-3 items-center justify-between">
          <a href="/scores/{{ league.key }}/today" data-no-router class="inline-flex gap-2 items-center font-semibold text-sm hover:opacity-70 muted"><i class="h-4 w-4 {{ leagueIcon }}" aria-hidden="true"></i>{{ leagueLabel }} scores</a>
          <div class="flex gap-2">
            <a href="/positions" data-no-router class="inline-flex items-center px-4 h-9 font-semibold text-sm rounded-full btn">My bets</a>
            <a x-show="betHref()" :href="betHref()" data-no-router class="inline-flex gap-1.5 items-center px-4 h-9 font-semibold text-sm rounded-full btn btn-primary">Odds &amp; bet view <i class="h-4 w-4 i-hugeicons-arrow-right-01"></i></a>
          </div>
        </div>

        <p x-show="loading()" class="mt-16 text-center muted">Loading game…</p>
        <section x-show="!loading() && failed() && !view()" x-cloak class="mt-6 px-6 py-16 text-center card">
          <p class="text-3xl display">Game not found</p>
          <p class="mt-2 text-sm muted" x-text="failed()"></p>
        </section>

        <div x-show="view()" x-cloak>
          {{-- The matchup. --}}
          <section class="mt-5 p-6 sm:p-8 card">
            <p class="font-bold text-center text-xs tracking-[0.14em] uppercase faint">{{ leagueLabel }}</p>
            <h1 class="mt-1 text-3xl text-center sm:text-4xl display" x-text="view() ? view().title : ''"></h1>
            <div class="mt-6 matchup">
              <div class="flex gap-4 items-center justify-start">
                <div class="text-center">
                  <img x-show="view() && view().away.hasLogo" :src="view() ? view().away.logo : ''" alt="" class="logo">
                  <div class="mt-1 font-bold" x-text="view() ? view().away.abbr : ''"></div>
                  <div class="text-xs faint num" x-text="view() ? view().away.record : ''"></div>
                </div>
                <span class="figure-xl score" :class="view() && view().away.dim ? 'dim' : ''" x-text="view() ? view().away.score : ''"></span>
              </div>
              <div class="text-center">
                <div x-show="view() && view().isLive" class="inline-flex gap-1.5 items-center font-extrabold text-sm tracking-[0.12em] live"><span class="live-pulse"></span>LIVE</div>
                <div x-show="view() && view().isFinal" class="font-extrabold text-sm tracking-[0.12em] faint">FINAL</div>
                <div class="mt-1 font-semibold num" x-text="view() ? view().status : ''"></div>
              </div>
              <div class="flex gap-4 items-center justify-end">
                <span class="figure-xl score" :class="view() && view().home.dim ? 'dim' : ''" x-text="view() ? view().home.score : ''"></span>
                <div class="text-center">
                  <img x-show="view() && view().home.hasLogo" :src="view() ? view().home.logo : ''" alt="" class="logo">
                  <div class="mt-1 font-bold" x-text="view() ? view().home.abbr : ''"></div>
                  <div class="text-xs faint num" x-text="view() ? view().home.record : ''"></div>
                </div>
              </div>
            </div>
            <p x-show="view() && view().lastPlay" class="mt-5 text-center text-sm muted" x-text="view() ? view().lastPlay : ''"></p>
          </section>

          {{-- How the market saw it. --}}
          <section x-show="view() && view().hasKalshi" class="mt-5 p-5 sm:p-6 card">
            <div class="flex flex-wrap gap-3 items-center justify-between">
              <h2 class="font-bold text-lg">Win probability</h2>
              <div class="flex gap-1">
                <template :for="option in ranges">
                  <button type="button" class="range" :class="range() === option.key ? 'on' : ''" @click="setRange(option.key)" x-text="option.label"></button>
                </template>
              </div>
            </div>
            <div ref="chartBox" class="mt-4 chart-box" x-html="chartHtml()"></div>
            <div class="flex justify-between mt-2 text-[11px] chart-axis faint num">
              <template :for="tick in axis"><span x-text="tick"></span></template>
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-1 items-baseline justify-between mt-3 text-xs">
              <span class="font-semibold num" x-show="view() && view().volume" x-text="view() ? view().volume : ''"></span>
              <span class="faint">Kalshi's winner market, quote midpoint. Not a price you can trade at.</span>
            </div>
          </section>

          {{-- Lines from our own odds feed, the way an exchange prints them. --}}
          <section x-show="board()" class="mt-5 p-5 sm:p-6 card">
            <div class="flex flex-wrap gap-2 items-baseline justify-between">
              <h2 class="font-bold text-lg">Lines</h2>
              <span class="text-xs faint" x-text="board() ? board().books : ''"></span>
            </div>
            <div class="mt-4 lines" role="table" aria-label="Spread, winner and total">
              <div class="lines-head lines-row" role="row">
                <span role="columnheader">Team</span>
                <span role="columnheader">Spread</span>
                <span role="columnheader">Winner</span>
                <span role="columnheader">Total</span>
              </div>
              <template :for="row in boardRows">
                <div class="lines-row" role="row">
                  <span class="flex gap-2.5 items-center min-w-0 font-semibold" role="cell">
                    <img x-show="row.hasLogo" :src="row.logo" alt="" class="object-contain h-6 w-6" loading="lazy">
                    <span x-text="row.abbr"></span>
                  </span>
                  <span class="line-cell" :class="row.hasSpread ? '' : 'empty'" role="cell"><span class="line-point" x-text="row.spreadPoint"></span><span class="line-price" x-text="row.spreadPrice"></span></span>
                  <span class="line-cell" :class="row.hasWinner ? '' : 'empty'" role="cell"><span class="line-price" x-text="row.winnerPrice"></span></span>
                  <span class="line-cell" :class="row.hasTotal ? '' : 'empty'" role="cell"><span class="line-point" x-text="row.totalLabel"></span><span class="line-price" x-text="row.totalPrice"></span></span>
                </div>
              </template>
            </div>
            <p class="mt-3 text-xs faint"><span x-show="board() && board().draw" x-text="'Draw ' + (board() ? board().draw : '') + ' · '"></span>Payout per dollar at the best ask, main line closest to even.</p>
          </section>

          {{-- Line score. --}}
          <section x-show="periods().length > 0" class="overflow-x-auto mt-5 card">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b bd">
                  <th class="px-5 py-3 font-bold text-left text-xs tracking-wide uppercase muted">Team</th>
                  <template :for="period in periods"><th class="px-2 py-3 w-9 font-bold text-center text-xs uppercase muted" x-text="period.label"></th></template>
                  <th class="px-5 py-3 font-bold text-right text-xs uppercase muted">T</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b bd">
                  <td class="px-5 py-3 font-semibold" x-text="view() ? view().away.abbr : ''"></td>
                  <template :for="cell in awayLine"><td class="px-2 py-3 text-center muted num" x-text="cell.value"></td></template>
                  <td class="px-5 py-3 font-black text-right num" x-text="view() ? view().away.score : ''"></td>
                </tr>
                <tr>
                  <td class="px-5 py-3 font-semibold" x-text="view() ? view().home.abbr : ''"></td>
                  <template :for="cell in homeLine"><td class="px-2 py-3 text-center muted num" x-text="cell.value"></td></template>
                  <td class="px-5 py-3 font-black text-right num" x-text="view() ? view().home.score : ''"></td>
                </tr>
              </tbody>
            </table>
          </section>

          {{-- Player box scores. --}}
          <section x-show="view() && view().hasBox" class="mt-5 card">
            <div class="flex flex-wrap gap-3 items-center justify-between pt-5 px-5">
              <h2 class="font-bold text-lg">Box score</h2>
              <div class="tabs" role="tablist" aria-label="Team">
                <button type="button" class="tab" :class="boxSide() === 'away' ? 'on' : ''" @click="showBox('away')" x-text="view() ? view().away.abbr : ''"></button>
                <button type="button" class="tab" :class="boxSide() === 'home' ? 'on' : ''" @click="showBox('home')" x-text="view() ? view().home.abbr : ''"></button>
              </div>
            </div>
            <div class="overflow-x-auto mt-3 pb-2">
              <template :if="boxRows().length > 0">
                <table class="box">
                  <thead>
                    <tr>
                      <th class="pl-5">Player</th>
                      <template :for="header in boxHeaders"><th x-text="header.label"></th></template>
                    </tr>
                  </thead>
                  <tbody>
                    <template :for="row in boxRows">
                      <tr :class="row.starter ? '' : 'bench'">
                        <td class="pl-5">
                          <div class="font-semibold" x-text="row.name"></div>
                          <div class="text-[11px] faint" x-text="row.meta"></div>
                        </td>
                        <template :for="cell in row.cells"><td :class="cell.strong ? 'font-bold' : 'muted'" x-text="cell.value"></td></template>
                        <td x-show="row.dnp" class="text-left faint" colspan="12" x-text="row.dnpText"></td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </template>
            </div>
          </section>

          {{-- Team stats. --}}
          <section x-show="stats().length > 0" class="mt-5 p-5 sm:p-6 card">
            <div class="flex items-center justify-between">
              <span class="font-bold" x-text="view() ? view().away.abbr : ''"></span>
              <h2 class="font-bold text-lg">Team stats</h2>
              <span class="font-bold" x-text="view() ? view().home.abbr : ''"></span>
            </div>
            <div class="flex flex-col gap-5 mt-5">
              <template :for="stat in stats">
                <div>
                  <div class="flex items-baseline justify-between">
                    <span class="font-bold num" x-text="stat.away"></span>
                    <span class="text-sm muted" x-text="stat.label"></span>
                    <span class="font-bold num" x-text="stat.home"></span>
                  </div>
                  <div class="flex gap-1 mt-2 h-1.5">
                    <span class="rounded-full" :style="'width:' + stat.awayWidth + ';background:var(--text)'"></span>
                    <span class="grow rounded-full" style="background:var(--track)"></span>
                  </div>
                </div>
              </template>
            </div>
          </section>

          {{-- The book's line. --}}
          <section x-show="view() && view().odds && !view().hasBoard" class="mt-5 p-5 sm:p-6 card">
            <div class="flex flex-wrap gap-2 items-baseline justify-between">
              <h2 class="font-bold text-lg">The line</h2>
              <span class="text-xs faint" x-text="view() && view().odds ? view().odds.provider : ''"></span>
            </div>
            <div class="grid gap-3 grid-cols-2 sm:grid-cols-4 mt-4">
              <div class="p-3 rounded-xl soft"><div class="text-xs muted">Spread</div><div class="mt-1 font-bold num" x-text="view() && view().odds ? view().odds.details : ''"></div></div>
              <div class="p-3 rounded-xl soft"><div class="text-xs muted">Total</div><div class="mt-1 font-bold num" x-text="view() && view().odds ? view().odds.total : ''"></div></div>
              <div class="p-3 rounded-xl soft"><div class="text-xs muted" x-text="(view() ? view().away.abbr : '') + ' moneyline'"></div><div class="mt-1 font-bold num" x-text="view() && view().odds ? view().odds.awayMl : ''"></div></div>
              <div class="p-3 rounded-xl soft"><div class="text-xs muted" x-text="(view() ? view().home.abbr : '') + ' moneyline'"></div><div class="mt-1 font-bold num" x-text="view() && view().odds ? view().odds.homeMl : ''"></div></div>
            </div>
          </section>

          {{-- Match information. --}}
          <section class="mt-5 p-5 sm:p-6 card">
            <h2 class="font-bold text-lg">Match information</h2>
            <div class="flex flex-col gap-2 mt-4 text-sm">
              <div x-show="view() && view().venue" class="flex gap-3"><span class="shrink-0 w-24 muted">Venue</span><span x-text="view() ? view().venue : ''"></span></div>
              <div x-show="view() && view().broadcast" class="flex gap-3"><span class="shrink-0 w-24 muted">TV</span><span x-text="view() ? view().broadcast : ''"></span></div>
              <div x-show="view() && view().attendance" class="flex gap-3"><span class="shrink-0 w-24 muted">Attendance</span><span class="num" x-text="view() ? view().attendance : ''"></span></div>
              <div x-show="view() && view().note" class="flex gap-3"><span class="shrink-0 w-24 muted">Note</span><span x-text="view() ? view().note : ''"></span></div>
              <div class="flex gap-3"><span class="shrink-0 w-24 muted">Status</span><span x-text="view() ? view().status : ''"></span></div>
            </div>
          </section>

          <p class="mt-4 text-xs faint">Scores and stats from ESPN, refreshed every 15 seconds while the game is live.</p>
        </div>
      </main>

      @include('footer')
    </div>
  </body>
</html>
