APP_NAME=PredictHQ
APP_ENV=development
APP_KEY=
# Any custom *.localhost (or real) domain enables pretty URLs over HTTPS in
# `./buddy dev`: the reverse proxy (rpx, which wraps tlsx) serves
# https://<APP_URL> and proxies the frontend/API/docs behind it. Plain
# `localhost`/`localhost:<port>` keeps the http://localhost:<port> dev URLs.
APP_URL=predicthq.localhost
APP_MAINTENANCE=false
APP_MAINTENANCE_SECRET=
APP_COMING_SOON=false
APP_COMING_SOON_SECRET=

# Local sudo password used by `./buddy dev` so the rpx reverse proxy can bind
# :443 and trust the locally-minted TLS CA (via tlsx) for the pretty HTTPS URL
# at APP_URL. Leave blank to keep dev on http://localhost:<port>. Local-only —
# never commit a real value (.env is gitignored).
SUDO_PASSWORD=

# .env encryption (stacksjs/stacks#1053). Generated by `buddy key:generate`.
# Public key encrypts new values (`buddy env:set`, `buddy env:encrypt`).
# Private key decrypts at runtime — keep out of source control on prod.
# Encrypted values look like `encrypted:...` or `enc:...` in this file and
# are auto-decrypted at boot by the env plugin in bunfig.toml preload.
# Leave both blank in dev; run `buddy key:generate` to materialize.
DOTENV_PUBLIC_KEY=
DOTENV_PRIVATE_KEY=

PORT=3000
DEBUG=true

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE='bench_review'
DB_USERNAME=root
DB_PASSWORD=

# Whether the Vitess keyspace is sharded. Production runs one unsharded
# keyspace, so this is false — but leave it unset and everything that reads
# it assumes SHARDED, which is the dangerous direction: `buddy
# generate:migrations` would then emit tables with no AUTO_INCREMENT and no
# foreign keys, for a cluster that has neither sequence tables nor a
# VSchema to allocate ids with. The migration file looks ordinary and every
# insert into that table fails. Set it explicitly, even to the default.
DB_VITESS_SHARDED=false

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Endpoint secret for /api/billing/webhook. Without it the webhook refuses
# every delivery — entitlements would then never reflect a cancellation.
STRIPE_WEBHOOK_SECRET=""

# Anthropic key for the decision-review pass. Required by production preflight.
ANTHROPIC_API_KEY=""

# Local-only entitlement override (signal | auto | desk) so the trading
# features can be worked on without Stripe. Ignored when APP_ENV=production.
PRINTEL_DEV_TIER=""

# The deployment-level trading switch. Set to false and no strategy places
# an order, whatever the halt log says — this is the one that cannot be
# cleared from inside the application, so a production incident is not
# resolvable by an API call. Leave unset to let `buddy trading:halt` and
# `buddy trading:resume` decide. Decisions are recorded either way.
TRADING_ENABLED=false
# Hard aggregate live exposure ceiling per connected venue account. Keep at
# 20 for the first real-money validation; raising it is a separate release act.
TRADING_BANKROLL_CAP_USD=20
# Keep false for the controlled launch. Add the signed-in tester's numeric user
# id here before enabling venue contact, for example LIVE_TRADING_USER_ALLOWLIST=1.
PUBLIC_LIVE_TRADING_ENABLED=false
LIVE_TRADING_USER_ALLOWLIST=

# Current exchange endpoints and attribution. Point Kalshi at
# https://external-api.demo.kalshi.co/trade-api/v2 for its demo environment.
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_BUILDER_CODE=

AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=stacks

# Filesystem / Storage
FILESYSTEM_DISK=local
# FILESYSTEM_LOCAL_ROOT=storage/app
# FILESYSTEM_PUBLIC_ROOT=public

# AWS S3 Storage
AWS_BUCKET=
AWS_S3_PREFIX=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADDRESS="no-reply@stacksjs.com"

# Queue Configuration
# Drivers: sync (default, immediate execution), database, redis, sqs, memory
QUEUE_DRIVER=sync
QUEUE_PREFIX=stacks:queue
QUEUE_CONCURRENCY=5
QUEUE_LOG_LEVEL=info
QUEUE_WORKER_CONCURRENCY=5
QUEUE_FAILED_DRIVER=database

# Queue Rate Limiting (optional)
# QUEUE_RATE_LIMIT_ENABLED=false
# QUEUE_RATE_LIMIT_MAX=100
# QUEUE_RATE_LIMIT_DURATION=1000

# Queue Dead Letter Queue (optional)
# QUEUE_DLQ_ENABLED=true
# QUEUE_DLQ_MAX_RETRIES=3

# Queue Horizontal Scaling (optional, for multi-instance deployments)
# QUEUE_HORIZONTAL_SCALING_ENABLED=false
# QUEUE_MAX_WORKERS=10
# QUEUE_JOBS_PER_WORKER=10

# Queue Metrics (optional)
# QUEUE_METRICS_ENABLED=false

# Redis Configuration (required when QUEUE_DRIVER=redis)
# REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# SQS Configuration (required when QUEUE_DRIVER=sqs)
# SQS_PREFIX=
# SQS_SUFFIX=

SEARCH_ENGINE_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# FRONTEND_* variables should not contain any sensitive information
FRONTEND_APP_ENV="${APP_ENV}"
FRONTEND_APP_URL="${APP_URL}"

FRONTEND_STRIPE_PUBLIC_KEY=

# ts-cloud management dashboard (auto-deployed on every server).
# Served behind HTTP Basic auth when TS_CLOUD_UI_PASSWORD is set; if left empty
# the dashboard is served WITHOUT auth (recommended: set a password).
TS_CLOUD_UI_PASSWORD=
# TS_CLOUD_UI_USERNAME=admin
# TS_CLOUD_UI_DOMAIN=dashboard.example.com
# TS_CLOUD_UI_DISABLE=

# Social sign-in. A provider whose keys are blank is left out of the sign-in
# page entirely, so filling these in is the whole of what turns one on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Sign in with Apple issues no client secret. The driver signs a short-lived
# ES256 JWT per token exchange from the team ID, the key ID, and the .p8 key
# downloaded from the developer portal. APPLE_CLIENT_ID is the Services ID
# (org.example.web), not the app's bundle identifier. Paste the .p8 contents
# with literal \n between lines; env files cannot carry real newlines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# APPLE_REDIRECT_URL=http://localhost:3000/api/auth/apple/callback

# The live odds feed. Without it every price on the site comes from the
# built-in simulator over real fixtures: the board looks live, and every
# edge it reports is a property of the simulator rather than of a market.
# `buddy preflight --production` fails while this is unset.
ODDS_API_KEY=
# The paid feed is a native-book fallback, never the high-frequency primary.
# A five-minute floor prevents a native outage from consuming paid quota at
# the live-game polling cadence. Regions are used only when no native book can
# name an exact bookmaker list for the league.
ODDS_FALLBACK_MIN_INTERVAL_MS=300000
ODDS_API_REGIONS=us,uk,eu

# Books to stop polling right now, without a deploy. The `enabled` flags in
# `config/odds.ts` are the considered switch; this is the one for when a book
# starts returning nonsense at 3am and it has to stop in minutes.
#   ODDS_BOOKS_DISABLED=bet365,unibet
ODDS_BOOKS_DISABLED=

# How the book adapters identify themselves. Named rather than disguised: a
# book that would rather we did not read its endpoint should be able to tell
# that we are, and to say so.
ODDS_USER_AGENT=

# Egress route for a book that is lawfully readable only from certain
# countries. Pinnacle refuses the United States outright — a licensing
# condition, not an anti-bot check — so the fix is to make the request from
# somewhere it is permitted rather than to disguise where it came from.
#
# Production runs in Germany, which Pinnacle serves, so this is unset there.
# Working from a blocked country, point it at that same host.
#   ODDS_PROXY_PINNACLE=http://your-de-host:8080
ODDS_PROXY_PINNACLE=

# The same, applied to every book. Rarely what you want: routing all of them
# through one country changes what the others quote.
ODDS_PROXY_URL=

# Port the realtime board broadcasts on. The browser derives the scheme and
# host from the page it loaded, so only the port belongs here.
BROADCAST_PORT=6001

# Transfermarkt's public competition pages supply squad valuations and league
# tiers. Override these only when routing the authorized DOM requests through
# a different origin or user agent.
# TRANSFERMARKT_BASE_URL=https://www.transfermarkt.com
# TRANSFERMARKT_USER_AGENT=Mozilla/5.0 ...
